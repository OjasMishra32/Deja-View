# Server port (the Quest needs https: bun run https)
PORT=8787
# Plain-HTTP listener next to https (team/contracts.md 2.1: the LAN BASE and the tunnel's target). Defaults to 8788
# when the server runs https; 0 turns it off.
# HTTP_PORT=8788
# Hot reload of the pages: off in production and for the https (Quest) server; 1 forces it on (desk work only:
# it reloads every open page when the server restarts, which drops a headset out of VR)
# THIRDWHEEL_HMR=0

# HiPerGator: the server drives jobs over an SSH ControlMaster socket that a teammate opens
# by logging in once (password + Duo):
#   ssh -o ControlMaster=auto -o ControlPath=~/.ssh/cm-hpg -o ControlPersist=24h <user>@hpg.rc.ufl.edu
HPG_USER=sbernalorta
HPG_HOST=hpg.rc.ufl.edu
HPG_SOCKET=~/.ssh/cm-hpg
HPG_ROOT=/blue/phz3152/sbernalorta/thirdwheel
HPG_ACCOUNT=phz3152
HPG_QOS=phz3152
HPG_PARTITION=hpg-rtx6000
# THIRDWHEEL_HPG=off turns every ssh/rsync call off (local and cloud backends only)
# THIRDWHEEL_HPG=off

# Optional Hugging Face token: raises the free GPU quota of the public FlashWorld Space fallback
# HF_TOKEN=

# --- Live layer (team/contracts.md 2.3). Every line is optional: without it that piece degrades politely. ---

# The live map service: presence is pushed to <DS_URL>/api/ingest at 4 Hz, notes are read from <DS_URL>/api/notes
# DS_URL=https://dejaview-live.app.space
# Its key, sent as X-DejaView-Key (from Seb, in person; never commit it)
# DS_KEY=

# The guide (/describe, /hotspots, /narrate, /ask); unset = canned lines and the world model's own captioner
# GUIDE_URL=http://127.0.0.1:8795
# The guide's key, sent as X-Guide-Key (only when the guide sets one)
# GUIDE_KEY=

# Roblox and the bot send this as x-dejaview-key on /api/roblox/* and /api/host/*; requests from this machine skip it
# DV_KEY=

# Lets scripts and other origins create, retry and delete scenes (X-DejaView-Token or Authorization: Bearer)
# THIRDWHEEL_API_TOKEN=
# Extra browser origins allowed to change things, comma separated (the public tunnel URL, say)
# THIRDWHEEL_ALLOWED_ORIGINS=https://<random>.trycloudflare.com

# 1 = a second server on a data folder another server already owns: it shows scenes and runs no jobs
# THIRDWHEEL_READONLY=1

# The public link (bun run tunnel). The domain's tunnel made in the Cloudflare dashboard: its token in a file outside
# the repo, and the hostname the dashboard routes to HTTP localhost:8788. Without them: a quick tunnel.
# TUNNEL_TOKEN_FILE=~/.dejaview-tunnel-token
# TUNNEL_HOSTNAME=dejaview.example.com

# Roblox Open Cloud: uploads each world's textured room (roblox.glb) as a Model asset the game loads by assetId
# ROBLOX_UPLOAD=1 lets THIS server upload room models to Roblox (set it on the one live server only; test servers
# load the same .env and must never upload)
# ROBLOX_UPLOAD=1
# ROBLOX_API_KEY=
# ROBLOX_CREATOR_ID=

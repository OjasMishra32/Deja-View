      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Interp</string>
          <string name="Source"><![CDATA[-- Snapshot interpolation. The server uses this for tag checks and clients use it to draw,
-- so players are tagged by the ghost they can see (team/shivin.md 7.4).
local Util = require(script.Parent.Util)

local Interp = {}

Interp.DELAY = 0.35 -- render this far in the past
Interp.KEEP = 2 -- seconds of history
Interp.MAX_EXTRAPOLATE = 0.25
Interp.STALE = 3

export type Snap = {
	stamp: number,
	pos: Vector3, -- feet
	yaw: number,
	head: Vector3?,
	hl: Vector3?,
	hr: Vector3?,
}

export type Sample = {
	pos: Vector3,
	yaw: number,
	head: Vector3?,
	hl: Vector3?,
	hr: Vector3?,
	age: number, -- seconds since the newest snapshot
}

export type Buffer = { snaps: { Snap } }

function Interp.new(): Buffer
	return { snaps = {} }
end

function Interp.push(buf: Buffer, snap: Snap)
	local snaps = buf.snaps
	local last = snaps[#snaps]
	if last and snap.stamp <= last.stamp then
		snap.stamp = last.stamp + 1e-3
	end
	table.insert(snaps, snap)
	local cutoff = snap.stamp - Interp.KEEP
	while #snaps > 2 and snaps[1].stamp < cutoff do
		table.remove(snaps, 1)
	end
end

function Interp.newest(buf: Buffer): Snap?
	return buf.snaps[#buf.snaps]
end

local function lerpOpt(a: Vector3?, b: Vector3?, t: number): Vector3?
	if a and b then
		return a:Lerp(b, t)
	end
	if t < 0.5 then
		return a
	end
	return b
end

local function blend(a: Snap, b: Snap, t: number, now: number): Sample
	return {
		pos = a.pos:Lerp(b.pos, t),
		yaw = Util.lerpAngle(a.yaw, b.yaw, t),
		head = lerpOpt(a.head, b.head, t),
		hl = lerpOpt(a.hl, b.hl, t),
		hr = lerpOpt(a.hr, b.hr, t),
		age = now - b.stamp,
	}
end

-- renderT and now are workspace:GetServerTimeNow() values (renderT = now - DELAY).
function Interp.sample(buf: Buffer, renderT: number, now: number): Sample?
	local snaps = buf.snaps
	local n = #snaps
	if n == 0 then
		return nil
	end
	local newest = snaps[n]
	if n == 1 or renderT <= snaps[1].stamp then
		local s = if renderT <= snaps[1].stamp then snaps[1] else newest
		return blend(s, s, 0, now)
	end
	if renderT >= newest.stamp then
		-- Past the newest snapshot: extrapolate briefly with the last velocity, then hold.
		local prev = snaps[n - 1]
		local dt = newest.stamp - prev.stamp
		local ahead = math.min(renderT - newest.stamp, Interp.MAX_EXTRAPOLATE)
		local t = if dt > 1e-3 then 1 + ahead / dt else 1
		t = math.min(t, 2)
		local s = blend(prev, newest, t, now)
		-- Hands/head only lerp sensibly inside [0, 1]; for the overshoot keep body-relative offsets.
		local shift = s.pos - newest.pos
		s.head = newest.head and newest.head + shift
		s.hl = newest.hl and newest.hl + shift
		s.hr = newest.hr and newest.hr + shift
		return s
	end
	for i = n - 1, 1, -1 do
		local a = snaps[i]
		if a.stamp <= renderT then
			local b = snaps[i + 1]
			local t = (renderT - a.stamp) / math.max(b.stamp - a.stamp, 1e-3)
			return blend(a, b, t, now)
		end
	end
	return blend(snaps[1], snaps[1], 0, now)
end

return Interp
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">PingPongSim</string>
          <string name="Source"><![CDATA[-- The ping pong physics, shared by the server and every client (team/seb.md Update 5, section B).
-- Everything here is in the table frame: long axis Z, net at z = 0, table top at y = 0, studs.
-- The server owns the ball; clients use the same step to predict and to smooth the render.
local Sim = {}

Sim.LEN = 9.78 -- 2.74 m table top
Sim.WID = 5.44 -- 1.525 m
Sim.TOP_Y = 0
Sim.NET_H = 0.54
Sim.NET_L = 6.53
Sim.BALL_R = 0.15 -- physics radius, bigger than a real ball so it is visible
Sim.GRAVITY = 35.0 -- 9.81 m/s^2 in studs
Sim.MAX_SPEED = 107 -- a 30 m/s smash
Sim.REST_TABLE = 0.88
Sim.DRAG = 0.02
Sim.DEAD_Y = -2.5
Sim.DEAD_AFTER = 1.5
Sim.SUBSTEPS = 4
Sim.WIN_SCORE = 11
Sim.SKIT_SCORE = 7

local function fin(v: number): boolean
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

Sim.fin = fin

-- New ball state. `pos` and `vel` are table-frame vectors.
function Sim.newState(pos: Vector3, vel: Vector3, t: number): any
	return { p = pos, v = vel, t = t, live = true, lastTouch = t, bounces = 0, shot = 0 }
end

-- Table frame from the four top corners the server sends (contract 6.6): corners in order around the top.
-- Returns centre, yaw (long axis), length and width in studs.
function Sim.fromCorners(corners: { any }): (Vector3?, number?, number?, number?)
	if type(corners) ~= "table" or #corners < 4 then
		return nil
	end
	local c = {}
	for i = 1, 4 do
		local v = corners[i]
		if type(v) ~= "table" then
			return nil
		end
		local x = v[1] or v.x
		local y = v[2] or v.y
		local z = v[3] or v.z
		if not (fin(x) and fin(y) and fin(z)) then
			return nil
		end
		c[i] = Vector3.new(x, y, z)
	end
	local centre = (c[1] + c[2] + c[3] + c[4]) / 4
	local e1, e2 = c[2] - c[1], c[3] - c[2]
	local long, short = e1, e2
	if e2.Magnitude > e1.Magnitude then
		long, short = e2, e1
	end
	if long.Magnitude < 1 or short.Magnitude < 1 then
		return nil
	end
	local yaw = math.atan2(-long.X, -long.Z)
	return centre, yaw, long.Magnitude, short.Magnitude
end

-- A serve waiting over the server's end line, at chest height.
function Sim.servePos(side: string, len: number): Vector3
	local dir = if side == "A" then -1 else 1
	return Vector3.new(0, 1.55, dir * (len / 2 + 0.7))
end

-- True when a table-frame point is over the top.
function Sim.overTable(p: Vector3, len: number, wid: number): boolean
	return math.abs(p.X) <= wid / 2 and math.abs(p.Z) <= len / 2
end

-- One fixed step of the ball. Returns an event table: { table = side?, net = boolean, dead = boolean }.
-- The caller decides points; this only moves the ball and reports what it touched.
function Sim.step(st: any, dt: number, len: number, wid: number): any
	local ev = {}
	if not st.live then
		return ev
	end
	local p, v = st.p, st.v
	local p0 = p
	v = v + Vector3.new(0, -Sim.GRAVITY * dt, 0)
	v = v - v * (Sim.DRAG * v.Magnitude * dt)
	p = p + v * dt

	-- Table top: the ball's bottom crosses y = 0 while moving down, inside the top rectangle.
	if v.Y < 0 and p.Y - Sim.BALL_R <= Sim.TOP_Y and p0.Y - Sim.BALL_R > Sim.TOP_Y then
		local a = (p0.Y - Sim.BALL_R - Sim.TOP_Y) / math.max(1e-6, (p0.Y - Sim.BALL_R) - (p.Y - Sim.BALL_R))
		local hit = p0:Lerp(p, math.clamp(a, 0, 1))
		if Sim.overTable(hit, len, wid) then
			p = Vector3.new(hit.X, Sim.TOP_Y + Sim.BALL_R, hit.Z)
			v = Vector3.new(v.X * 0.95, -v.Y * Sim.REST_TABLE, v.Z * 0.95)
			st.bounces += 1
			ev.table = if hit.Z < 0 then "A" else "B"
		end
	end

	-- Net: a thin box at z = 0. A ball that clears the top carries on.
	local crossed = (p0.Z < 0 and p.Z >= 0) or (p0.Z > 0 and p.Z <= 0)
	if crossed and math.abs(p.X) <= Sim.NET_L / 2 and p.Y - Sim.BALL_R < Sim.NET_H then
		local a = (0 - p0.Z) / math.max(1e-6, p.Z - p0.Z)
		local hit = p0:Lerp(p, math.clamp(a, 0, 1))
		if hit.Y - Sim.BALL_R < Sim.NET_H then
			p = Vector3.new(hit.X, hit.Y, 0)
			v = Vector3.new(v.X * 0.5, v.Y * 0.5, -v.Z * 0.2)
			ev.net = true
		end
	end

	if p.Y < Sim.DEAD_Y then
		st.live = false
		ev.dead = true
	end
	if st.t - st.lastTouch > Sim.DEAD_AFTER then
		st.live = false
		ev.dead = true
	end

	st.p, st.v, st.t = p, v, st.t + dt
	return ev
end

-- Reflect the ball off a paddle. `n` is the blade normal, `pv` the paddle velocity.
function Sim.paddleHit(st: any, n: Vector3, pv: Vector3, restitution: number?): void
	local rel = st.v - pv
	local vn = rel:Dot(n)
	if vn < 0 then
		rel = rel - n * ((1 + (restitution or 0.8)) * vn)
		-- keep a little of the sideways paddle movement, not all of it
		st.v = rel
		if st.v.Magnitude > Sim.MAX_SPEED then
			st.v = st.v.Unit * Sim.MAX_SPEED
		end
		st.lastTouch = st.t
		st.bounces = 0
	end
end

-- The phone/PC assist and the bot: aim at a target from p0 and solve for the launch velocity in time t.
function Sim.assistVelocity(p0: Vector3, target: Vector3, t: number): Vector3
	local g = Vector3.new(0, -Sim.GRAVITY, 0)
	return (target - p0) / t - g * (0.5 * t)
end

-- A return from the assist: aim x across the far half and pick a depth, then lift it over the net if needed.
function Sim.assistReturn(p0: Vector3, side: string, aim: number, flight: number, len: number, wid: number): Vector3
	local dir = if side == "A" then -1 else 1
	local x = math.clamp(aim, -1, 1) * (wid / 2 - 0.4)
	local target = Vector3.new(x, Sim.TOP_Y + Sim.BALL_R, dir * (len / 2 - 0.6))
	local v = Sim.assistVelocity(p0, target, math.clamp(flight, 0.5, 0.9))
	-- make sure it clears the net
	local zCross = math.abs(p0.Z)
	local tCross = if math.abs(v.Z) > 0.01 then zCross / math.abs(v.Z) else 1
	local yAtNet = p0.Y + v.Y * tCross - 0.5 * Sim.GRAVITY * tCross * tCross
	local need = Sim.NET_H + Sim.BALL_R + 0.3
	if yAtNet < need then
		v = v + Vector3.new(0, (need - yAtNet) / math.max(0.2, tCross), 0)
	end
	if v.Magnitude > Sim.MAX_SPEED then
		v = v.Unit * Sim.MAX_SPEED
	end
	return v
end

return Sim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[-- One look for every UI: dark, one lime accent, bold type (team/shivin.md 7.6).
local Theme = {}

Theme.Bg = Color3.fromHex("0B0B0F")
Theme.Surface = Color3.fromHex("15151B")
Theme.Stroke = Color3.fromHex("2A2A33")
Theme.Text = Color3.fromHex("F4F4F5")
Theme.Muted = Color3.fromHex("9A9AA6")
Theme.Accent = Color3.fromHex("C6FF3D")
Theme.Danger = Color3.fromHex("FF4D6D")
Theme.Imagined = Color3.fromRGB(255, 61, 200)

Theme.Heading = Font.fromName("BuilderSans", Enum.FontWeight.ExtraBold)
Theme.Body = Font.fromName("BuilderSans", Enum.FontWeight.Bold)

-- Swap these for Roblox-made Creator Store sounds (credit them on Devpost).
Theme.Sounds = {
	tag = "rbxasset://sounds/electronicpingshort.wav",
	tick = "rbxasset://sounds/clickfast.wav",
	win = "rbxasset://sounds/electronicpingshort.wav",
}

-- Tiny instance builder: make("Frame", {props}, {children})
function Theme.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	for k, v in (props or {}) :: { [string]: any } do
		if k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(px: number?): UICorner
	return Theme.make("UICorner", { CornerRadius = UDim.new(0, px or 14) })
end

function Theme.stroke(color: Color3?, thickness: number?): UIStroke
	return Theme.make("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.label(props: { [string]: any }): TextLabel
	local p = {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Text,
		FontFace = Theme.Body,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		p[k] = v
	end
	local children = { Theme.make("UITextSizeConstraint", { MaxTextSize = p.MaxText or 28, MinTextSize = 8 }) }
	p.MaxText = nil
	return Theme.make("TextLabel", p, children)
end

function Theme.button(props: { [string]: any }): TextButton
	local p = {
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 0.05,
		TextColor3 = Theme.Text,
		FontFace = Theme.Heading,
		TextScaled = true,
		AutoButtonColor = true,
	}
	for k, v in props do
		p[k] = v
	end
	local maxText = p.MaxText or 20
	p.MaxText = nil
	return Theme.make("TextButton", p, {
		Theme.corner(12),
		Theme.stroke(),
		Theme.make("UITextSizeConstraint", { MaxTextSize = maxText, MinTextSize = 8 }),
		Theme.make("UIPadding", {
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
		}),
	})
end

function Theme.toHex(c: Color3): string
	return c:ToHex()
end

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Small helpers shared by server and clients.
local Util = {}

-- Accept [x, y, z] or {x =, y =, z =}; nil if missing.
function Util.vec(v: any): Vector3?
	if type(v) ~= "table" then
		return nil
	end
	local x, y, z = v[1] or v.x, v[2] or v.y, v[3] or v.z
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		return nil
	end
	return Vector3.new(x, y, z)
end

function Util.lerpAngle(a: number, b: number, t: number): number
	local d = (b - a + math.pi) % (2 * math.pi) - math.pi
	return a + d * t
end

-- Character -> yaw (0 faces -Z, positive turns left).
function Util.yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

function Util.feetOf(character: Model): Vector3?
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return nil
	end
	local p = hrp.Position
	return Vector3.new(p.X, p.Y - (hum.HipHeight + hrp.Size.Y / 2), p.Z)
end

function Util.ageText(createdAt: string?): string
	if not createdAt then
		return ""
	end
	local ok, dt = pcall(DateTime.fromIsoDate, createdAt)
	if not ok or not dt then
		return ""
	end
	local secs = DateTime.now().UnixTimestamp - dt.UnixTimestamp
	if secs < 60 then
		return "just now"
	elseif secs < 3600 then
		return math.floor(secs / 60) .. " min ago"
	elseif secs < 86400 then
		return math.floor(secs / 3600) .. " h ago"
	end
	return math.floor(secs / 86400) .. " d ago"
end

function Util.commas(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="18">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">DejaView</string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Api</string>
          <string name="Source"><![CDATA[-- The ONLY code that touches HttpService. Same interface as MockServer.
-- Every call returns ok, decodedBodyOrError, statusCode.
local HttpService = game:GetService("HttpService")
local Config = require(script.Parent.Config)

local Api = {}

local secret: any = nil
local secretTried = false
local timeoutSupported = true

local function getSecret()
	if not secretTried then
		secretTried = true
		local ok, s = pcall(function()
			return HttpService:GetSecret(Config.SECRET_NAME)
		end)
		if ok then
			secret = s
		else
			warn("[DejaView] secret '" .. Config.SECRET_NAME .. "' unavailable, sending without key:", s)
		end
	end
	return secret
end

local function headers(isPost: boolean)
	local h: { [string]: any } = {}
	if isPost then
		h["content-type"] = "application/json"
	end
	local s = getSecret()
	if s then
		h["x-dejaview-key"] = s
	end
	return h
end

-- Failover between the configured address (Experience Config) and the one built into the code: a stale
-- dejaview_base or a tunnel that died must never strand the game. Only "nobody answered" counts (DNS, refused,
-- timeout, Cloudflare 530 for a gone tunnel); an app error like a 502 from one route does not.
local useFallback = false
local deadStreak = 0
local DEAD_LIMIT = 3

local function currentBase(): string
	local configured = Config.base()
	if workspace:GetAttribute("DejaViewBase") then
		return configured -- an explicit console override always wins
	end
	local fallback = (Config.BASE_FALLBACK:gsub("/+$", ""))
	return if useFallback and fallback ~= configured then fallback else configured
end

local function noteResult(answered: boolean)
	if answered then
		deadStreak = 0
		return
	end
	deadStreak += 1
	if deadStreak >= DEAD_LIMIT then
		deadStreak = 0
		local configured = Config.base()
		local fallback = (Config.BASE_FALLBACK:gsub("/+$", ""))
		if configured ~= fallback and not workspace:GetAttribute("DejaViewBase") then
			useFallback = not useFallback
			warn("[DejaView] no answer from the server; switching to " .. currentBase())
		end
	end
end

local function request(method: string, path: string, body: any?, timeout: number?)
	local opts: { [string]: any } = {
		Url = currentBase() .. path,
		Method = method,
		Headers = headers(body ~= nil),
		Body = if body ~= nil then HttpService:JSONEncode(body) else nil,
	}
	if timeoutSupported then
		opts.Timeout = timeout or 5
	end
	local ok, res = pcall(HttpService.RequestAsync, HttpService, opts)
	if not ok and timeoutSupported and tostring(res):find("Timeout") then
		timeoutSupported = false
		opts.Timeout = nil
		ok, res = pcall(HttpService.RequestAsync, HttpService, opts)
	end
	if not ok then
		noteResult(false)
		return false, tostring(res), 0
	end
	noteResult(res.StatusCode ~= 530)
	local okJson, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not okJson then
		return false, "not JSON (tunnel down?)", res.StatusCode
	end
	return res.Success, data, res.StatusCode
end

-- Scene ids are like "game-night-k3x9a": keep unreserved characters as they are
-- (HttpService:UrlEncode turns "-" into "%2D", which some servers do not decode in paths).
local function enc(id: string): string
	return (id:gsub("[^%w%-%._~]", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

function Api.scenes()
	return request("GET", "/api/scenes")
end

function Api.map(sceneId: string, maxParts: number?)
	local q = if maxParts then "?maxParts=" .. tostring(maxParts) else ""
	return request("GET", "/api/roblox/" .. enc(sceneId) .. "/map" .. q, nil, 20)
end

-- Textured room model details (contract 6.2b): units, chunks, spawn, and assetId once uploaded.
function Api.model(sceneId: string)
	return request("GET", "/api/roblox/" .. enc(sceneId) .. "/model")
end

-- Gemini labels (Update 4): {hotspots:[{label, blurb, x, y, z}]} in room metres.
function Api.hotspots(sceneId: string)
	return request("GET", "/api/scenes/" .. enc(sceneId) .. "/hotspots")
end

-- Notes (Update 4): {notes:[{id, author, text, x, y, z}]} in metres; POST {author, text, x, y, z}.
function Api.notes(sceneId: string)
	return request("GET", "/api/notes/" .. enc(sceneId))
end

function Api.addNote(sceneId: string, body: any)
	return request("POST", "/api/notes/" .. enc(sceneId), body)
end

function Api.presence(sceneId: string, body: any)
	return request("POST", "/api/roblox/" .. enc(sceneId) .. "/presence", body)
end

function Api.event(sceneId: string, body: any)
	return request("POST", "/api/roblox/" .. enc(sceneId) .. "/event", body)
end

-- Metres; use only the count and kind (Follow).
function Api.people(sceneId: string)
	return request("GET", "/api/presence/" .. enc(sceneId))
end

return Api
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Backend</string>
          <string name="Source"><![CDATA[-- Picks MockServer or Api per call, so "use_mock" can flip live from Experience Configs.
local Config = require(script.Parent.Config)
local Api = require(script.Parent.Api)
local MockServer = require(script.Parent.MockServer)

local Backend = {}

local function impl()
	return if Config.useMock() then MockServer else Api
end

function Backend.scenes()
	return impl().scenes()
end

function Backend.map(sceneId: string, maxParts: number?)
	return impl().map(sceneId, maxParts)
end

function Backend.model(sceneId: string)
	return impl().model(sceneId)
end

function Backend.hotspots(sceneId: string)
	return impl().hotspots(sceneId)
end

function Backend.notes(sceneId: string)
	return impl().notes(sceneId)
end

function Backend.addNote(sceneId: string, body: any)
	return impl().addNote(sceneId, body)
end

function Backend.presence(sceneId: string, body: any)
	return impl().presence(sceneId, body)
end

function Backend.event(sceneId: string, body: any)
	return impl().event(sceneId, body)
end

function Backend.people(sceneId: string)
	return impl().people(sceneId)
end

-- Event delivery: one queue so the server sees events in order (a last tag before round end).
-- Each event retries up to 3 times with a 1 s gap, then is dropped (contract 5.4).
local queue: { { sceneId: string, body: any } } = {}
local draining = false

local function drain()
	draining = true
	while #queue > 0 do
		local item = table.remove(queue, 1)
		for attempt = 1, 4 do
			local ok, res, status = Backend.event(item.sceneId, item.body)
			if ok then
				break
			end
			warn("[DejaView] event failed (" .. tostring(status) .. "):", res, "attempt", attempt)
			if attempt < 4 then
				task.wait(1)
			end
		end
	end
	draining = false
end

function Backend.sendEvent(sceneId: string, body: any)
	table.insert(queue, { sceneId = sceneId, body = body })
	if not draining then
		task.spawn(drain)
	end
end

return Backend
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Chess</string>
          <string name="Source"><![CDATA[-- Giant chess on the floor of the room (team/shivin.md Update 5, item 3). Click or tap a piece to see its legal moves,
-- then a highlighted square to move. The first player to touch a white piece plays white, likewise black.
-- Placement: the server's features.chessBoard when /model sends it, else Config.CHESS_BOARDS for the scene, else the
-- host drops a board in front of them (host bar: CHESS).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local World = require(script.Parent.World)
local Theme = require(ReplicatedStorage.Shared.Theme)
local R = require(ReplicatedStorage.Shared.ChessRules)
local Stats = require(script.Parent.Stats)

local Chess = {}

-- Roblox's fonts have no chess symbols (they render as empty boxes), so pieces carry bold letters; pawns stay plain.
local GLYPH = { K = "K", Q = "Q", R = "R", B = "B", N = "N", P = "" }
local HEIGHT = { K = 4.4, Q = 4, R = 3, B = 3.2, N = 3, P = 2.2 }
local LIGHT, DARK = Color3.fromRGB(226, 220, 206), Color3.fromRGB(58, 58, 68)
local WHITE, BLACK = Color3.fromRGB(244, 244, 245), Color3.fromRGB(28, 28, 34)

local folder: Folder? = nil
local origin = CFrame.new() -- centre of the board, Y = board top, -Z towards black
local square = 4 -- studs per square
local state: R.State = R.new()
local pieces: { [number]: Model } = {}
local seats: { [string]: Player? } = { w = nil, b = nil }
local selected: { [Player]: number } = {}
local over = false
local lastMove = ""
local turnLabel: TextLabel? = nil
local hidden: { [BasePart]: { number } } = {} -- world blocks cleared away for the board: {transparency, collide}

-- Clears world blocks that poke up into the board area (a voxel world is rarely flat), so the board is visible
-- and walkable; restored when the board goes away.
local function clearArea(centre: CFrame, size: number)
	local room = workspace:FindFirstChild("Room")
	if not room then
		return
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { room }
	local box = Vector3.new(size + square * 2, 14, size + square * 4)
	for _, part in workspace:GetPartBoundsInBox(centre * CFrame.new(0, 7.1, 0), box, params) do
		if part:IsA("BasePart") and not part:IsDescendantOf(folder :: any) and not hidden[part]
			and part.Parent and part.Parent.Name ~= "Bounds" then
			hidden[part] = { part.Transparency, if part.CanCollide then 1 else 0 }
			part.Transparency = 1
			part.CanCollide = false
		end
	end
end

local function restoreArea()
	for part, saved in hidden do
		if part.Parent then
			part.Transparency = saved[1]
			part.CanCollide = saved[2] == 1
		end
	end
	hidden = {}
end

-- Square index -> world CFrame at the square's top centre. a1 is at the near-left corner, seen from white's side.
local function squareCFrame(sq: number): CFrame
	local f, r = sq % 8, sq // 8
	return origin * CFrame.new((f - 3.5) * square, 0, (3.5 - r) * square)
end

local function sendTargets(player: Player, list: { number })
	World.Moment:FireClient(player, { type = "chessTargets", squares = list })
end

local function clearSelection(player: Player?)
	if player then
		selected[player] = nil
		sendTargets(player, {})
	else
		for p in selected do
			sendTargets(p, {})
		end
		selected = {}
	end
end

local function updateTurnBoard()
	if not turnLabel then
		return
	end
	local function who(c: string): string
		local p = seats[c]
		return if p then p.DisplayName else "tap a " .. (if c == "w" then "white" else "black") .. " piece to play"
	end
	local status = R.status(state)
	local side = if state.turn == "w" then "WHITE" else "BLACK"
	if status == "checkmate" then
		turnLabel.Text = "CHECKMATE · " .. (if state.turn == "w" then "BLACK" else "WHITE") .. " WINS"
	elseif status == "stalemate" then
		turnLabel.Text = "STALEMATE · DRAW"
	else
		turnLabel.Text = side .. " TO MOVE" .. (if status == "check" then " · CHECK" else "") .. "\n" .. who(state.turn)
			.. (if lastMove ~= "" then "  ·  last " .. lastMove else "")
	end
end

local onPieceClicked: (Player, number) -> ()
local onSquareClicked: (Player, number) -> ()

local function buildPiece(sq: number, p: string)
	local c, kind = string.sub(p, 1, 1), string.sub(p, 2, 2)
	local h = HEIGHT[kind] * (square / 4)
	local model = Instance.new("Model")
	model.Name = p
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Cylinder
	body.Size = Vector3.new(h, square * 0.62, square * 0.62)
	body.CFrame = squareCFrame(sq) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2)
	body.Color = if c == "w" then WHITE else BLACK
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored, body.CanCollide, body.CanTouch = true, false, false
	body.Parent = model
	local cap = Instance.new("Part")
	cap.Name = "Cap"
	cap.Shape = Enum.PartType.Ball
	cap.Size = Vector3.new(square * 0.5, square * 0.5, square * 0.5)
	cap.CFrame = squareCFrame(sq) * CFrame.new(0, h, 0)
	cap.Color = body.Color
	cap.Material = Enum.Material.SmoothPlastic
	cap.Anchored, cap.CanCollide, cap.CanTouch = true, false, false
	cap.Parent = model
	local gui = Theme.make("BillboardGui", {
		Size = UDim2.fromScale(square * 0.7, square * 0.7),
		StudsOffset = Vector3.new(0, square * 0.55, 0),
		LightInfluence = 0,
		MaxDistance = 160,
		Adornee = cap,
		Parent = cap,
	})
	Theme.make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = GLYPH[kind],
		TextScaled = true, FontFace = Theme.Heading, TextColor3 = if c == "w" then WHITE else BLACK,
		TextStrokeColor3 = if c == "w" then BLACK else WHITE, TextStrokeTransparency = 0, Parent = gui })
	for _, part in { body, cap } do
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 400
		cd.Parent = part
		cd.MouseClick:Connect(function(player)
			-- a click on a piece is a selection, or a capture when the player already holds a piece
			local held = selected[player]
			if held and held ~= sq and string.sub(p, 1, 1) ~= string.sub(state.board[held] or "", 1, 1) then
				onSquareClicked(player, sq)
			else
				onPieceClicked(player, sq)
			end
		end)
	end
	model.Parent = folder
	pieces[sq] = model
end

local function syncPieces()
	for sq, m in pieces do
		m:Destroy()
		pieces[sq] = nil
	end
	for sq = 0, 63 do
		local p = state.board[sq]
		if p then
			buildPiece(sq, p)
		end
	end
end

local function finish(status: string)
	over = true
	local sceneId = workspace:GetAttribute("SceneId")
	local winnerColour = if status == "checkmate" then R.other(state.turn) else nil
	local winnerPlayer: Player? = if winnerColour then seats[winnerColour] else nil
	local winnerName = if winnerPlayer then (winnerPlayer :: Player).DisplayName
		elseif winnerColour then (if winnerColour == "w" then "White" else "Black")
		else "draw"
	local score = if winnerColour == "w" then "1-0" elseif winnerColour == "b" then "0-1" else "1/2-1/2"
	if winnerPlayer then
		Stats.win(winnerPlayer, "chess")
		Stats.badge(winnerPlayer, "checkmate")
	end
	World.Moment:FireAllClients({
		type = "winner",
		title = if winnerColour then "CHECKMATE" else "STALEMATE",
		mvp = if winnerColour then string.upper(winnerName) .. " WINS · " .. score else "Draw · " .. score,
	})
	if type(sceneId) == "string" then
		Backend.sendEvent(sceneId, { type = "game", game = "chess", winner = winnerName, score = score,
			white = seats.w and seats.w.DisplayName or nil, black = seats.b and seats.b.DisplayName or nil })
	end
end

onPieceClicked = function(player: Player, sq: number)
	if over then
		World.toast("Game over · host can start a new board", player)
		return
	end
	local p = state.board[sq]
	if not p then
		return
	end
	local c = string.sub(p, 1, 1)
	if not seats[c] and seats[R.other(c)] ~= player then
		seats[c] = player
		World.toast(player.DisplayName .. " plays " .. (if c == "w" then "white" else "black"))
		updateTurnBoard()
	end
	local owner = seats[c]
	if owner ~= player then
		World.toast("That's " .. (if owner then owner.DisplayName else "someone else") .. "'s side", player)
		return
	end
	if c ~= state.turn then
		World.toast("Wait for your turn", player)
		return
	end
	local moves = R.legalFrom(state, sq)
	selected[player] = sq
	local targets = {}
	for _, m in moves do
		table.insert(targets, m.to)
	end
	if #targets == 0 then
		World.toast("That piece can't move", player)
	end
	sendTargets(player, targets)
end

onSquareClicked = function(player: Player, sq: number)
	local from = selected[player]
	if not from or over then
		return
	end
	for _, m in R.legalFrom(state, from) do
		if m.to == sq then
			local piece = state.board[from] :: string
			state = R.apply(state, m)
			lastMove = R.name(from) .. "→" .. R.name(sq)
			clearSelection(nil)
			syncPieces()
			local status = R.status(state)
			updateTurnBoard()
			local sceneId = workspace:GetAttribute("SceneId")
			if type(sceneId) == "string" then
				Backend.sendEvent(sceneId, { type = "chess", move = lastMove, piece = piece, by = "rbx-" .. player.UserId,
					status = status })
			end
			if status == "check" then
				World.toast("CHECK")
			elseif status == "checkmate" or status == "stalemate" then
				finish(status)
			end
			return
		end
	end
	-- not a legal target: drop the selection
	clearSelection(player)
end

function Chess.remove()
	restoreArea()
	if folder then
		folder:Destroy()
	end
	folder, turnLabel = nil, nil
	pieces = {}
	clearSelection(nil)
	workspace:SetAttribute("ChessActive", false)
end

-- Builds a fresh game. centre: board centre at floor height; yaw: direction white looks (0 faces -Z).
local lastPlace: any = nil

-- Rematch: the same game again in the same spot (Update 6 item 1).
function Chess.isActive(): boolean
	return lastPlace ~= nil and workspace:FindFirstChild("Room") ~= nil and workspace.Room:FindFirstChild("Chess") ~= nil
end

function Chess.rematch()
	if lastPlace then
		Chess.place(table.unpack(lastPlace, 1, lastPlace.n))
	end
end

function Chess.place(centre: Vector3, yaw: number, size: number?)
	lastPlace = table.pack(centre, yaw, size)
	Chess.remove()
	local room = workspace:FindFirstChild("Room")
	if not room then
		return
	end
	square = (size or 32) / 8
	origin = CFrame.new(centre + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, yaw, 0)
	state, seats, over, lastMove = R.new(), { w = nil, b = nil }, false, ""
	local f = Instance.new("Folder")
	f.Name = "Chess"
	f.Parent = room
	folder = f
	for sq = 0, 63 do
		local part = Instance.new("Part")
		part.Name = "Sq" .. sq
		part.Size = Vector3.new(square, 0.4, square)
		part.CFrame = squareCFrame(sq) * CFrame.new(0, -0.2, 0)
		part.Color = if (sq % 8 + sq // 8) % 2 == 0 then DARK else LIGHT
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored, part.CanTouch = true, false
		part:SetAttribute("Square", sq)
		part.Parent = f
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = 400
		cd.Parent = part
		cd.MouseClick:Connect(function(player)
			onSquareClicked(player, sq)
		end)
	end
	-- turn board floating above black's side
	local sign = Instance.new("Part")
	sign.Name = "TurnBoard"
	sign.Anchored, sign.CanCollide, sign.CanQuery, sign.CanTouch = true, false, false, false
	sign.Transparency = 1
	sign.Size = Vector3.one
	sign.CFrame = origin * CFrame.new(0, square * 3, -square * 5)
	sign.Parent = f
	local gui = Theme.make("BillboardGui", { Size = UDim2.fromOffset(420, 96), AlwaysOnTop = true, LightInfluence = 0,
		MaxDistance = 220, Parent = sign })
	local card = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.08,
		Parent = gui }, { Theme.corner(14), Theme.stroke(Theme.Accent, 1.5) })
	turnLabel = Theme.label({ Text = "", FontFace = Theme.Heading, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), MaxText = 28, Parent = card })
	clearArea(origin, square * 8)
	syncPieces()
	updateTurnBoard()
	workspace:SetAttribute("ChessActive", true)
end

-- Board from features.chessBoard: 4 corners (studs) with the a1 corner named. Accepts {corners=[[x,y,z]x4], a1=index}.
local function placeFromFeature(fb: any): boolean
	if type(fb) ~= "table" or type(fb.corners) ~= "table" or #fb.corners < 4 then
		return false
	end
	local pts = {}
	for i = 1, 4 do
		local c = fb.corners[i]
		pts[i] = Vector3.new(c[1] or c.x, c[2] or c.y, c[3] or c.z)
	end
	local a1 = tonumber(fb.a1) or 1
	local centre = (pts[1] + pts[2] + pts[3] + pts[4]) / 4
	-- white sits behind a1; white looks from a1 towards the board centre
	local a1p = pts[a1]
	local toCentre = Vector3.new(centre.X - a1p.X, 0, centre.Z - a1p.Z)
	local side = (pts[1] - pts[2]).Magnitude
	-- a1 -> centre is 45 degrees left of white's forward direction
	local forward = CFrame.Angles(0, -math.pi / 4, 0):VectorToWorldSpace(toCentre.Unit)
	Chess.place(centre, math.atan2(-forward.X, -forward.Z), side)
	return true
end

-- Host: put a board in this room (server features > hand-tuned table > in front of the host).
function Chess.placeForRoom(host: Player?, features: any?, cameraLook: Vector3?)
	local sceneId = workspace:GetAttribute("SceneId")
	if features and placeFromFeature(features.chessBoard) then
		return
	end
	local tuned = type(sceneId) == "string" and Config.CHESS_BOARDS[sceneId]
	if tuned then
		Chess.place(Vector3.new(tuned.centre[1], tuned.centre[2], tuned.centre[3]), tuned.yaw or 0, tuned.size)
		return
	end
	local hrp = host and host.Character and host.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		World.toast("Walk into the room first", host)
		return
	end
	-- In front of where the host is looking (their camera), so the board appears in view.
	local dir = if typeof(cameraLook) == "Vector3" then cameraLook else hrp.CFrame.LookVector
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local look = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
	local spot = hrp.Position + look * 24
	-- The host stands on the floor: use their feet height (a ray from above can land on a tower top instead).
	local hum = (hrp.Parent :: Model):FindFirstChildOfClass("Humanoid")
	local floorY = hrp.Position.Y - ((hum and hum.HipHeight or 2) + hrp.Size.Y / 2)
	-- white faces away from the host, so the host stands on white's side
	Chess.place(Vector3.new(spot.X, floorY, spot.Z), math.atan2(-look.X, -look.Z), 32)
end

function Chess.start()
	Players.PlayerRemoving:Connect(function(p)
		selected[p] = nil
		for c, s in seats do
			if s == p then
				seats[c] = nil
			end
		end
		updateTurnBoard()
	end)
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		-- the old room (and this board) is torn down with it; never carry a board into another room
		folder, turnLabel, pieces, hidden = nil, nil, {}, {}
		selected = {}
		workspace:SetAttribute("ChessActive", false)
	end)
end

return Chess
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Constants plus live values from Experience Configs (Creator Hub -> Configs).
local ConfigServiceOk, ConfigService = pcall(function()
	return game:GetService("ConfigService")
end)

local Config = {
	-- Flip to false once the public BASE is live (or create a boolean config "use_mock").
	USE_MOCK = false,
	-- Ojasva's public link (Update 4). A dejaview_base Experience Config overrides it.
	BASE_FALLBACK = "https://prozac-covered-burke-oklahoma.trycloudflare.com",
	SECRET_NAME = "dejaview_key",

	ROUND_SECONDS = 90,
	LIVES = 3,
	TAG_RADIUS = 4,
	IMMUNITY = 3,
	COUNTDOWN = 3,
	TAG_CHECK_HZ = 10,

	MAX_PARTS = 12000, -- finer blocks (1.1-stud voxels on Tilted Towers vs 1.64 at 6000); max_parts config lowers it
	BATCH = 400,

	PRESENCE_PERIOD = 0.25,
	ROOMS_PERIOD = 3,
	PICKER_MAX = 12,

	LOBBY_CENTER = Vector3.new(0, 300, 0),
	WALK_SPEED = 12,
	FALL_Y = -4, -- root part height; the room floor is at y = 0 and its safety floor 8 studs under it

	-- Scene the server builds on boot if it is ready (falls back to the newest ready room).
	DEFAULT_SCENE = "the-courts", -- Update 8: the court is the best demo moment; boot there
	-- Rooms always listed first on the picker, in this order (Update 8: "the-courts loads first in your picker").
	PINNED_SCENES = { "the-courts" } :: { string },
	-- Auto-join on boot. Set false for the skit (everyone waits in the lobby until JOIN).
	AUTO_JOIN_DEFAULT = true,
	-- Hand-tuned chess boards per scene until /model sends features.chessBoard (Update 5):
	-- ["chess-room"] = { centre = { x, y, z }, yaw = 0, size = 32 }   (studs; yaw = the way white looks)
	CHESS_BOARDS = {} :: { [string]: any },
	-- Hand-tuned ping pong tables until features.pingPongTable (studs; centre = table top centre; yaw: long axis):
	-- ["the-courts"] = { centre = { x, y, z }, yaw = 0, length = 14, width = 8, visible = false }
	PINGPONG_TABLES = {} :: { [string]: any },
	-- Hand-tuned foosball tables until features.foosballTable (same shape as PINGPONG_TABLES; length 16, width 9)
	FOOSBALL_TABLES = {} :: { [string]: any },
	-- Extra Roblox user ids that get host controls (the owner always does).
	HOST_USER_IDS = {} :: { number },

	-- Mock knobs
	MOCK_LATENCY = { 0.05, 0.25 },
	MOCK_FAIL_RATE = 0.05,
	MOCK_NOISE_PARTS = 120, -- random filler blocks in mock rooms (stress rooms still use 6k/12k)
	MOCK_STRESS_ROOMS = true, -- adds 6k and 12k part rooms to the mock list
}

local snapshot: any = nil
local values: { [string]: any } = {}

-- Cache per config version: GetValue warns on every call for a key that is not defined yet,
-- and presence reads use_mock 4 times a second.
local MISSING = newproxy()
local cache: { [string]: any } = {}

local function read(key: string): any
	if values[key] ~= nil then
		return values[key]
	end
	if not snapshot then
		return nil
	end
	local v = cache[key]
	if v == nil then
		local ok, got = pcall(function()
			return snapshot:GetValue(key)
		end)
		v = if ok and got ~= nil then got else MISSING
		cache[key] = v
	end
	return if v == MISSING then nil else v
end

Config.loaded = false

-- Blocks until the live config has loaded (or failed), at most `timeout` seconds.
function Config.waitLoaded(timeout: number)
	local t0 = os.clock()
	while not Config.loaded and os.clock() - t0 < timeout do
		task.wait(0.1)
	end
end

function Config.init()
	if not ConfigServiceOk or not ConfigService then
		warn("[DejaView] ConfigService unavailable, using built-in defaults")
		Config.loaded = true
		return
	end
	local ok, snap = pcall(function()
		return (ConfigService :: any):GetConfigAsync()
	end)
	if not ok or not snap then
		warn("[DejaView] GetConfigAsync failed, using defaults:", snap)
		Config.loaded = true
		return
	end
	snapshot = snap
	pcall(function()
		snap.UpdateAvailable:Connect(function()
			snap:Refresh()
			cache = {}
		end)
	end)
	Config.loaded = true
	print("[DejaView] config: base =", Config.base(), "mock =", Config.useMock(), "round =", Config.roundSeconds())
end

-- Runtime override from the server console: require(...Config).set("dejaview_base", "https://...")
function Config.set(key: string, value: any)
	values[key] = value
end

-- Emergency override that works from the F9 server console (a console `require` gets its own copy of this module,
-- so Config.set from there does not reach the game; workspace attributes are shared):
--   workspace:SetAttribute("DejaViewBase", "https://...")   workspace:SetAttribute("DejaViewMock", false)
function Config.base(): string
	local o = workspace:GetAttribute("DejaViewBase")
	if type(o) == "string" and o ~= "" then
		return (o:gsub("/+$", ""))
	end
	local v = read("dejaview_base")
	if type(v) == "string" and v ~= "" then
		return (v:gsub("/+$", ""))
	end
	return Config.BASE_FALLBACK
end

function Config.useMock(): boolean
	local o = workspace:GetAttribute("DejaViewMock")
	if type(o) == "boolean" then
		return o
	end
	local v = read("use_mock")
	if type(v) == "boolean" then
		return v
	end
	return Config.USE_MOCK
end

function Config.roundSeconds(): number
	local v = read("round_seconds")
	if type(v) == "number" and v > 0 then
		return v
	end
	return Config.ROUND_SECONDS
end

function Config.maxParts(): number
	local v = read("max_parts")
	if type(v) == "number" and v > 0 then
		return math.min(v, 12000)
	end
	return Config.MAX_PARTS
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Extras</string>
          <string name="Source"><![CDATA[-- Gemini labels, the "Hunt" round and notes in the room (team/shivin.md Update 4, items 2 and 3).
-- Labels and notes come in room metres; studs = metres * studsPerMeter, the same transform as the map.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local Backend = require(script.Parent.Backend)
local MapBuilder = require(script.Parent.MapBuilder)
local World = require(script.Parent.World)
local Theme = require(ReplicatedStorage.Shared.Theme)

local LeaveNote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("LeaveNote") :: RemoteEvent

local Extras = {}

local HUNT_RADIUS = 6 -- studs, horizontal
local HUNT_SECONDS = 120
local NOTE_MAX = 140
local NOTE_COOLDOWN = 5

local labels: { { label: string, blurb: string, pos: Vector3 } } = {}
local labelsScene: string? = nil
local notesShown: { [string]: BasePart } = {}
local filtered: { [string]: string } = {}
local lastNoteAt: { [Player]: number } = {}

local hunt = {
	active = false,
	endsAt = 0,
	found = {} :: { [Player]: { [number]: boolean } },
	round = 0,
}

local function spm(): number
	return (MapBuilder.current and MapBuilder.current.studsPerMeter) or 3.57
end

local function toStuds(o: any): Vector3?
	local x, y, z = tonumber(o.x), tonumber(o.y), tonumber(o.z)
	if not x or not y or not z then
		return nil
	end
	return Vector3.new(x, y, z) * spm()
end

local function anchorPart(name: string, pos: Vector3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(pos)
	p.Parent = parent
	return p
end

local function roomFolder(name: string): Folder?
	local room = workspace:FindFirstChild("Room")
	if not room then
		return nil
	end
	local f = room:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = room
	end
	return f :: Folder
end

-- Text typed by people must be filtered before other players see it. Outside text (the headset, Seb's map) is
-- filtered as if the experience owner sent it.
local function filter(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		local r = TextService:FilterStringAsync(text, fromUserId)
		return r:GetNonChatStringForBroadcastAsync()
	end)
	return if ok then result else nil
end

local function ownerId(): number
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId ~= 0 then
		return game.CreatorId
	end
	local first = Players:GetPlayers()[1]
	return if first then first.UserId else 1
end

------------------------------------------------------------------ labels

local function buildLabels()
	local f = roomFolder("Labels")
	if not f then
		return
	end
	f:ClearAllChildren()
	for i, l in labels do
		local p = anchorPart("Label" .. i, l.pos, f)
		p:SetAttribute("Label", l.label)
		local gui = Theme.make("BillboardGui", {
			Size = UDim2.fromOffset(220, 64),
			StudsOffset = Vector3.new(0, 1.2, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			MaxDistance = 140,
			Parent = p,
		})
		local card = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg,
			BackgroundTransparency = 0.1, Parent = gui }, { Theme.corner(12), Theme.stroke(Theme.Accent, 1.5) })
		Theme.label({ Name = "Title", Text = string.upper(l.label), FontFace = Theme.Heading, TextColor3 = Theme.Accent,
			Size = UDim2.new(1, -16, 0.55, 0), Position = UDim2.fromOffset(8, 4), MaxText = 22, Parent = card })
		Theme.label({ Text = l.blurb, TextColor3 = Theme.Text, Size = UDim2.new(1, -16, 0.38, 0),
			Position = UDim2.new(0, 8, 0.55, 0), MaxText = 15, Parent = card })
		-- a small lime dot marks the exact spot
		local dot = anchorPart("Dot", l.pos, p)
		dot.Shape = Enum.PartType.Ball
		dot.Size = Vector3.new(0.6, 0.6, 0.6)
		dot.Material = Enum.Material.Neon
		dot.Color = Theme.Accent
		dot.Transparency = 0.1
	end
	workspace:SetAttribute("LabelCount", #labels)
end

local function refreshLabels(sceneId: string): boolean
	local ok, res = Backend.hotspots(sceneId)
	if not ok or type(res) ~= "table" or type(res.hotspots) ~= "table" then
		return false
	end
	local fresh = {}
	for _, h in res.hotspots do
		local pos = type(h) == "table" and toStuds(h)
		if pos then
			table.insert(fresh, { label = tostring(h.label or "?"), blurb = tostring(h.blurb or ""), pos = pos })
		end
	end
	local changed = #fresh ~= #labels or labelsScene ~= sceneId
	if not changed then
		for i, l in fresh do
			changed = changed or l.label ~= labels[i].label or (l.pos - labels[i].pos).Magnitude > 0.01
		end
	end
	if changed then
		labels, labelsScene = fresh, sceneId
		buildLabels()
	end
	return #fresh > 0
end

------------------------------------------------------------------ notes

local function showNote(n: any)
	local id = tostring(n.id or (tostring(n.author) .. tostring(n.text)))
	if notesShown[id] then
		return
	end
	local pos = toStuds(n)
	local f = roomFolder("Notes")
	if not pos or not f then
		return
	end
	local text = filtered[id]
	if not text then
		text = filter(tostring(n.text or ""):sub(1, NOTE_MAX), ownerId())
		if not text then
			return -- could not filter: never show unfiltered text
		end
		filtered[id] = text
	end
	local p = anchorPart("Note", pos, f)
	local gui = Theme.make("BillboardGui", {
		Size = UDim2.fromOffset(200, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		StudsOffset = Vector3.new(0, 0.6, 0),
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 90,
		Parent = p,
	})
	-- a grey message bubble with the author on top
	local bubble = Theme.make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(233, 233, 235), Parent = gui }, {
		Theme.corner(14),
		Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8) }),
		Theme.make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.make("TextLabel", { Text = tostring(n.author or "Someone"), FontFace = Theme.Heading, TextSize = 13,
		TextColor3 = Color3.fromRGB(110, 110, 118), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 15),
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = bubble })
	Theme.make("TextLabel", { Text = text, FontFace = Theme.Body, TextSize = 16, TextWrapped = true,
		TextColor3 = Color3.fromRGB(20, 20, 24), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2,
		Parent = bubble })
	notesShown[id] = p
end

local function refreshNotes(sceneId: string)
	local ok, res = Backend.notes(sceneId)
	if not ok or type(res) ~= "table" or type(res.notes) ~= "table" then
		return
	end
	local seen = {}
	for _, n in res.notes do
		if type(n) == "table" then
			showNote(n)
			seen[tostring(n.id or (tostring(n.author) .. tostring(n.text)))] = true
		end
	end
	for id, part in notesShown do
		if not seen[id] and not part:GetAttribute("Local") then
			part:Destroy()
			notesShown[id] = nil
		end
	end
end

local function onLeaveNote(player: Player, text: any)
	if type(text) ~= "string" then
		return
	end
	text = text:gsub("^%s+", ""):gsub("%s+$", ""):sub(1, NOTE_MAX)
	if text == "" then
		return
	end
	if os.clock() - (lastNoteAt[player] or -NOTE_COOLDOWN) < NOTE_COOLDOWN then
		World.toast("One note every few seconds", player)
		return
	end
	lastNoteAt[player] = os.clock()
	local sceneId = workspace:GetAttribute("SceneId")
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if type(sceneId) ~= "string" or sceneId == "" or not hrp or World.where(player) ~= "room" then
		World.toast("Walk into a room to leave a note", player)
		return
	end
	local clean = filter(text, player.UserId)
	if not clean then
		World.toast("Couldn't check that note, try again", player)
		return
	end
	local pos = (hrp.Position + Vector3.new(0, 2, 0)) / spm()
	local body = { author = string.sub(player.DisplayName, 1, 40), text = clean, x = pos.X, y = pos.Y, z = pos.Z }
	task.spawn(function()
		local ok, res = Backend.addNote(sceneId, body)
		if not ok then
			World.toast("Notes are offline", player)
			-- still show it here, so the player sees where it would be
			local localNote = table.clone(body)
			localNote.id = "local-" .. HttpService:GenerateGUID(false)
			filtered[localNote.id] = clean
			showNote(localNote)
			local part = notesShown[localNote.id]
			if part then
				part:SetAttribute("Local", true)
			end
			return
		end
		if type(res) == "table" and res.id then
			filtered[tostring(res.id)] = clean
		end
		refreshNotes(sceneId)
		World.toast("Note left · the headset can see it", player)
	end)
end

------------------------------------------------------------------ hunt

local function publishHunt()
	local rows = {}
	for p, set in hunt.found do
		if p.Parent then
			local n = 0
			for _ in set do
				n += 1
			end
			table.insert(rows, { name = p.DisplayName, found = n })
		end
	end
	table.sort(rows, function(a, b)
		return a.found > b.found
	end)
	workspace:SetAttribute("HuntJson", HttpService:JSONEncode({ total = #labels, rows = rows }))
end

function Extras.huntActive(): boolean
	return hunt.active
end

function Extras.endHunt(winner: Player?)
	if not hunt.active then
		return
	end
	hunt.active = false
	hunt.round += 1
	workspace:SetAttribute("RoundState", "ended")
	workspace:SetAttribute("RoundEndsAt", 0)
	World.Moment:FireAllClients({
		type = "winner",
		title = if winner then string.upper(winner.DisplayName) .. " FOUND THEM ALL" else "TIME'S UP",
		mvp = if winner then "Hunt · " .. #labels .. " labels" else "Nobody found every label",
	})
	local myRound = hunt.round
	task.delay(5, function()
		if hunt.round == myRound and not hunt.active then
			workspace:SetAttribute("RoundState", "idle")
		end
	end)
end

function Extras.startHunt(by: Player?): boolean
	if hunt.active then
		return false
	end
	if #labels == 0 then
		World.toast("No labels in this room yet", by)
		return false
	end
	local players = World.inRoom()
	if #players == 0 then
		World.toast("Nobody is in the room yet: press JOIN", by)
		return false
	end
	hunt.active = true
	hunt.round += 1
	hunt.found = {}
	for _, p in players do
		hunt.found[p] = {}
	end
	hunt.endsAt = workspace:GetServerTimeNow() + HUNT_SECONDS
	workspace:SetAttribute("RoundState", "hunt")
	workspace:SetAttribute("RoundEndsAt", hunt.endsAt)
	World.Moment:FireAllClients({ type = "countdown", seconds = 3, text = "HUNT: TOUCH EVERY LABEL" })
	publishHunt()
	return true
end

local function checkHunt()
	if not hunt.active then
		return
	end
	if workspace:GetServerTimeNow() >= hunt.endsAt then
		Extras.endHunt(nil)
		return
	end
	local sceneId = workspace:GetAttribute("SceneId")
	for _, p in World.inRoom() do
		hunt.found[p] = hunt.found[p] or {}
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			local set = hunt.found[p]
			for i, l in labels do
				local d = Vector3.new(hrp.Position.X - l.pos.X, 0, hrp.Position.Z - l.pos.Z).Magnitude
				if not set[i] and d <= HUNT_RADIUS then
					set[i] = true
					local n = 0
					for _ in set do
						n += 1
					end
					World.Moment:FireAllClients({ type = "found", userId = p.UserId, name = p.DisplayName,
						label = l.label, index = i, found = n, total = #labels })
					if type(sceneId) == "string" then
						Backend.sendEvent(sceneId, { type = "hunt", by = "rbx-" .. p.UserId, found = n,
							total = #labels, label = l.label, name = p.DisplayName })
					end
					publishHunt()
					if n >= #labels then
						Extras.endHunt(p)
						return
					end
				end
			end
		end
	end
end

------------------------------------------------------------------ loops

function Extras.start()
	LeaveNote.OnServerEvent:Connect(onLeaveNote)
	Players.PlayerRemoving:Connect(function(p)
		lastNoteAt[p] = nil
		hunt.found[p] = nil
	end)
	-- A new room: drop the old labels and notes and stop any hunt.
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		labels, labelsScene = {}, nil
		notesShown, filtered = {}, {}
		workspace:SetAttribute("LabelCount", 0)
		if hunt.active then
			hunt.active = false
			workspace:SetAttribute("RoundState", "idle")
		end
	end)
	-- Labels: every 15 s until a room has some, then every 60 s. Notes: every 2 s (Update 4).
	task.spawn(function()
		local nextLabels = 0
		while true do
			task.wait(2)
			local sceneId = workspace:GetAttribute("SceneId")
			if workspace:GetAttribute("Phase") == "room" and type(sceneId) == "string" and sceneId ~= "" then
				pcall(function()
					if os.clock() >= nextLabels or labelsScene ~= sceneId then
						local has = refreshLabels(sceneId)
						nextLabels = os.clock() + (if has then 60 else 15)
					end
					refreshNotes(sceneId)
				end)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local ok, err = pcall(checkHunt)
			if not ok then
				warn("[DejaView] hunt check:", err)
			end
		end
	end)
end

return Extras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Foosball</string>
          <string name="Source"><![CDATA[-- Foosball on the real table (team/shivin.md Update 5, item 2). Two teams, one per end of the table. Each team has a
-- defence rod and an attack rod; a player slides both rods together (◀ ▶ buttons, or Z / X) and KICKs (button or C).
-- The server runs the ball: it bounces off the side walls and off the little players, and a goal counts when it
-- crosses an end inside the goal mouth. First to 5. An empty end is played by a bot that tracks the ball.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local World = require(script.Parent.World)
local Theme = require(ReplicatedStorage.Shared.Theme)
local Stats = require(script.Parent.Stats)

local FoosInput = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("FoosInput") :: RemoteEvent

local Foosball = {}

local WIN_SCORE = 5
local SIDE_ZONE = 12
local BALL_R = 0.45
local MAN_HALF = 0.55 -- half width of a little player along X
local GOAL_HALF = 1.8
local SPEED = 14 -- studs/s after a hit
local KICK_SPEED = 24
local FRICTION = 0.35 -- speed lost per second, fraction
local ROD_SPEED = 14 -- studs/s a rod slides

-- Table frame: long axis along Z, team A defends -Z, team B defends +Z, top at y = 0.
local tableCf = CFrame.new()
local LEN, WID = 16, 9
local folder: Folder? = nil
local scoreLabel: TextLabel? = nil
local ballPart: BasePart? = nil
local conn: RBXScriptConnection? = nil

-- rods: { team, z, men = {x offsets}, offset, target, parts = {BasePart}, range }
local rods: { any } = {}
local teams: { [string]: Player? } = { A = nil, B = nil }
local input: { [string]: number } = { A = 0, B = 0 } -- -1 .. 1 slide direction
local kickAt: { [string]: number } = { A = 0, B = 0 }
local score = { A = 0, B = 0 }
local ball = { pos = Vector2.zero, vel = Vector2.zero } -- (x, z) on the table
local paused = true
local over = false
local botError: { [string]: number } = { A = 0, B = 0 } -- bots aim a little off, so they can be beaten
local botErrorAt = 0

local function other(s: string): string
	return if s == "A" then "B" else "A"
end

local function nameOf(s: string): string
	local p = teams[s]
	return if p then p.DisplayName else "Bot"
end

local function updateBoard()
	if scoreLabel then
		scoreLabel.Text = string.format("%s  %d  ·  %d  %s", nameOf("A"), score.A, score.B, nameOf("B"))
	end
end

local function sideOf(player: Player): string?
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil
	end
	local p = tableCf:PointToObjectSpace(hrp.Position)
	if math.abs(p.X) > WID / 2 + SIDE_ZONE then
		return nil
	end
	if p.Z < -LEN / 2 + 3 and p.Z > -LEN / 2 - SIDE_ZONE then
		return "A"
	elseif p.Z > LEN / 2 - 3 and p.Z < LEN / 2 + SIDE_ZONE then
		return "B"
	end
	return nil
end

local function world(x: number, y: number, z: number): CFrame
	return tableCf * CFrame.new(x, y, z)
end

local function drop(towards: string?)
	-- the ball comes in from the side at midfield, drifting a little towards one team
	local rng = Random.new()
	ball.pos = Vector2.new(0, 0)
	local dir = if towards == "A" then -1 elseif towards == "B" then 1 else (if rng:NextNumber() < 0.5 then -1 else 1)
	ball.vel = Vector2.new(rng:NextNumber(-4, 4), dir * 5)
	paused = false
end

local function goal(scorer: string)
	paused = true
	score[scorer] += 1
	updateBoard()
	World.toast("GOAL · " .. nameOf(scorer))
	print(string.format("[Foos] goal %s · %d-%d", nameOf(scorer), score.A, score.B))
	if score[scorer] >= WIN_SCORE then
		over = true
		local final = string.format("%d-%d", score.A, score.B)
		World.Moment:FireAllClients({ type = "winner", title = string.upper(nameOf(scorer)) .. " WINS FOOSBALL", mvp = final })
		local sceneId = workspace:GetAttribute("SceneId")
		Stats.win(teams[scorer], "foosball")
		if sceneId == "the-courts" then
			Stats.badge(teams[scorer], "court")
		end
		if type(sceneId) == "string" then
			Backend.sendEvent(sceneId, { type = "game", game = "foosball", winner = nameOf(scorer), score = final })
		end
		return
	end
	task.delay(1.5, function()
		if folder and not over then
			drop(scorer) -- the team that conceded gets the ball's drift
		end
	end)
end

local function step(dt: number)
	if not folder then
		return
	end
	-- rods: people slide with input; bots follow the ball (with a drifting aiming error, and kick when it's close)
	if os.clock() - botErrorAt > 1.2 then
		botErrorAt = os.clock()
		local rng = Random.new()
		botError = { A = rng:NextNumber(-1.4, 1.4), B = rng:NextNumber(-1.4, 1.4) }
		for _, t in { "A", "B" } do
			if not teams[t] and rng:NextNumber() < 0.5 then
				kickAt[t] = os.clock()
			end
		end
	end
	for _, rod in rods do
		local dir = input[rod.team]
		if not teams[rod.team] then
			-- bot: keep the nearest man under the ball
			local bestD = math.huge
			for _, mx in rod.men do
				local d = ball.pos.X + botError[rod.team] - (mx + rod.offset)
				if math.abs(d) < math.abs(bestD) then
					bestD = d
				end
			end
			dir = math.clamp(bestD * 0.8, -1, 1) * 0.75
		end
		rod.offset = math.clamp(rod.offset + dir * ROD_SPEED * dt, -rod.range, rod.range)
		for i, part in rod.parts do
			part.CFrame = world(rod.men[i] + rod.offset, 0.9, rod.z)
		end
		rod.bar.CFrame = world(rod.offset, 1.6, rod.z) * CFrame.Angles(0, 0, math.pi / 2)
	end
	if paused then
		return
	end
	-- ball
	local p, v = ball.pos, ball.vel
	v *= math.max(0, 1 - FRICTION * dt)
	if v.Magnitude < 2 then
		v = v.Unit * 2 -- never stall on the table
	end
	local np = p + v * dt
	-- side walls
	if math.abs(np.X) > WID / 2 - BALL_R then
		np = Vector2.new(math.sign(np.X) * (WID / 2 - BALL_R), np.Y)
		v = Vector2.new(-v.X, v.Y)
	end
	-- the little players: crossing a rod's line with a man there sends it back the other way
	for _, rod in rods do
		local crossed = (p.Y - rod.z) * (np.Y - rod.z) <= 0
		if crossed then
			for _, mx in rod.men do
				local manX = mx + rod.offset
				if math.abs(np.X - manX) <= MAN_HALF + BALL_R then
					-- a rod always plays towards the other team's goal
					local towards = if rod.team == "A" then 1 else -1
					local kicking = os.clock() - kickAt[rod.team] < 0.35
					local speed = if kicking then KICK_SPEED else SPEED
					local spin = (np.X - manX) / (MAN_HALF + BALL_R) -- off-centre hits angle away
					v = Vector2.new(spin * speed * 0.5, towards * speed)
					np = Vector2.new(np.X, rod.z + towards * (BALL_R + 0.1))
					break
				end
			end
		end
	end
	-- ends: a goal inside the mouth, otherwise a bounce
	if math.abs(np.Y) > LEN / 2 - BALL_R then
		if math.abs(np.X) <= GOAL_HALF then
			goal(if np.Y > 0 then "A" else "B")
			ball.pos = Vector2.zero
			if ballPart then
				ballPart.CFrame = world(0, BALL_R, 0)
			end
			return
		end
		np = Vector2.new(np.X, math.sign(np.Y) * (LEN / 2 - BALL_R))
		v = Vector2.new(v.X, -v.Y)
	end
	ball.pos, ball.vel = np, v
	if ballPart then
		ballPart.CFrame = world(np.X, BALL_R, np.Y)
	end
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, transparency: number?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanTouch, p.CanCollide = true, false, true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

function Foosball.remove()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if folder then
		folder:Destroy()
	end
	folder, scoreLabel, ballPart, rods = nil, nil, nil, {}
	workspace:SetAttribute("FoosActive", false)
end

-- centre: table top centre; yaw: long axis direction (team A at the back). visible=false: the real table is the world's.
local lastPlace: any = nil

-- Rematch: the same game again in the same spot (Update 6 item 1).
function Foosball.isActive(): boolean
	return lastPlace ~= nil and workspace:FindFirstChild("Room") ~= nil and workspace.Room:FindFirstChild("Foosball") ~= nil
end

function Foosball.rematch()
	if lastPlace then
		Foosball.place(table.unpack(lastPlace, 1, lastPlace.n))
	end
end

function Foosball.place(centre: Vector3, yaw: number, length: number?, width: number?, visible: boolean?)
	lastPlace = table.pack(centre, yaw, length, width, visible)
	Foosball.remove()
	local room = workspace:FindFirstChild("Room")
	if not room then
		return
	end
	LEN, WID = length or 16, width or 9
	tableCf = CFrame.new(centre) * CFrame.Angles(0, yaw, 0)
	local f = Instance.new("Folder")
	f.Name = "Foosball"
	f.Parent = room
	folder = f
	local green, wood = Color3.fromRGB(46, 120, 70), Color3.fromRGB(120, 84, 52)
	if visible ~= false then
		part(f, "Pitch", Vector3.new(WID, 0.3, LEN), world(0, -0.15, 0), green)
		for _, sx in { -1, 1 } do
			part(f, "Side", Vector3.new(0.4, 1.4, LEN), world(sx * (WID / 2 + 0.2), 0.5, 0), wood)
		end
		for _, sz in { -1, 1 } do
			-- end walls with the goal mouth left open
			local w = (WID - GOAL_HALF * 2) / 2
			for _, sx in { -1, 1 } do
				part(f, "End", Vector3.new(w, 1.4, 0.4), world(sx * (GOAL_HALF + w / 2), 0.5, sz * (LEN / 2 + 0.2)), wood)
			end
		end
		for _, x in { -WID / 2 + 0.5, WID / 2 - 0.5 } do
			for _, z in { -LEN / 2 + 0.5, LEN / 2 - 0.5 } do
				part(f, "Leg", Vector3.new(0.5, 2.8, 0.5), world(x, -1.6, z), wood)
			end
		end
	end
	part(f, "Line", Vector3.new(WID, 0.02, 0.12), world(0, 0.02, 0), Color3.new(1, 1, 1))
	-- rods: defence near each team's own goal, attack in the other half (interleaved like a real table)
	rods = {}
	local layout = {
		{ team = "A", z = -LEN * 0.32, men = { -2.4, 0, 2.4 } },
		{ team = "B", z = -LEN * 0.12, men = { -2.6, 0, 2.6 } },
		{ team = "A", z = LEN * 0.12, men = { -2.6, 0, 2.6 } },
		{ team = "B", z = LEN * 0.32, men = { -2.4, 0, 2.4 } },
	}
	for _, def in layout do
		local rod = { team = def.team, z = def.z, men = def.men, offset = 0, parts = {}, range = WID / 2 - 2.9 - MAN_HALF }
		local colour = if def.team == "A" then Theme.Accent else Color3.fromRGB(255, 77, 109)
		rod.bar = part(f, "Rod", Vector3.new(WID + 3, 0.18, 0.18), world(0, 1.6, def.z), Color3.fromRGB(200, 200, 205))
		rod.bar.Shape = Enum.PartType.Cylinder
		rod.bar.CanCollide = false
		for _, mx in def.men do
			local man = part(f, "Man", Vector3.new(MAN_HALF * 2, 1.6, 0.5), world(mx, 0.9, def.z), colour)
			man.CanCollide = false
			table.insert(rod.parts, man)
		end
		table.insert(rods, rod)
	end
	local b = part(f, "Ball", Vector3.new(BALL_R * 2, BALL_R * 2, BALL_R * 2), world(0, BALL_R, 0), Color3.new(1, 1, 1))
	b.Shape = Enum.PartType.Ball
	b.CanCollide = false
	ballPart = b
	-- scoreboard
	local sign = part(f, "Score", Vector3.one, world(0, 5, 0), Color3.new(), 1)
	sign.CanCollide, sign.CanQuery = false, false
	local gui = Theme.make("BillboardGui", { Size = UDim2.fromOffset(340, 64), AlwaysOnTop = true, LightInfluence = 0,
		MaxDistance = 200, Parent = sign })
	local card = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.08,
		Parent = gui }, { Theme.corner(14), Theme.stroke(Theme.Accent, 1.5) })
	scoreLabel = Theme.label({ Text = "", FontFace = Theme.Heading, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), MaxText = 26, Parent = card })
	teams, input, score, over, paused = { A = nil, B = nil }, { A = 0, B = 0 }, { A = 0, B = 0 }, false, true
	ball.pos, ball.vel = Vector2.zero, Vector2.zero
	updateBoard()
	workspace:SetAttribute("FoosActive", true)
	World.toast("Foosball: stand at an end, slide with ◀ ▶ (Z / X), KICK (C)")
	conn = RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, math.min(dt, 0.05))
		if not ok then
			warn("[DejaView] foosball:", err)
		end
	end)
	task.delay(2, function()
		if folder and not over then
			drop(nil)
		end
	end)
end

local function placeFromFeature(ft: any): boolean
	if type(ft) ~= "table" or type(ft.corners) ~= "table" or #ft.corners < 4 then
		return false
	end
	local c = {}
	for i = 1, 4 do
		local v = ft.corners[i]
		c[i] = Vector3.new(v[1] or v.x, v[2] or v.y, v[3] or v.z)
	end
	local centre = (c[1] + c[2] + c[3] + c[4]) / 4
	local e1, e2 = c[2] - c[1], c[3] - c[2]
	local long, short = if e1.Magnitude >= e2.Magnitude then e1 else e2, if e1.Magnitude >= e2.Magnitude then e2 else e1
	Foosball.place(centre, math.atan2(-long.X, -long.Z), long.Magnitude, short.Magnitude, false)
	return true
end

function Foosball.placeForRoom(host: Player?, features: any?, cameraLook: Vector3?)
	if features and placeFromFeature(features.foosballTable) then
		return
	end
	local sceneId = workspace:GetAttribute("SceneId")
	local tuned = type(sceneId) == "string" and Config.FOOSBALL_TABLES[sceneId]
	if tuned then
		Foosball.place(Vector3.new(tuned.centre[1], tuned.centre[2], tuned.centre[3]), tuned.yaw or 0, tuned.length,
			tuned.width, tuned.visible)
		return
	end
	local hrp = host and host.Character and host.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		World.toast("Walk into the room first", host)
		return
	end
	local dir = if typeof(cameraLook) == "Vector3" then cameraLook else hrp.CFrame.LookVector
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local look = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
	local hum = (hrp.Parent :: Model):FindFirstChildOfClass("Humanoid")
	local floorY = hrp.Position.Y - ((hum and hum.HipHeight or 2) + hrp.Size.Y / 2)
	local centre = Vector3.new(hrp.Position.X, floorY + 3, hrp.Position.Z) + look * (5 + 8)
	Foosball.place(centre, math.atan2(look.X, look.Z), 16, 9, true)
end

local function onInput(player: Player, kind: any, value: any)
	if not folder or over then
		return
	end
	local side = sideOf(player)
	if not side then
		return
	end
	if not teams[side] and teams[other(side)] ~= player then
		teams[side] = player
		World.toast(player.DisplayName .. " takes the " .. (if side == "A" then "near" else "far") .. " end")
		updateBoard()
	end
	if teams[side] ~= player then
		return
	end
	if kind == "slide" and type(value) == "number" then
		-- ▶ means "to my right": team A looks along +Z, so its right is -X; team B looks along -Z (right is +X)
		local v = math.clamp(value, -1, 1)
		input[side] = if side == "A" then -v else v
	elseif kind == "kick" then
		kickAt[side] = os.clock()
	end
end

function Foosball.start()
	FoosInput.OnServerEvent:Connect(onInput)
	Players.PlayerRemoving:Connect(function(p)
		for s, q in teams do
			if q == p then
				teams[s] = nil
				input[s] = 0
			end
		end
		updateBoard()
	end)
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		folder, scoreLabel, ballPart, rods = nil, nil, nil, {}
		workspace:SetAttribute("FoosActive", false)
	end)
end

return Foosball
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Map JSON -> anchored Parts in batches, with progress, teardown, invisible bounds and baked fallback.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(script.Parent.Config)

local MapBuilder = {}

export type RoomInfo = {
	sceneId: string,
	name: string,
	spawn: Vector3,
	spawnYaw: number?,
	walkMin: Vector3?, -- the walkable box (invisible walls go here); defaults to the bounds
	walkMax: Vector3?,
	boundsMin: Vector3,
	boundsMax: Vector3,
	ceilingY: number,
	studsPerMeter: number,
	count: number,
}

local generation = 0
MapBuilder.current = nil :: RoomInfo?

local template = Instance.new("Part")
template.Anchored = true
template.Material = Enum.Material.SmoothPlastic
template.TopSurface = Enum.SurfaceType.Smooth
template.BottomSurface = Enum.SurfaceType.Smooth
template.CanTouch = false

local function invisible(parent: Instance, name: string, size: Vector3, pos: Vector3): Part
	local p = template:Clone()
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(pos)
	p.Transparency = 1
	p.CastShadow = false
	p.CanQuery = false
	p.Parent = parent
	return p
end

-- Textured rooms are shown unlit (shivin.md Update 10): their textures already hold the light of the photos, so
-- Roblox must not shade them again. The lighting as it was is kept and put back for block rooms and the lobby.
local UNLIT = {
	GlobalShadows = false,
	Ambient = Color3.fromRGB(255, 255, 255),
	OutdoorAmbient = Color3.fromRGB(255, 255, 255),
	Brightness = 0,
	EnvironmentDiffuseScale = 0,
	EnvironmentSpecularScale = 0,
	ExposureCompensation = 0,
}
local savedLighting: { [string]: any }? = nil
local parkedEffects: { [Instance]: any } = {}

function MapBuilder.setUnlit(on: boolean)
	if on == (savedLighting ~= nil) then
		return
	end
	local L: any = Lighting
	if on then
		local saved = {}
		for k, v in UNLIT do
			saved[k] = L[k]
			L[k] = v
		end
		savedLighting = saved
		-- no Atmosphere, Bloom, ColorCorrection, SunRays or blur while a textured room is up
		for _, e in Lighting:GetChildren() do
			if e:IsA("PostEffect") then
				parkedEffects[e] = e.Enabled
				e.Enabled = false
			elseif e:IsA("Atmosphere") then
				parkedEffects[e] = e.Density
				e.Density = 0
			end
		end
	else
		for k, v in savedLighting :: { [string]: any } do
			L[k] = v
		end
		savedLighting = nil
		for e, v in parkedEffects do
			if e.Parent and e:IsA("PostEffect") then
				e.Enabled = v
			elseif e.Parent and e:IsA("Atmosphere") then
				e.Density = v
			end
		end
		parkedEffects = {}
	end
end

-- Every room has a floor: an invisible slab whose top is exactly y = 0 (the map frame's floor) under the walk box,
-- so nobody falls through a gap in the blocks or the model. The safety floor sits well below it and only catches
-- someone who slips through anyway (the fall guard then puts them back at spawn).
local FLOOR_THICK = 2
local FLOOR_MARGIN = 4
local SAFETY_TOP = -8

local function boundsOf(map: any): (Vector3, Vector3, number)
	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = -minV
	for _, p in map.parts do
		local half = Vector3.new(p[4], p[5], p[6]) / 2
		local c = Vector3.new(p[1], p[2], p[3])
		minV = minV:Min(c - half)
		maxV = maxV:Max(c + half)
	end
	if #map.parts == 0 then
		minV, maxV = Vector3.new(-10, 0, -10), Vector3.new(10, 10, 10)
	end
	local b = map.bounds
	if type(b) == "table" then
		-- accept {min=[...], max=[...]} or [[min],[max]]
		local bmin, bmax = b.min or b[1], b.max or b[2]
		if type(bmin) == "table" and type(bmax) == "table" then
			minV = Vector3.new(bmin[1] or bmin.x, bmin[2] or bmin.y, bmin[3] or bmin.z)
			maxV = Vector3.new(bmax[1] or bmax.x, bmax[2] or bmax.y, bmax[3] or bmax.z)
		end
	end
	local ceilingY = if type(map.ceilingY) == "number" then map.ceilingY else maxV.Y
	return minV, maxV, ceilingY
end

local function parseBox(b: any): (Vector3?, Vector3?)
	if type(b) ~= "table" then
		return nil, nil
	end
	local bmin, bmax = b.min or b[1], b.max or b[2]
	if type(bmin) ~= "table" or type(bmax) ~= "table" then
		return nil, nil
	end
	return Vector3.new(bmin[1] or bmin.x, bmin[2] or bmin.y, bmin[3] or bmin.z),
		Vector3.new(bmax[1] or bmax.x, bmax[2] or bmax.y, bmax[3] or bmax.z)
end

-- The walkable box: the server's walkBounds when it sends them (Update 4); otherwise the area the camera actually
-- captured (parts flagged 0 = captured, not imagined), widened to take in the spawn and the headset's start at the
-- origin, plus a small margin; otherwise the whole bounds.
local WALK_MARGIN = 4

local function walkBoxOf(map: any, mn: Vector3, mx: Vector3): (Vector3, Vector3)
	local wmin, wmax = parseBox(map.walkBounds)
	if wmin and wmax then
		return Vector3.new(wmin.X, mn.Y, wmin.Z), Vector3.new(wmax.X, mx.Y, wmax.Z)
	end
	local x0, z0, x1, z1 = math.huge, math.huge, -math.huge, -math.huge
	for _, p in map.parts do
		if p[10] == 0 then
			x0, x1 = math.min(x0, p[1] - p[4] / 2), math.max(x1, p[1] + p[4] / 2)
			z0, z1 = math.min(z0, p[3] - p[6] / 2), math.max(z1, p[3] + p[6] / 2)
		end
	end
	if not (x0 < x1 and z0 < z1) then
		return mn, mx
	end
	local sp = map.spawn or { 0, 0, 0 }
	for _, pt in { { sp[1] or 0, sp[3] or 0 }, { 0, 0 } } do
		x0, x1 = math.min(x0, pt[1]), math.max(x1, pt[1])
		z0, z1 = math.min(z0, pt[2]), math.max(z1, pt[2])
	end
	x0, z0 = math.max(x0 - WALK_MARGIN, mn.X), math.max(z0 - WALK_MARGIN, mn.Z)
	x1, z1 = math.min(x1 + WALK_MARGIN, mx.X), math.min(z1 + WALK_MARGIN, mx.Z)
	return Vector3.new(x0, mn.Y, z0), Vector3.new(x1, mx.Y, z1)
end

local function newFolder(info: RoomInfo): Folder
	local old = workspace:FindFirstChild("Room")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Room"
	folder:SetAttribute("SceneId", info.sceneId)
	folder:SetAttribute("RoomName", info.name)
	folder:SetAttribute("Spawn", info.spawn)
	folder:SetAttribute("BoundsMin", info.boundsMin)
	folder:SetAttribute("BoundsMax", info.boundsMax)
	folder:SetAttribute("CeilingY", info.ceilingY)
	folder:SetAttribute("WalkMin", info.walkMin)
	folder:SetAttribute("WalkMax", info.walkMax)
	folder:SetAttribute("StudsPerMeter", info.studsPerMeter)
	folder:SetAttribute("Count", info.count)
	folder.Parent = workspace
	return folder
end

local function addBounds(folder: Folder, info: RoomInfo)
	local bounds = Instance.new("Folder")
	bounds.Name = "Bounds"
	local mn, mx = info.boundsMin, info.boundsMax
	local size = mx - mn
	local c = (mn + mx) / 2
	local h = math.max(info.ceilingY - mn.Y, 8) + 4
	local midY = mn.Y + h / 2
	local wmn, wmx = info.walkMin or mn, info.walkMax or mx
	-- the floor: top exactly at y = 0, under the walk box (the whole bounds without one) and the spawn, plus a margin
	local fx0 = math.min(wmn.X, info.spawn.X) - FLOOR_MARGIN
	local fz0 = math.min(wmn.Z, info.spawn.Z) - FLOOR_MARGIN
	local fx1 = math.max(wmx.X, info.spawn.X) + FLOOR_MARGIN
	local fz1 = math.max(wmx.Z, info.spawn.Z) + FLOOR_MARGIN
	local floor = invisible(bounds, "Floor", Vector3.new(fx1 - fx0, FLOOR_THICK, fz1 - fz0),
		Vector3.new((fx0 + fx1) / 2, -FLOOR_THICK / 2, (fz0 + fz1) / 2))
	floor.CanCollide = true
	floor.CanQuery = true -- the spawn raycast lands on it
	-- safety floor well under everything
	local safetyTop = math.min(SAFETY_TOP, mn.Y - 4)
	invisible(bounds, "SafetyFloor", Vector3.new(size.X + 8, 2, size.Z + 8), Vector3.new(c.X, safetyTop - 1, c.Z))
	-- Invisible walls around the walkable box (Update 4), tight to its edge.
	local wsize, wc = wmx - wmn, (wmn + wmx) / 2
	invisible(bounds, "WallN", Vector3.new(wsize.X + 2, h, 1), Vector3.new(wc.X, midY, wmn.Z - 0.5))
	invisible(bounds, "WallS", Vector3.new(wsize.X + 2, h, 1), Vector3.new(wc.X, midY, wmx.Z + 0.5))
	invisible(bounds, "WallW", Vector3.new(1, h, wsize.Z + 2), Vector3.new(wmn.X - 0.5, midY, wc.Z))
	invisible(bounds, "WallE", Vector3.new(1, h, wsize.Z + 2), Vector3.new(wmx.X + 0.5, midY, wc.Z))
	invisible(bounds, "Lid", Vector3.new(size.X + 8, 1, size.Z + 8), Vector3.new(c.X, info.ceilingY + 0.5, c.Z))
	bounds.Parent = folder
end

function MapBuilder.infoFromMap(map: any): RoomInfo
	local mn, mx, ceilingY = boundsOf(map)
	local wmin, wmax = walkBoxOf(map, mn, mx)
	local s = map.spawn or { 0, 0, 0 }
	return {
		sceneId = map.sceneId or "?",
		name = map.name or map.sceneId or "Room",
		spawn = Vector3.new(s[1] or s.x or 0, s[2] or s.y or 0, s[3] or s.z or 0),
		spawnYaw = tonumber(map.spawnYaw),
		walkMin = wmin,
		walkMax = wmax,
		boundsMin = mn,
		boundsMax = mx,
		ceilingY = ceilingY,
		studsPerMeter = map.studsPerMeter or 3.57,
		count = #map.parts,
	}
end

-- Builds the map; onProgress(built, total). Returns info, or nil if cancelled by a newer build.
-- opts.collisionOnly: the blocks are invisible collision under a textured room model (shivin.md Update 2).
function MapBuilder.build(map: any, onProgress: ((number, number) -> ())?, opts: { collisionOnly: boolean? }?): RoomInfo?
	local collisionOnly = opts ~= nil and opts.collisionOnly == true
	generation += 1
	local myGen = generation
	local t0 = os.clock()
	local info = MapBuilder.infoFromMap(map)
	MapBuilder.current = nil
	if not collisionOnly then
		MapBuilder.setUnlit(false) -- a block room: normal lighting (a textured one goes unlit in attachModel)
	end
	local folder = newFolder(info)
	local parts = map.parts
	local total = #parts
	local batch = Config.BATCH
	local hasImagined = false
	for i, p in parts do
		local part = template:Clone()
		local sx, sy, sz = p[4], p[5], p[6]
		part.Size = Vector3.new(sx, sy, sz)
		part.CFrame = CFrame.new(p[1], p[2], p[3])
		part.Color = Color3.fromRGB(p[7], p[8], p[9])
		part.CastShadow = math.min(sx, sy, sz) >= 1 and not collisionOnly
		part.CanCollide = math.max(sx, sy, sz) >= 0.6
		if collisionOnly then
			part.Transparency = 1
			part.CanQuery = math.max(sx, sy, sz) >= 0.6 -- spawn raycasts still find the floor
		elseif p[10] == 1 then
			hasImagined = true
			CollectionService:AddTag(part, "DVImagined")
		end
		part.Parent = folder
		if i % batch == 0 then
			if onProgress then
				onProgress(i, total)
			end
			task.wait()
			if generation ~= myGen then
				return nil
			end
			if i == batch then
				addBounds(folder, info)
			end
		end
	end
	if not folder:FindFirstChild("Bounds") then
		addBounds(folder, info)
	end
	folder:SetAttribute("HasImagined", hasImagined)
	if onProgress then
		onProgress(total, total)
	end
	print(string.format("[DejaView] built %s: %d parts in %.2fs (batch %d)", info.sceneId, total, os.clock() - t0, batch))
	MapBuilder.current = info
	return info
end

local function prepareModel(model: Instance, meshCollision: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanTouch = false
			d.CanCollide = meshCollision
			d.CanQuery = meshCollision
			-- Baked textures already hold the photo's light: no extra shading on top (Update 10)
			d.Material = Enum.Material.SmoothPlastic
			d.Reflectance = 0
			d.CastShadow = false
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy() -- an imported or uploaded room must never run code
		end
	end
end

-- A loaded room as a Model (ScaleTo and PivotTo need one): a Folder's children move into a new Model; anything else
-- (a lone MeshPart) goes into it as it is.
local function asModel(container: Instance): Model
	if container:IsA("Model") then
		return container :: Model
	end
	local m = Instance.new("Model")
	m.Name = container.Name
	for k, v in container:GetAttributes() do
		m:SetAttribute(k, v)
	end
	if container:IsA("Folder") then
		for _, c in container:GetChildren() do
			c.Parent = m
		end
		container:Destroy()
	else
		container.Parent = m
	end
	return m
end

-- The world box of every BasePart in a model: the corners of CFrame * Size / 2 (GetBoundingBox is oriented).
local function partsBox(model: Instance): (Vector3?, Vector3?)
	local mn = Vector3.new(math.huge, math.huge, math.huge)
	local mx = -mn
	local any = false
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local cf, half = d.CFrame, d.Size / 2
			for i = 0, 7 do
				local corner = cf * Vector3.new(
					if i % 2 == 0 then -half.X else half.X,
					if i % 4 < 2 then -half.Y else half.Y,
					if i < 4 then -half.Z else half.Z
				)
				mn = mn:Min(corner)
				mx = mx:Max(corner)
			end
			any = true
		end
	end
	if not any then
		return nil, nil
	end
	return mn, mx
end

-- How far off a loaded model may be before it is turned, scaled or moved. Against the server's own box for that model
-- (exact) any scale error over 2 % is fixed, a turn is taken when the swapped extents fit and the unswapped ones
-- clearly do not (a nearly square room differs by only a few percent), and the box always lands on it. Against the
-- block map's bounds (loose: a room imported in Studio) only gross errors are fixed: a wrong unit (3.57x), which
-- scales x, y and z alike, or a model left outside the map. A model may cover much less ground than the map (newer
-- ones only cover the walk box), so a different size alone is no reason to scale or move it.
local EXACT_SCALE = 0.02
local EXACT_TURN = 0.02 -- the swapped extents agree this well
local EXACT_TURN_OFF = 0.04 -- and the unswapped ones are at least this far apart (and twice as far as the swapped)
local LOOSE_SCALE = 0.25
local LOOSE_AGREE = 0.15 -- the x, y and z ratios of a wrong unit agree this well
local LOOSE_TURN = 0.1
local LOOSE_OFFSET = 0.1 -- of the larger horizontal extent
local LOOSE_DROP = 2 -- studs

-- How far apart some ratios are: the largest over the smallest, minus 1.
local function spread(a: number, b: number, c: number?): number
	local cc = c or a
	return math.max(a, b, cc) / math.min(a, b, cc) - 1
end

-- Whether two boxes have the same proportions (x : y : z within 3 %), as two boxes of one model do; a quarter turn
-- about Y counts.
local function sameShape(a: Vector3, b: Vector3): boolean
	if a.X <= 0 or a.Y <= 0 or a.Z <= 0 or b.X <= 0 or b.Y <= 0 or b.Z <= 0 then
		return false
	end
	return spread(a.X / b.X, a.Y / b.Y, a.Z / b.Z) < 0.03 or spread(a.X / b.Z, a.Y / b.Y, a.Z / b.X) < 0.03
end

-- Turns, scales and moves `model` so its world box matches emin..emax: centres on x and z, bottoms on y. A quarter
-- turn about Y when its x and z extents are swapped; one uniform scale (the mean of the x and z ratios); then a
-- move. Prints what it did. The collision blocks never move: they are the ground truth.
local function alignModel(model: Model, emin: Vector3, emax: Vector3, loose: boolean)
	local amin, amax = partsBox(model)
	if not amin or not amax then
		return
	end
	local esize, asize = emax - emin, amax - amin
	if esize.X <= 0 or esize.Z <= 0 or asize.X <= 0 or asize.Z <= 0 then
		return
	end
	-- the y ratio (a turn about Y keeps it); nil when either box is flat
	local ry = if esize.Y > 0 and asize.Y > 0 then esize.Y / asize.Y else nil
	-- swapped: the x and z ratios agree against the other axis, not against their own (loose: y agrees as well)
	local turned = 0
	local own = spread(asize.X / esize.X, asize.Z / esize.Z)
	local swapped = spread(asize.X / esize.Z, asize.Z / esize.X)
	local turn = if loose
		then ry ~= nil and own >= LOOSE_TURN and spread(esize.Z / asize.X, esize.X / asize.Z, ry) < LOOSE_TURN
		else swapped < EXACT_TURN and own > math.max(EXACT_TURN_OFF, 2 * swapped)
	if turn then
		local centre = (amin + amax) / 2
		model:PivotTo(CFrame.new(centre) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.new(-centre) * model:GetPivot())
		turned = 90
		amin, amax = partsBox(model)
		if not amin or not amax then
			return
		end
		asize = amax - amin
	end
	local rx, rz = esize.X / asize.X, esize.Z / asize.Z
	local factor = (rx + rz) / 2
	local scaled = 1
	local rescale = math.abs(factor - 1) > (if loose then LOOSE_SCALE else EXACT_SCALE)
	if rescale and loose then
		rescale = ry ~= nil and spread(rx, rz, ry) < LOOSE_AGREE
	end
	if rescale then
		local ok, err = pcall(function()
			model:ScaleTo(model:GetScale() * factor)
		end)
		if ok then
			scaled = factor
			amin, amax = partsBox(model)
			if not amin or not amax then
				return
			end
		else
			warn("[DejaView] could not scale the room model:", err)
		end
	end
	local ac, ec = (amin + amax) / 2, (emin + emax) / 2
	local delta = Vector3.new(ec.X - ac.X, emin.Y - amin.Y, ec.Z - ac.Z)
	if loose and scaled == 1 and turned == 0 then
		local tol = LOOSE_OFFSET * math.max(esize.X, esize.Z)
		local inside = amin.X >= emin.X - tol and amax.X <= emax.X + tol and amin.Z >= emin.Z - tol and amax.Z <= emax.Z + tol
		if inside and math.abs(delta.Y) < LOOSE_DROP then
			delta = Vector3.zero -- within the block map and on its floor: it is in the map frame already
		end
	end
	if delta.Magnitude > 0.001 then
		model:PivotTo(model:GetPivot() + delta)
	end
	print(string.format("[DejaView] room model aligned on the %s: scale x%.3f, turned %d deg, offset (%.2f, %.2f, %.2f)",
		if loose then "block map" else "model box", scaled, turned, delta.X, delta.Y, delta.Z))
end

-- Lines one part of a multi-part room model up on the server's box for that part ({min, max} in studs), so a part
-- that loads somewhere of its own still joins the others.
function MapBuilder.alignPart(model: Model, box: any?)
	local emin, emax = parseBox(box)
	if emin and emax then
		alignModel(model, emin, emax, false)
	end
end

-- The server's box for a model ({min, max} in studs) to align it on exactly, or nil. With `checkShape` (a room
-- imported in Studio, which may be another build than the one the server describes) only when the model has the
-- box's proportions.
local function serverBox(model: Model, box: any?, checkShape: boolean?): (Vector3?, Vector3?)
	local emin, emax = parseBox(box)
	if not emin or not emax then
		return nil, nil
	end
	if checkShape then
		local amin, amax = partsBox(model)
		if not amin or not amax or not sameShape(amax - amin, emax - emin) then
			return nil, nil
		end
	end
	return emin, emax
end

-- Puts a textured room model into the current Workspace.Room (over invisible collision blocks), turned, scaled and
-- moved onto `box` ({min, max} in studs): the server's own box for the model it loaded, else the block map's bounds
-- (loose). `checkShape`: see serverBox. Returns the model as placed.
function MapBuilder.attachModel(container: Instance, box: any?, checkShape: boolean?): Model?
	local room = workspace:FindFirstChild("Room")
	if not room then
		container:Destroy()
		return nil
	end
	local model = asModel(container)
	prepareModel(model, false)
	local emin, emax = serverBox(model, box, checkShape)
	local loose = false
	if not emin or not emax then
		local info = MapBuilder.current
		if info then
			emin, emax, loose = info.boundsMin, info.boundsMax, true
		end
	end
	if emin and emax then
		alignModel(model, emin, emax, loose)
	end
	model.Name = "RoomModel"
	model.Parent = room
	room:SetAttribute("HasModel", true)
	MapBuilder.setUnlit(true)
	return model
end

-- A textured room with no block map (map fetch failed): the meshes are the collision. `frame` is the server's model
-- details (walkBounds, spawn, spawnYaw); `box` the server's own box for this model, to align it on, when known
-- (`checkShape`: see serverBox).
function MapBuilder.buildFromModel(sceneId: string, name: string, container: Instance, frame: any?, box: any?,
	checkShape: boolean?): RoomInfo?
	generation += 1
	local model = asModel(container)
	prepareModel(model, true)
	local emin, emax = serverBox(model, box, checkShape)
	if emin and emax then
		alignModel(model, emin, emax, false)
	end
	local mn, mx = partsBox(model)
	if not mn or not mx then
		mn, mx = Vector3.new(-15, 0, -15), Vector3.new(15, 10, 15)
	end
	local f = if type(frame) == "table" then frame else {}
	local spawnAttr = model:GetAttribute("Spawn")
	local fs = f.spawn
	local spawn = if typeof(spawnAttr) == "Vector3"
		then spawnAttr
		elseif type(fs) == "table" and tonumber(fs[1]) and tonumber(fs[3])
		then Vector3.new(tonumber(fs[1]) :: number, tonumber(fs[2]) or 0, tonumber(fs[3]) :: number)
		else Vector3.new((mn.X + mx.X) / 2, if emin then 0 else mn.Y, (mn.Z + mx.Z) / 2)
	local wmin, wmax = parseBox(f.walkBounds)
	local info: RoomInfo = {
		sceneId = sceneId,
		name = name,
		spawn = spawn,
		spawnYaw = tonumber(f.spawnYaw),
		walkMin = if wmin then Vector3.new(wmin.X, mn.Y, wmin.Z) else nil,
		walkMax = if wmax then Vector3.new(wmax.X, mx.Y, wmax.Z) else nil,
		boundsMin = mn,
		boundsMax = mx,
		ceilingY = mx.Y,
		studsPerMeter = model:GetAttribute("StudsPerMeter") or tonumber(f.studsPerMeter) or 3.57,
		count = #model:GetDescendants(),
	}
	local folder = newFolder(info)
	model.Name = "RoomModel"
	model.Parent = folder
	folder:SetAttribute("HasModel", true)
	addBounds(folder, info)
	MapBuilder.setUnlit(true)
	MapBuilder.current = info
	print("[DejaView] loaded room model for", sceneId, "(no block map)")
	return info
end

-- No room (everyone back in the lobby): removes Workspace.Room and puts the normal lighting back.
function MapBuilder.clear()
	generation += 1
	local old = workspace:FindFirstChild("Room")
	if old then
		old:Destroy()
	end
	MapBuilder.current = nil
	MapBuilder.setUnlit(false)
end

function MapBuilder.hasBaked(sceneId: string): boolean
	local baked = ServerStorage:FindFirstChild("BakedRooms")
	return baked ~= nil and baked:FindFirstChild(sceneId) ~= nil
end

-- Clones ServerStorage.BakedRooms[sceneId] (a copy of a built Workspace.Room) into Workspace.
function MapBuilder.buildBaked(sceneId: string): RoomInfo?
	local baked = ServerStorage:FindFirstChild("BakedRooms")
	local src = baked and baked:FindFirstChild(sceneId)
	if not src then
		return nil
	end
	generation += 1
	local old = workspace:FindFirstChild("Room")
	if old then
		old:Destroy()
	end
	local folder = src:Clone()
	folder.Name = "Room"
	folder.Parent = workspace
	local info: RoomInfo = {
		sceneId = sceneId,
		name = folder:GetAttribute("RoomName") or sceneId,
		spawn = folder:GetAttribute("Spawn") or Vector3.zero,
		boundsMin = folder:GetAttribute("BoundsMin") or Vector3.new(-15, 0, -15),
		boundsMax = folder:GetAttribute("BoundsMax") or Vector3.new(15, 10, 15),
		ceilingY = folder:GetAttribute("CeilingY") or 10,
		studsPerMeter = folder:GetAttribute("StudsPerMeter") or 3.57,
		count = folder:GetAttribute("Count") or #folder:GetChildren(),
	}
	MapBuilder.setUnlit(folder:GetAttribute("HasModel") == true)
	print("[DejaView] loaded baked room", sceneId)
	MapBuilder.current = info
	return info
end

local OFFSETS = { Vector2.new(0, 0), Vector2.new(3, 0), Vector2.new(-3, 0), Vector2.new(0, 3), Vector2.new(0, -3),
	Vector2.new(3, 3), Vector2.new(-3, -3), Vector2.new(3, -3), Vector2.new(-3, 3) }

-- Places a character around spawn, on the floor, facing the room centre.
function MapBuilder.place(character: Model, index: number)
	local info = MapBuilder.current
	if not info then
		return
	end
	local off = OFFSETS[(index - 1) % #OFFSETS + 1]
	local x, z = info.spawn.X + off.X, info.spawn.Z + off.Y
	local floorY = info.spawn.Y
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local room = workspace:FindFirstChild("Room")
	if room then
		params.FilterDescendantsInstances = { room }
		local hit = workspace:Raycast(Vector3.new(x, floorY + 10, z), Vector3.new(0, -30, 0), params)
		if hit then
			floorY = hit.Position.Y
		end
	end
	-- Face the way the server says (spawnYaw: into the part of the world the camera saw), else the room centre.
	local centre = (info.boundsMin + info.boundsMax) / 2
	local dx, dz = centre.X - x, centre.Z - z
	local yaw = info.spawnYaw or (if math.abs(dx) + math.abs(dz) > 0.01 then math.atan2(-dx, -dz) else 0)
	character:PivotTo(CFrame.new(x, floorY + 3, z) * CFrame.Angles(0, yaw, 0))
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">MockServer</string>
          <string name="Source"><![CDATA[-- Fake Déjà View server with the same interface and shapes as Api (team/shivin.md 9.1):
-- fixture scenes, procedural rooms, a fake VR player, latency and failure injection.
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local Fixtures = require(ReplicatedStorage.Shared.Fixtures)

local MockServer = {}

local SPM = 3.57
local T0 = time() -- game time: restarts with every play-test
local FINALE_READY_AT = 30
local FINALE_MEASURING = 5
local JUDGE_MOVES_AT = 40

local lastScene: string? = nil

local function elapsed(): number
	return time() - T0
end

local function now(): number
	return DateTime.now().UnixTimestampMillis / 1000
end

-- Returns false when this call should "fail".
local function jitter(): boolean
	local lo, hi = Config.MOCK_LATENCY[1], Config.MOCK_LATENCY[2]
	task.wait(lo + math.random() * (hi - lo))
	return math.random() >= Config.MOCK_FAIL_RATE
end

local function scenes()
	local list = HttpService:JSONDecode(Fixtures.SCENES)
	for _, s in list do
		if s.id == "mock-finale" then
			local t = elapsed()
			if t >= FINALE_READY_AT then
				s.status, s.stage, s.progress = "ready", "Ready", 1
			else
				s.progress = 0.4 + 0.6 * t / FINALE_READY_AT
			end
		end
	end
	if Config.MOCK_STRESS_ROOMS then
		table.insert(list, { id = "mock-stress-6000", name = "Stress 6k", mode = "photo", status = "ready",
			stage = "Ready", progress = 1, createdAt = "2026-10-17T09:00:00Z" })
		table.insert(list, { id = "mock-stress-12000", name = "Stress 12k", mode = "photo", status = "ready",
			stage = "Ready", progress = 1, createdAt = "2026-10-17T08:00:00Z" })
	end
	-- newest first
	table.sort(list, function(a, b)
		return a.createdAt > b.createdAt
	end)
	return list
end

local function nameOf(id: string): string
	for _, s in scenes() do
		if s.id == id then
			return s.name
		end
	end
	return id
end

-- A floor, 4 walls with a window gap, a couch, a table, a TV and voxel noise up to `count` parts.
local function proceduralMap(id: string, count: number)
	local seed = 0
	for i = 1, #id do
		seed = (seed * 31 + id:byte(i)) % 2147483647
	end
	local rng = Random.new(seed)
	local W, D, H = 30, 26, 10.5
	local wall = { 214, 208, 196 }
	local tint = { rng:NextInteger(60, 200), rng:NextInteger(60, 200), rng:NextInteger(60, 200) }
	local parts = {
		{ 0, -0.5, 0, W, 1, D, 120, 104, 90 },
		{ 0, H / 2, -D / 2 - 0.5, W, H, 1, wall[1], wall[2], wall[3] },
		{ 0, H / 2, D / 2 + 0.5, W, H, 1, wall[1], wall[2], wall[3] },
		{ -W / 2 - 0.5, H / 2, 0, 1, H, D, 205, 199, 188 },
		-- right wall with a window gap
		{ W / 2 + 0.5, 1.75, 0, 1, 3.5, D, 205, 199, 188 },
		{ W / 2 + 0.5, H - 1.25, 0, 1, 2.5, D, 205, 199, 188 },
		{ W / 2 + 0.5, 5.25, -D / 2 + 3, 1, 4, 6, 205, 199, 188 },
		{ W / 2 + 0.5, 5.25, D / 2 - 3, 1, 4, 6, 205, 199, 188 },
		{ W / 2 + 0.5, 5.25, 0, 0.2, 4, D - 12, 170, 210, 255, 1 },
		-- couch
		{ -6, 1, -8, 10, 2, 4, tint[1], tint[2], tint[3] },
		{ -6, 2.6, -9.6, 10, 2.4, 1, tint[1], tint[2], tint[3] },
		-- table
		{ -6, 1.6, -2, 6, 0.4, 3, 150, 110, 70 },
		{ -6, 0.7, -2, 0.6, 1.4, 0.6, 90, 70, 50 },
		-- TV
		{ -6, 5, 12.4, 9, 5, 0.4, 20, 20, 24 },
		{ -6, 1.2, 12, 7, 2.4, 1.5, 60, 50, 45 },
	}
	while #parts < count do
		local sx, sy, sz = rng:NextNumber(0.4, 1.6), rng:NextNumber(0.4, 1.6), rng:NextNumber(0.4, 1.6)
		local onWall = rng:NextNumber() < 0.5
		local x, y, z
		if onWall then
			local side = rng:NextInteger(1, 2)
			x = rng:NextNumber(-W / 2, W / 2)
			z = if side == 1 then -D / 2 + sz / 2 else D / 2 - sz / 2
			y = rng:NextNumber(0, H)
		else
			x, z = rng:NextNumber(-W / 2, W / 2), rng:NextNumber(-D / 2, D / 2)
			y = sy / 2
		end
		local g = rng:NextInteger(90, 230)
		table.insert(parts, { x, y, z, sx, sy, sz, g, math.floor(g * 0.92), math.floor(g * 0.85),
			if rng:NextNumber() < 0.3 then 1 else 0 })
	end
	table.sort(parts, function(a, b)
		return a[2] - a[5] / 2 < b[2] - b[5] / 2
	end)
	return {
		sceneId = id,
		name = nameOf(id),
		studsPerMeter = SPM,
		spawn = { 0, 0, 6 },
		ceilingY = H,
		parts = parts,
	}
end

function MockServer.mockVr(t: number)
	local a = t * 0.6
	local x, z = math.cos(a) * 6, math.sin(a * 0.8) * 4.5
	local dx, dz = -math.sin(a) * 6, math.cos(a * 0.8) * 3.6
	local yaw = math.atan2(-dx, -dz)
	local side = Vector3.new(math.cos(yaw), 0, -math.sin(yaw)) * 1.4
	return {
		id = "quest-1", name = "Judge", kind = "vr", x = x, y = 0, z = z, yaw = yaw,
		head = { x, 5.7 + math.sin(t * 3) * 0.15, z },
		hands = { { x - side.X, 4.3 + math.sin(t * 5), z - side.Z }, { x + side.X, 4.3, z + side.Z } },
	}
end

local function judgeScene(): string?
	if elapsed() >= JUDGE_MOVES_AT then
		return "mock-finale"
	end
	return lastScene
end

function MockServer.scenes()
	if not jitter() then
		return false, "mock failure", 0
	end
	return true, scenes(), 200
end

function MockServer.map(sceneId: string, maxParts: number?)
	if not jitter() then
		return false, "mock failure", 0
	end
	if sceneId == "fixture-room" then
		return true, HttpService:JSONDecode(Fixtures.MAP_SMALL), 200
	end
	if sceneId == "mock-broken" then
		return false, { error = "Scene is not ready", status = "failed" }, 409
	end
	if sceneId == "mock-finale" then
		local t = elapsed()
		if t < FINALE_READY_AT then
			return false, { error = "Scene is not ready", status = "running" }, 409
		elseif t < FINALE_READY_AT + FINALE_MEASURING then
			return true, { status = "building", retryAfter = 2 }, 202
		end
	end
	local count = Config.MOCK_NOISE_PARTS
	local stress = tonumber(sceneId:match("^mock%-stress%-(%d+)$"))
	if stress then
		count = stress
	end
	count = math.min(count, maxParts or 12000)
	return true, proceduralMap(sceneId, count), 200
end

-- No uploaded models in mock mode: rooms come from ServerStorage.Rooms or blocks.
function MockServer.model(sceneId: string)
	if not jitter() then
		return false, "mock failure", 0
	end
	return true, { sceneId = sceneId, units = "studs", studsPerMeter = SPM, chunks = {}, assetId = nil }, 200
end

-- Fake Gemini labels around the procedural room (metres; the fixture room gets them too).
local MOCK_HOTSPOTS = {
	{ label = "Couch", blurb = "Where the losers sat", x = -1.7, y = 0.6, z = -2.2 },
	{ label = "TV", blurb = "Mario Kart, 4 players", x = -1.7, y = 1.4, z = 3.4 },
	{ label = "Snack table", blurb = "Mostly chips", x = 1.7, y = 0.9, z = 1.1 },
	{ label = "Window", blurb = "Rain all night", x = 4.1, y = 1.5, z = 0 },
}
local mockNotes: { [string]: { any } } = {}

function MockServer.hotspots(sceneId: string)
	if not jitter() then
		return false, "mock failure", 0
	end
	return true, { hotspots = MOCK_HOTSPOTS }, 200
end

function MockServer.notes(sceneId: string)
	if not jitter() then
		return false, "mock failure", 0
	end
	local list = mockNotes[sceneId]
	if not list then
		list = { { id = "n-maya", author = "Maya", text = "best night ever", x = 0.8, y = 1.6, z = -2.5 } }
		mockNotes[sceneId] = list
	end
	return true, { notes = list }, 200
end

function MockServer.addNote(sceneId: string, body: any)
	if not jitter() then
		return false, "mock failure", 0
	end
	MockServer.notes(sceneId)
	local note = table.clone(body)
	note.id = HttpService:GenerateGUID(false)
	table.insert(mockNotes[sceneId], note)
	return true, note, 200
end

function MockServer.presence(sceneId: string, body: any)
	lastScene = lastScene or sceneId
	if elapsed() < JUDGE_MOVES_AT then
		lastScene = sceneId
	end
	if not jitter() then
		return false, "mock failure", 0
	end
	local others = {}
	local js = judgeScene()
	if js == sceneId then
		table.insert(others, MockServer.mockVr(os.clock()))
		local a = os.clock() * 0.3
		table.insert(others, { id = "web-7f3a19c2", name = "Maya", kind = "web",
			x = -3.57 + math.cos(a) * 2, y = 0, z = 2.86 + math.sin(a) * 2, yaw = -a })
	end
	return true, {
		t = now(),
		others = others,
		active = if js then { sceneId = js, name = nameOf(js) } else nil,
	}, 200
end

function MockServer.event(sceneId: string, body: any)
	if not jitter() then
		return false, "mock failure", 0
	end
	print("[MockServer] event", sceneId, HttpService:JSONEncode(body))
	return true, { ok = true }, 200
end

function MockServer.people(sceneId: string)
	if not jitter() then
		return false, "mock failure", 0
	end
	local people = {}
	if judgeScene() == sceneId then
		local v = MockServer.mockVr(os.clock())
		table.insert(people, { id = v.id, name = v.name, kind = "vr", x = v.x / SPM, y = 0, z = v.z / SPM,
			yaw = v.yaw, age = 0.1 })
	end
	return true, { t = now(), people = people }, 200
end

return MockServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">PingPong</string>
          <string name="Source"><![CDATA[-- Real-physics ping pong on the Game Lawn table (team/seb.md Update 5, section B).
-- The server owns the ball and the rules; clients send paddle poses and hits. One match at a time, winner stays.
-- Its own files only: this module, PingPongSim (shared), Games.client + PingPongView (client). One line in Main.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local World = require(script.Parent.World)
local Stats = require(script.Parent.Stats)
local Rooms = require(script.Parent.Rooms)
local Pong = require(script.Parent.Pong)
local Sim = require(ReplicatedStorage.Shared.PingPongSim)

local PingPong = {}

local SCORE_TO_WIN = Sim.WIN_SCORE
local SIDE_ZONE = 12
local HIT_SLACK = 1.8
local BOT_DELAY = 0.28

local frame = CFrame.new()
local tableYaw = 0
local len, wid = Sim.LEN, Sim.WID
local folder: Folder? = nil
local ball: Part? = nil
local net: Part? = nil
local board: TextLabel? = nil
local prompt: ProximityPrompt? = nil

local sides: { [string]: Player? } = { A = nil, B = nil }
local queue: { Player } = {}
local score = { A = 0, B = 0 }
local serverSide = "A"
local pointsPlayed = 0
local matchStart = 0
local roundId = ""
local over = false
local state: any = nil
local lastHitter: string? = nil
local lastBounce: string? = nil
local botBusy = false

local Remotes: Folder
local PPHit: RemoteEvent
local PPPaddle: UnreliableRemoteEvent
local PPState: RemoteEvent
local PPSide: RemoteEvent

local function now(): number
	return workspace:GetServerTimeNow()
end

local function other(s: string): string
	return if s == "A" then "B" else "A"
end

local function nameOf(s: string?): string
	if not s then
		return "—"
	end
	local p = sides[s]
	return if p and p.Parent then p.DisplayName elseif s then "Bot" else "—"
end

local function playerSide(p: Player): string?
	for s, q in sides do
		if q == p then
			return s
		end
	end
	return nil
end

local function updateBoard()
	if board then
		board.Text = string.format(
			"%s  %d  ·  %d  %s\nserve %s · rally %d · best %d",
			nameOf("A"),
			score.A,
			score.B,
			nameOf("B"),
			nameOf(serverSide),
			state and state.rally or 0,
			state and state.best or 0
		)
	end
	workspace:SetAttribute("PPActive", folder ~= nil and not over)
	if PPState then
		PPState:FireAllClients({
			active = folder ~= nil,
			over = over,
			A = nameOf("A"),
			B = nameOf("B"),
			scoreA = score.A,
			scoreB = score.B,
			serve = serverSide,
			to = state and state.to or nil,
			bounce = lastBounce,
			serving = state and state.serving or false,
			c = frame.Position,
			yaw = tableYaw,
			len = len,
			wid = wid,
		})
	end
end

local function broadcastState()
	if PPState then
		PPState:FireAllClients({
			state = state and { p = state.p, v = state.v, t = state.t, to = state.to } or nil,
			shot = state and state.shot or 0,
		})
	end
end

local function ensurePart(name: string, size: Vector3, colour: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.Color = colour
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

local function destroyTable()
	if folder then
		folder:Destroy()
	end
	if ball then
		ball:Destroy()
	end
	folder, ball, net, board, prompt = nil, nil, nil, nil, nil
	state = nil
	lastHitter, lastBounce, botBusy = nil, nil, false
	workspace:SetAttribute("PPActive", false)
end

-- Build the visible table (a real table gets only the net and the lines) and the prompt.
local function buildTable(tableCf: CFrame, length: number, width: number, visible: boolean)
	destroyTable()
	frame, len, wid = tableCf, length, width
	tableYaw = select(2, tableCf:ToOrientation())
	local root = workspace:FindFirstChild("Room")
	folder = Instance.new("Folder")
	folder.Name = "PingPongTable"
	folder.Parent = if root and root:IsA("Folder") then root else workspace

	if visible then
		local top = ensurePart("Top", Vector3.new(width, 0.12, length), Color3.fromRGB(28, 66, 54), folder)
		top.CFrame = frame * CFrame.new(0, -0.06, 0)
		for _, z in { -length / 2, length / 2 } do
			local line = ensurePart("Line", Vector3.new(width, 0.02, 0.06), Color3.fromRGB(245, 245, 245), folder)
			line.CFrame = frame * CFrame.new(0, 0.01, z)
		end
		local centre = ensurePart("Line", Vector3.new(0.06, 0.02, length), Color3.fromRGB(245, 245, 245), folder)
		centre.CFrame = frame * CFrame.new(0, 0.01, 0)
	end

	net = ensurePart("Net", Vector3.new(Sim.NET_L, Sim.NET_H, 0.05), Color3.fromRGB(235, 235, 235), folder)
	net.Transparency = 0.15
	net.CFrame = frame * CFrame.new(0, Sim.NET_H / 2, 0)

	ball = Instance.new("Part")
	ball.Name = "PPBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.36, 0.36, 0.36)
	ball.Color = Color3.fromRGB(255, 170, 40)
	ball.Material = Enum.Material.Neon
	ball.Anchored, ball.CanCollide, ball.CanQuery, ball.CanTouch = true, false, false, false
	ball.Parent = folder
	ball.CFrame = frame * CFrame.new(Sim.servePos("A", len))

	local anchor = ensurePart("Board", Vector3.new(4, 1.2, 0.2), Color3.fromRGB(20, 20, 20), folder)
	anchor.Transparency = 1
	anchor.CFrame = frame * CFrame.new(0, 3.1, 0)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Scoreboard"
	gui.Size = UDim2.fromOffset(420, 96)
	gui.AlwaysOnTop = true
	gui.Parent = anchor
	board = Instance.new("TextLabel")
	board.Size = UDim2.fromScale(1, 1)
	board.BackgroundTransparency = 1
	board.Font = Enum.Font.GothamBold
	board.TextScaled = false
	board.TextSize = 22
	board.TextColor3 = Color3.fromRGB(245, 245, 245)
	board.TextStrokeTransparency = 0.4
	board.TextWrapped = true
	board.Text = ""
	board.Parent = gui

	local signGui = Instance.new("BillboardGui")
	signGui.Name = "RealPingPongSign"
	signGui.Size = UDim2.fromOffset(360, 72)
	signGui.AlwaysOnTop = true
	signGui.Parent = anchor
	local sign = Instance.new("TextLabel")
	sign.Size = UDim2.fromScale(1, 1)
	sign.BackgroundTransparency = 1
	sign.Font = Enum.Font.GothamBlack
	sign.TextSize = 26
	sign.TextColor3 = Color3.fromRGB(0, 122, 255)
	sign.TextStrokeTransparency = 0.2
	sign.Text = "REAL PING PONG\nhold to charge, release to hit"
	sign.Parent = signGui

	prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Play real ping pong"
	prompt.ObjectText = "Real ping pong table"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(p)
		PingPong.join(p)
	end)

	updateBoard()
end

local function placeForScene(host: Player?, features: any?, cameraLook: Vector3?)
	local sceneId = workspace:GetAttribute("SceneId")
	local ft = features and features.pingPongTable
	local centre, yaw, l, w = Sim.fromCorners(ft and ft.corners or nil)
	if centre and yaw and l and w then
		buildTable(CFrame.new(centre) * CFrame.Angles(0, yaw, 0), l, w, false)
		return
	end
	local tuned = type(sceneId) == "string" and Config.PINGPONG_TABLES[sceneId]
	if tuned then
		local c = Vector3.new(tuned.centre[1], tuned.centre[2], tuned.centre[3])
		buildTable(
			CFrame.new(c) * CFrame.Angles(0, tuned.yaw or 0, 0),
			tuned.length or Sim.LEN,
			tuned.width or Sim.WID,
			tuned.visible == true
		)
		return
	end
	local hrp = host and host.Character and host.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		World.toast("Walk into the room first", host)
		return
	end
	local dir = if typeof(cameraLook) == "Vector3" then cameraLook else hrp.CFrame.LookVector
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local look = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
	local hum = (hrp.Parent :: Model):FindFirstChildOfClass("Humanoid")
	local floorY = hrp.Position.Y - ((hum and hum.HipHeight or 2) + hrp.Size.Y / 2)
	local centre2 = Vector3.new(hrp.Position.X, floorY + 2.71, hrp.Position.Z) + look * (6 + len / 2)
	buildTable(CFrame.new(centre2) * CFrame.Angles(0, math.atan2(look.X, look.Z), 0), Sim.LEN, Sim.WID, true)
end

local function launch(to: string, p0: Vector3, flight: number, aim: number)
	state.to = to
	state.p = p0
	state.t = now()
	state.live = true
	state.serving = false
	state.lastTouch = state.t
	state.bounces = 0
	state.shot += 1
	state.rally = state.rally or 0
	lastHitter = other(to)
	lastBounce = nil
	local v = Sim.assistReturn(p0, other(to), aim, flight, len, wid)
	state.v = v
	ball.CFrame = frame * CFrame.new(state.p)
	broadcastState()
	updateBoard()
end

local function serve(wait: boolean)
	if over or not folder then
		return
	end
	state = state or { rally = 0, best = 0, shot = 0 }
	state.rally = 0
	local p = Sim.servePos(serverSide, len)
	state.p, state.v, state.t = p, Vector3.zero, now()
	state.live, state.lastTouch, state.bounces = true, now(), 0
	state.to = serverSide
	state.serving = true
	lastHitter, lastBounce = nil, nil
	ball.CFrame = frame * CFrame.new(p)
	updateBoard()
	broadcastState()
	if wait and sides[serverSide] then
		World.toast("Your serve, " .. nameOf(serverSide), sides[serverSide])
	end
	if not sides[serverSide] then
		-- the bot serves after a moment
		task.delay(0.9, function()
			if folder and state and state.serving and not over then
				launch(other(serverSide), state.p, 0.8, 0)
			end
		end)
	end
end

local function finish(winnerSide: string)
	over = true
	local winner, loser = sides[winnerSide], sides[other(winnerSide)]
	local duration = math.max(0, math.floor(now() - matchStart))
	local wId = winner and `rbx-{winner.UserId}` or "bot"
	local lId = loser and `rbx-{loser.UserId}` or "bot"
	local wName = winner and winner.DisplayName or "Bot"
	local lName = loser and loser.DisplayName or "Bot"
	Backend.sendEvent(workspace:GetAttribute("SceneId"), {
		type = "game.result",
		game = "pingpong",
		round = roundId,
		winner = wId,
		winnerName = wName:sub(1, 40),
		loser = lId,
		loserName = lName:sub(1, 40),
		score = string.format("%d-%d", score[winnerSide], score[other(winnerSide)]),
		durationS = duration,
	})
	Stats.win(winner, "pingpong")
	World.toast(string.format("%s wins %d-%d", wName, score[winnerSide], score[other(winnerSide)]))
	updateBoard()
	task.delay(6, function()
		if not folder then
			return
		end
		over = false
		score.A, score.B = 0, 0
		pointsPlayed = 0
		matchStart = now()
		local loserSide = other(winnerSide)
		local nextPlayer = table.remove(queue, 1)
		if nextPlayer and nextPlayer.Parent then
			sides[loserSide] = nextPlayer
			if PPSide then
				PPSide:FireClient(nextPlayer, loserSide)
			end
			World.toast("You are up next", nextPlayer)
		end
		serverSide = other(serverSide)
		serve(true)
	end)
end

local function point(winnerSide: string, why: string)
	if over or not folder then
		return
	end
	score[winnerSide] += 1
	pointsPlayed += 1
	state.live = false
	World.toast(why)
	print(string.format("[PingPong] %s · %s · %d-%d", why, nameOf(winnerSide), score.A, score.B))
	updateBoard()
	local target = if score[winnerSide] >= SCORE_TO_WIN and score[winnerSide] - score[other(winnerSide)] >= 2
		then winnerSide
		else nil
	if target then
		finish(target)
		return
	end
	if pointsPlayed % 2 == 0 and not (score.A >= 10 and score.B >= 10) then
		serverSide = other(serverSide)
	end
	task.delay(1.2, function()
		if folder and not over then
			serve(true)
		end
	end)
end

local function botReturn()
	if botBusy or not folder or over or not state or not state.live then
		return
	end
	if sides[state.to] then
		return
	end
	botBusy = true
	task.delay(BOT_DELAY, function()
		botBusy = false
		if not folder or over or not state or not state.live then
			return
		end
		if sides[state.to] then
			return
		end
		local from = state.p
		state.rally = (state.rally or 0) + 1
		state.best = math.max(state.best or 0, state.rally)
		launch(other(state.to), from, math.max(0.55, 0.8 - state.rally * 0.02), (math.random() * 2 - 1) * 0.7)
	end)
end

local function step(dt: number)
	if not state or not state.live or not ball then
		return
	end
	local ev = Sim.step(state, dt, len, wid)
	ball.CFrame = frame * CFrame.new(state.p)
	if ev.table then
		lastBounce = ev.table
		state.serveInFlight = false
		state.lastTouch = state.t
		updateBoard()
		if ev.table == state.to then
			botReturn()
		end
	end
	if ev.net then
		if state.serveInFlight then
			state.serveInFlight = false
			World.toast("Let, serve again")
			serve(true)
			return
		end
		-- a net touch kills the rally; the receiver takes the point
		point(state.to, "Net")
		return
	end
	if ev.dead then
		local winner
		if not lastHitter then
			winner = other(serverSide)
		elseif lastBounce == state.to then
			winner = lastHitter -- it bounced on the receiver's half; they failed to return it
		else
			winner = state.to -- it never reached the far half: the hitter's fault
		end
		point(winner, "Out")
	end
end

local lastHitAt: { [number]: number } = {}

local function onHit(player: Player, payload: any)
	if over or not folder or not state or not state.live then
		return
	end
	local t = os.clock()
	if t - (lastHitAt[player.UserId] or 0) < 0.2 then
		return
	end
	lastHitAt[player.UserId] = t
	local side = playerSide(player)
	if not side or side ~= state.to or state.serving then
		return
	end
	-- the ball must be on their half; a volley there is allowed (friendlier than a strict bounce gate)
	local lp = frame:PointToObjectSpace(state.p)
	local onSide = (side == "A" and lp.Z < 0) or (side == "B" and lp.Z > 0)
	if not onSide then
		return
	end
	if type(payload) ~= "table" then
		return
	end
	local charge = math.clamp(tonumber(payload.charge) or 0, 0, 1)
	local dir = payload.dir
	local aimed = typeof(dir) == "Vector3" and dir.Magnitude > 0.1
	local p0 = state.p
	state.serving = false
	state.rally = (state.rally or 0) + 1
	state.best = math.max(state.best or 0, state.rally)
	if aimed and payload.vr ~= true then
		-- hold to charge, aim with the camera: reach and pace grow with the hold, and a late aim sails out
		local reach = (len / 2) * (0.55 + charge * 0.95)
		local target = p0 + (dir :: Vector3).Unit * reach
		if target.Y < Sim.TOP_Y + Sim.BALL_R then
			target = Vector3.new(target.X, Sim.TOP_Y + Sim.BALL_R, target.Z)
		end
		local flight = math.clamp(0.95 - charge * 0.45, 0.45, 0.95)
		local v = Sim.assistVelocity(p0, target, flight)
		if v.Magnitude > Sim.MAX_SPEED then
			v = v.Unit * Sim.MAX_SPEED
		end
		state.to = other(side)
		lastHitter = side
		lastBounce = nil
		state.lastTouch = state.t
		state.v = v
		ball.CFrame = frame * CFrame.new(state.p)
		broadcastState()
		updateBoard()
		return
	end
	if payload.vr == true and typeof(payload.cf) == "CFrame" and typeof(payload.vel) == "Vector3" then
		-- the paddle really hit it: reflect off the blade and let the ball fly
		local blade = payload.cf :: CFrame
		local claimed = payload.p
		if typeof(claimed) == "Vector3" and (claimed - state.p).Magnitude > 2 then
			broadcastState()
			return
		end
		if (blade.Position - state.p).Magnitude > 2.2 then
			broadcastState()
			return
		end
		local before = state.v
		Sim.paddleHit(state, blade.UpVector, payload.vel :: Vector3, 0.8)
		if state.v ~= before then
			local boost = 0.75 + charge * 0.5
			state.v = state.v * boost
			if state.v.Magnitude > Sim.MAX_SPEED then
				state.v = state.v.Unit * Sim.MAX_SPEED
			end
		end
		if state.v == before then
			broadcastState() -- the ball was moving away; nothing to return
			return
		end
		state.to = other(side)
		lastHitter = side
		lastBounce = nil
		state.lastTouch = state.t
		ball.CFrame = frame * CFrame.new(state.p)
		broadcastState()
		updateBoard()
		return
	end
	launch(other(side), p0, flight, aim)
end

local function serveHit(player: Player, payload: any)
	local side = playerSide(player)
	if not side or side ~= serverSide or not state or not state.serving then
		return false
	end
	state.serving = false
	state.serveInFlight = true
	local charge = type(payload) == "table" and math.clamp(tonumber(payload.charge) or 0.3, 0, 1) or 0.3
	local dir = type(payload) == "table" and payload.dir or nil
	if typeof(dir) == "Vector3" and dir.Magnitude > 0.1 then
		local reach = (len / 2) * (0.55 + charge * 0.95)
		local target = state.p + dir.Unit * reach
		if target.Y < Sim.TOP_Y + Sim.BALL_R then
			target = Vector3.new(target.X, Sim.TOP_Y + Sim.BALL_R, target.Z)
		end
		local flight = math.clamp(0.95 - charge * 0.45, 0.45, 0.95)
		local v = Sim.assistVelocity(state.p, target, flight)
		if v.Magnitude > Sim.MAX_SPEED then
			v = v.Unit * Sim.MAX_SPEED
		end
		state.to = other(side)
		lastHitter = side
		lastBounce = nil
		state.lastTouch = state.t
		state.v = v
		ball.CFrame = frame * CFrame.new(state.p)
		broadcastState()
		updateBoard()
		return true
	end
	launch(other(side), state.p, 0.8, 0)
	return true
end

local stepAccum = 0
local function onHeartbeat(dt: number)
	if not folder or not state then
		return
	end
	stepAccum = math.min(stepAccum + dt, 0.2)
	local h = 1 / 60
	while stepAccum >= h do
		stepAccum -= h
		if state.serving then
			-- the ball floats where it is until the serve is hit
			state.t = now()
			state.lastTouch = now()
		elseif not state.live then
			break
		else
			for _ = 1, 2 do
				step(h / 2)
			end
		end
	end
end

function PingPong.isActive(): boolean
	return folder ~= nil
end

function PingPong.join(player: Player)
	if not folder then
		World.toast("No table here yet", player)
		return
	end
	local side = playerSide(player)
	if side then
		return
	end
	for _, s in { "A", "B" } do
		if not sides[s] then
			sides[s] = player
			if PPSide then
				PPSide:FireClient(player, s)
			end
			World.toast("Real ping pong: hold to charge, release to hit", player)
			World.toast(if s == "A" then "You are on the near side" else "You are on the far side", player)
			if over then
				return
			end
			if state == nil or not state.live then
				serve(true)
			end
			updateBoard()
			return
		end
	end
	if #queue < 6 then
		table.insert(queue, player)
		World.toast("Queued for the next match", player)
	end
end

function PingPong.stop(): void
	destroyTable()
	sides.A, sides.B = nil, nil
	queue = {}
	score.A, score.B = 0, 0
	over = false
end

function PingPong.start()
	local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
	Remotes = RemotesFolder :: Folder

	local function remote(name: string, class: string): any
		local r = Remotes:FindFirstChild(name) or Instance.new(class)
		r.Name = name
		r.Parent = Remotes
		return r
	end
	PPHit = remote("PPHit", "RemoteEvent")
	PPPaddle = remote("PPPaddle", "UnreliableRemoteEvent")
	PPState = remote("PPState", "RemoteEvent")
	PPSide = remote("PPSide", "RemoteEvent")

	PPHit.OnServerEvent:Connect(function(player, payload)
		if state and state.serving then
			if serveHit(player, payload) then
				return
			end
		end
		onHit(player, payload)
	end)

	PPPaddle.OnServerEvent:Connect(function(player, cf)
		if typeof(cf) == "CFrame" then
			-- fan the pose out to everyone so every client draws the other paddles
			PPPaddle:FireAllClients(player.UserId, cf)
		end
	end)

	Players.PlayerRemoving:Connect(function(p)
		for s, q in sides do
			if q == p then
				sides[s] = nil
			end
		end
		for i = #queue, 1, -1 do
			if queue[i] == p then
				table.remove(queue, i)
			end
		end
		updateBoard()
		if folder and state and state.serving then
			serve(true)
		end
	end)

	local function maybePlace()
		if workspace:GetAttribute("Phase") ~= "room" then
			return
		end
		if workspace:GetAttribute("SceneId") ~= "the-courts" or folder then
			return
		end
		local info = Rooms.modelInfo("the-courts")
		local features = info and info.features or nil
		if not (features and features.pingPongTable) and not Config.PINGPONG_TABLES["the-courts"] then
			-- Temporary: the model has no features yet. Put a visible table in the middle of the lawn so the game is
			-- playable today; features.pingPongTable replaces it as soon as the server sends it.
			local room = workspace:FindFirstChild("Room")
			local mn = room and room:GetAttribute("BoundsMin")
			local mx = room and room:GetAttribute("BoundsMax")
			if typeof(mn) == "Vector3" and typeof(mx) == "Vector3" then
				local c = (mn + mx) / 2
				buildTable(CFrame.new(c.X, c.Y + 2.71, c.Z), Sim.LEN, Sim.WID, true)
				roundId = string.format(
					"pp-%s",
					string.upper(
						(game.JobId:sub(1, 8) ~= "" and game.JobId:sub(1, 8) or "studio")
							.. tostring(math.floor(os.clock() * 1000))
					)
				)
				matchStart = now()
				score.A, score.B = 0, 0
				pointsPlayed, over = 0, false
				serverSide = "A"
				state = nil
				sides.A, sides.B = nil, nil
				updateBoard()
				return
			end
		end
		PingPong.placeForRoom(nil, features, nil)
	end

	workspace:GetAttributeChangedSignal("Phase"):Connect(function()
		if workspace:GetAttribute("Phase") ~= "room" then
			PingPong.stop()
		else
			task.delay(1, maybePlace)
		end
	end)
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		PingPong.stop()
		task.delay(2, maybePlace)
	end)
	task.delay(3, maybePlace)
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		PingPong.stop()
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
	print("[PingPong] ready")
end

-- Kept for the host action Shivin wires: open the table on the current room.
function PingPong.placeForRoom(host: Player?, features: any?, cameraLook: Vector3?)
	placeForScene(host, features, cameraLook)
	roundId = string.format(
		"pp-%s",
		string.upper(
			(game.JobId:sub(1, 8) ~= "" and game.JobId:sub(1, 8) or "studio") .. tostring(math.floor(os.clock() * 1000))
		)
	)
	matchStart = now()
	score.A, score.B = 0, 0
	pointsPlayed, over = 0, false
	serverSide = "A"
	state = nil
	sides.A, sides.B = nil, nil
	updateBoard()
end

return PingPong
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Pong</string>
          <string name="Source"><![CDATA[-- Ping pong on the real table (team/shivin.md Update 5, item 1). Simple and fun over realistic: the server picks each
-- shot (a bounce point on the far half and an end point past the far edge) and every client animates the same arcs
-- locally, so the ball is smooth everywhere. Stand at an end of the table and press HIT (button, E, click or the Quest
-- trigger) while the ball is coming to you after its bounce. First to 7. Alone, a bot returns the ball.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local World = require(script.Parent.World)
local Theme = require(ReplicatedStorage.Shared.Theme)
local Stats = require(script.Parent.Stats)

local PongHit = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PongHit") :: RemoteEvent

local Pong = {}

local WIN_SCORE = 7
local HIT_REACH = 9 -- studs from the player's root to the ball
local SIDE_ZONE = 12 -- how far behind/around an end counts as standing at it
local LATE = 0.35 -- seconds after the ball passes the end that a hit still counts
local BOT_RETURN = 0.85

-- Table in its own frame: long axis along Z, net at z = 0, top at y = 0. Side "A" is -Z, side "B" is +Z.
local tableCf = CFrame.new()
local LEN, WID = 14, 8
local folder: Folder? = nil
local scoreLabel: TextLabel? = nil

local sides: { [string]: Player? } = { A = nil, B = nil }
local score = { A = 0, B = 0 }
local server = "A" -- who serves next
local rally = 0
local best = 0
local over = false

-- The ball in flight: towards `to` (the side that must return it).
local shot: any = nil
local shotId = 0

local function now(): number
	return workspace:GetServerTimeNow()
end

local function other(s: string): string
	return if s == "A" then "B" else "A"
end

local function local2world(v: Vector3): Vector3
	return tableCf:PointToWorldSpace(v)
end

local function sideOf(player: Player): string?
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return nil
	end
	local p = tableCf:PointToObjectSpace(hrp.Position)
	if math.abs(p.X) > WID / 2 + SIDE_ZONE then
		return nil
	end
	if p.Z < -LEN / 2 + 3 and p.Z > -LEN / 2 - SIDE_ZONE then
		return "A"
	elseif p.Z > LEN / 2 - 3 and p.Z < LEN / 2 + SIDE_ZONE then
		return "B"
	end
	return nil
end

local function nameOf(s: string): string
	local p = sides[s]
	return if p then p.DisplayName elseif sides[other(s)] then "Bot" else "—"
end

local function updateBoard()
	if scoreLabel then
		scoreLabel.Text = string.format("%s  %d  ·  %d  %s\nrally %d · best %d", nameOf("A"), score.A, score.B, nameOf("B"),
			rally, best)
	end
	workspace:SetAttribute("PongActive", folder ~= nil)
end

-- Launch a shot from `fromSide` towards the other side. `origin` is the world point the ball leaves from.
local function launch(fromSide: string, origin: Vector3, speedUp: number)
	shotId += 1
	local to = other(fromSide)
	local dir = if to == "B" then 1 else -1
	local rng = Random.new()
	-- bounce somewhere on the receiver's half, then carry on past their end
	local bounce = Vector3.new(rng:NextNumber(-WID / 2 + 1, WID / 2 - 1), 0.25, dir * rng:NextNumber(LEN * 0.15, LEN * 0.42))
	local finish = Vector3.new(bounce.X + rng:NextNumber(-1.5, 1.5), 2.8, dir * (LEN / 2 + 2.5))
	local pace = math.clamp(1 + rally * 0.04, 1, 1.6) * speedUp
	local t1 = 0.75 / pace
	local t2 = 0.45 / pace
	local t0 = now() + 0.05
	shot = {
		id = shotId, to = to, t0 = t0, t1 = t1, t2 = t2,
		p0 = origin, b = local2world(bounce), p2 = local2world(finish),
		h1 = 3.2, h2 = 1.6,
	}
	World.Moment:FireAllClients({ type = "pongShot", id = shotId, t0 = t0, t1 = t1, t2 = t2,
		p0 = shot.p0, b = shot.b, p2 = shot.p2, h1 = shot.h1, h2 = shot.h2 })
	local myId = shotId
	-- the receiver (or the bot) must answer before the ball is gone
	task.delay(0.05 + t1 + t2 + LATE, function()
		if shot and shot.id == myId then
			Pong.point(fromSide, nameOf(to) .. " missed")
		end
	end)
	if not sides[to] then
		-- bot: returns most balls, a moment after the bounce
		task.delay(0.05 + t1 + t2 * 0.6, function()
			if shot and shot.id == myId and not over then
				if rng:NextNumber() < BOT_RETURN then
					rally += 1
					best = math.max(best, rally)
					updateBoard()
					-- the bot stands at the receiving end (`to`), so the ball leaves from there
					launch(to, local2world(Vector3.new(rng:NextNumber(-2, 2), 2.6, dir * (LEN / 2 + 1.5))), 1)
				end
			end
		end)
	end
end

local function serve()
	if over or not folder then
		return
	end
	rally = 0
	updateBoard()
	local dir = if server == "A" then -1 else 1
	local origin = local2world(Vector3.new(0, 2.6, dir * (LEN / 2 + 1)))
	World.Moment:FireAllClients({ type = "pongServe", side = server, name = nameOf(server) })
	if sides[server] or not sides[other(server)] then
		-- a person serves with HIT (or, with nobody playing yet, the first HIT starts it); the ball waits at that end
		shot = { id = shotId + 1, to = server, serving = true, p0 = origin }
		shotId += 1
		World.Moment:FireAllClients({ type = "pongWait", pos = origin })
	else
		task.delay(1.2, function()
			if not over and folder then
				launch(server, origin, 1)
			end
		end)
	end
end

function Pong.point(winnerSide: string, why: string)
	shot = nil
	score[winnerSide] += 1
	World.Moment:FireAllClients({ type = "pongEnd" })
	World.toast(why .. " · point " .. nameOf(winnerSide))
	print(string.format("[Pong] %s · point %s · %d-%d · rally %d", why, nameOf(winnerSide), score.A, score.B, rally))
	updateBoard()
	if score[winnerSide] >= WIN_SCORE then
		over = true
		local finalScore = string.format("%d-%d", score.A, score.B)
		World.Moment:FireAllClients({ type = "winner", title = string.upper(nameOf(winnerSide)) .. " WINS PING PONG",
			mvp = finalScore .. " · best rally " .. best })
		local sceneId = workspace:GetAttribute("SceneId")
		Stats.win(sides[winnerSide], "pingpong")
		if sceneId == "the-courts" then
			Stats.badge(sides[winnerSide], "court")
		end
		if type(sceneId) == "string" then
			Backend.sendEvent(sceneId, { type = "game", game = "pingpong", winner = nameOf(winnerSide), score = finalScore,
				bestRally = best })
		end
		return
	end
	-- serve changes every 2 points
	if (score.A + score.B) % 2 == 0 then
		server = other(server)
	end
	task.delay(1.5, serve)
end

-- Where the ball is on a shot right now (same arcs the clients draw).
local function ballAt(s: any, t: number): Vector3?
	if not s or s.serving then
		return if s then s.p0 else nil
	end
	local dt = t - s.t0
	if dt < 0 then
		return s.p0
	elseif dt <= s.t1 then
		local a = dt / s.t1
		return s.p0:Lerp(s.b, a) + Vector3.new(0, 4 * s.h1 * a * (1 - a), 0)
	elseif dt <= s.t1 + s.t2 + LATE then
		local a = math.min((dt - s.t1) / s.t2, 1.3)
		return s.b:Lerp(s.p2, a) + Vector3.new(0, 4 * s.h2 * a * (1 - a), 0)
	end
	return nil
end

local function onHit(player: Player)
	if over or not folder or not shot then
		return
	end
	local side = sideOf(player)
	if not side then
		return
	end
	-- claim an empty end
	if not sides[side] and sides[other(side)] ~= player then
		sides[side] = player
		World.toast(player.DisplayName .. " plays the " .. (if side == "A" then "near" else "far") .. " end")
		updateBoard()
	end
	-- nobody at the serving end: the bot there serves once a person has taken the other end
	if shot.serving and not sides[shot.to] and sides[other(shot.to)] == player then
		launch(shot.to, shot.p0, 1)
		return
	end
	if sides[side] ~= player or shot.to ~= side then
		return
	end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local t = now()
	local ball = ballAt(shot, t)
	if not hrp or not ball then
		return
	end
	if shot.serving then
		launch(side, ball, 1)
		return
	end
	-- only after the bounce, and within reach
	if t - shot.t0 < shot.t1 * 0.85 or (ball - hrp.Position).Magnitude > HIT_REACH then
		return
	end
	rally += 1
	best = math.max(best, rally)
	updateBoard()
	-- a hit right at the top of the bounce is a little faster
	local timing = 1 - math.abs(((t - shot.t0 - shot.t1) / shot.t2) - 0.5)
	launch(side, ball, 0.9 + timing * 0.3)
end

function Pong.remove()
	shot = nil
	if folder then
		folder:Destroy()
	end
	folder, scoreLabel = nil, nil
	World.Moment:FireAllClients({ type = "pongEnd" })
	workspace:SetAttribute("PongActive", false)
end

local function block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, transparency: number?)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored, p.CanTouch = true, false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

-- centre: the table top centre in world space; yaw: direction of the long axis (side A at the back).
local lastPlace: any = nil

-- Rematch: the same game again in the same spot (Update 6 item 1).
function Pong.isActive(): boolean
	return lastPlace ~= nil and workspace:FindFirstChild("Room") ~= nil and workspace.Room:FindFirstChild("PingPong") ~= nil
end

function Pong.rematch()
	if lastPlace then
		Pong.place(table.unpack(lastPlace, 1, lastPlace.n))
	end
end

function Pong.place(centre: Vector3, yaw: number, length: number?, width: number?, visible: boolean?)
	lastPlace = table.pack(centre, yaw, length, width, visible)
	Pong.remove()
	local room = workspace:FindFirstChild("Room")
	if not room then
		return
	end
	LEN, WID = length or 14, width or 8
	tableCf = CFrame.new(centre) * CFrame.Angles(0, yaw, 0)
	local f = Instance.new("Folder")
	f.Name = "PingPong"
	f.Parent = room
	folder = f
	-- On a real table from the world (features), only draw the net and lines; otherwise build the whole table.
	if visible ~= false then
		block(f, "Top", Vector3.new(WID, 0.3, LEN), tableCf * CFrame.new(0, -0.15, 0), Color3.fromRGB(24, 74, 140))
		for _, x in { -WID / 2 + 0.4, WID / 2 - 0.4 } do
			for _, z in { -LEN / 2 + 0.6, LEN / 2 - 0.6 } do
				block(f, "Leg", Vector3.new(0.4, 2.6, 0.4), tableCf * CFrame.new(x, -1.6, z), Color3.fromRGB(40, 40, 46))
			end
		end
	end
	block(f, "Line", Vector3.new(0.12, 0.02, LEN), tableCf * CFrame.new(0, 0.02, 0), Color3.new(1, 1, 1))
	block(f, "Net", Vector3.new(WID + 0.6, 0.6, 0.08), tableCf * CFrame.new(0, 0.3, 0), Color3.fromRGB(235, 235, 235), 0.2)
	-- scoreboard over the net
	local sign = block(f, "Score", Vector3.one, tableCf * CFrame.new(0, 5, 0), Color3.new(), 1)
	sign.CanCollide, sign.CanQuery = false, false
	local gui = Theme.make("BillboardGui", { Size = UDim2.fromOffset(360, 84), AlwaysOnTop = true, LightInfluence = 0,
		MaxDistance = 200, Parent = sign })
	local card = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.08,
		Parent = gui }, { Theme.corner(14), Theme.stroke(Theme.Accent, 1.5) })
	scoreLabel = Theme.label({ Text = "", FontFace = Theme.Heading, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), MaxText = 26, Parent = card })
	sides, score, server, rally, over = { A = nil, B = nil }, { A = 0, B = 0 }, "A", 0, false
	updateBoard()
	World.toast("Ping pong: stand at an end of the table and press HIT")
	task.delay(2, serve)
end

-- features.pingPongTable: 4 top corners (studs) + height. Long axis = the longer pair of sides.
local function placeFromFeature(ft: any): boolean
	if type(ft) ~= "table" or type(ft.corners) ~= "table" or #ft.corners < 4 then
		return false
	end
	local c = {}
	for i = 1, 4 do
		local v = ft.corners[i]
		c[i] = Vector3.new(v[1] or v.x, v[2] or v.y, v[3] or v.z)
	end
	local centre = (c[1] + c[2] + c[3] + c[4]) / 4
	local e1, e2 = c[2] - c[1], c[3] - c[2]
	local long, short = if e1.Magnitude >= e2.Magnitude then e1 else e2, if e1.Magnitude >= e2.Magnitude then e2 else e1
	local yaw = math.atan2(-long.X, -long.Z)
	Pong.place(centre, yaw, long.Magnitude, short.Magnitude, false)
	return true
end

function Pong.placeForRoom(host: Player?, features: any?, cameraLook: Vector3?)
	if features and placeFromFeature(features.pingPongTable) then
		return
	end
	local sceneId = workspace:GetAttribute("SceneId")
	local tuned = type(sceneId) == "string" and Config.PINGPONG_TABLES[sceneId]
	if tuned then
		Pong.place(Vector3.new(tuned.centre[1], tuned.centre[2], tuned.centre[3]), tuned.yaw or 0, tuned.length, tuned.width,
			tuned.visible)
		return
	end
	local hrp = host and host.Character and host.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		World.toast("Walk into the room first", host)
		return
	end
	local dir = if typeof(cameraLook) == "Vector3" then cameraLook else hrp.CFrame.LookVector
	local flat = Vector3.new(dir.X, 0, dir.Z)
	local look = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
	local hum = (hrp.Parent :: Model):FindFirstChildOfClass("Humanoid")
	local floorY = hrp.Position.Y - ((hum and hum.HipHeight or 2) + hrp.Size.Y / 2)
	-- table top 2.9 studs up, its near end (side A) 6 studs in front of the host
	local centre = Vector3.new(hrp.Position.X, floorY + 2.9, hrp.Position.Z) + look * (6 + 7)
	Pong.place(centre, math.atan2(look.X, look.Z), 14, 8, true)
end

function Pong.start()
	PongHit.OnServerEvent:Connect(onHit)
	Players.PlayerRemoving:Connect(function(p)
		for s, q in sides do
			if q == p then
				sides[s] = nil
			end
		end
		updateBoard()
	end)
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		shot, folder, scoreLabel = nil, nil, nil
		workspace:SetAttribute("PongActive", false)
	end)
end

return Pong
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Presence</string>
          <string name="Source"><![CDATA[-- 4 Hz presence loop: posts our room players, buffers everyone else, fans ghosts out to clients.
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local MapBuilder = require(script.Parent.MapBuilder)
local MockServer = require(script.Parent.MockServer)
local World = require(script.Parent.World)
local Interp = require(ReplicatedStorage.Shared.Interp)
local Util = require(ReplicatedStorage.Shared.Util)

local GhostState = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("GhostState") :: UnreliableRemoteEvent

local Presence = {}

export type Person = { id: string, name: string, kind: string, buf: Interp.Buffer, lastSeen: number }

Presence.people = {} :: { [string]: Person }
Presence.onActive = nil :: ((active: any) -> ())?
Presence.onHostEvent = nil :: ((ev: any) -> ())?
Presence.stateOf = nil :: ((player: Player) -> string?)?
-- The server says the room we post for no longer exists (archived or deleted): Rooms.roomClosed.
Presence.onRoomGone = nil :: ((sceneId: string) -> ())?

local serverId = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local failures = 0
local gone = 0 -- 404s in a row for the current room
local appliedEvents: { [any]: boolean } = {}
local postedScene: string? = nil

local function myIds(): { [string]: boolean }
	local ids = {}
	for _, p in game:GetService("Players"):GetPlayers() do
		ids["rbx-" .. p.UserId] = true
	end
	return ids
end

local function buildPayload()
	local players = {}
	if workspace:GetAttribute("Phase") == "room" then
		for _, p in World.inRoom() do
			if not p:GetAttribute("Out") and p.Character then
				local feet = Util.feetOf(p.Character)
				local hrp = p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if feet and hrp then
					local entry: { [string]: any } = {
						id = "rbx-" .. p.UserId,
						name = string.sub(p.DisplayName, 1, 40),
						x = feet.X, y = feet.Y, z = feet.Z,
						yaw = Util.yawOf(hrp.CFrame),
					}
					local st = Presence.stateOf and Presence.stateOf(p)
					if st then
						entry.state = st
					end
					table.insert(players, entry)
				end
			end
		end
	end
	return { players = players, server = serverId }
end

function Presence.clear()
	for id in Presence.people do
		World.Moment:FireAllClients({ type = "gone", id = id })
	end
	Presence.people = {}
end

-- The first VR person (the judge), or nil.
function Presence.vr(): Person?
	local best: Person? = nil
	for _, person in Presence.people do
		if person.kind == "vr" and (not best or person.id < best.id) then
			best = person
		end
	end
	return best
end

local function handle(res: any)
	local now = workspace:GetServerTimeNow()
	local spm = (MapBuilder.current and MapBuilder.current.studsPerMeter) or 3.57
	local mine = myIds()
	local others = if type(res.others) == "table" then res.others else {}
	if workspace:GetAttribute("MockJudge") and not Config.useMock() then
		local hasVr = false
		for _, o in others do
			hasVr = hasVr or o.kind == "vr"
		end
		if not hasVr then
			table.insert(others, MockServer.mockVr(os.clock()))
		end
	end
	local seen = {}
	local judge: Person? = nil
	for _, o in others do
		if type(o) == "table" and type(o.id) == "string" and not mine[o.id] then
			local pos = Vector3.new(tonumber(o.x) or 0, tonumber(o.y) or 0, tonumber(o.z) or 0)
			local head = Util.vec(o.head) or (pos + Vector3.new(0, 1.6 * spm, 0))
			local hl, hr = nil, nil
			if type(o.hands) == "table" then
				hl, hr = Util.vec(o.hands[1]), Util.vec(o.hands[2])
			end
			local person = Presence.people[o.id]
			if not person then
				person = { id = o.id, name = tostring(o.name or o.id), kind = tostring(o.kind or "web"),
					buf = Interp.new(), lastSeen = now }
				Presence.people[o.id] = person
			end
			person.name = tostring(o.name or person.name)
			person.kind = tostring(o.kind or person.kind)
			person.lastSeen = now
			local yaw = tonumber(o.yaw) or 0
			Interp.push(person.buf, { stamp = now, pos = pos, yaw = yaw, head = head, hl = hl, hr = hr })
			seen[o.id] = true
			if person.kind == "vr" and (not judge or person.id < judge.id) then
				judge = person
			end
			GhostState:FireAllClients({
				id = person.id, kind = person.kind, name = person.name, stamp = now,
				pos = pos, yaw = yaw, head = head, hl = hl, hr = hr,
			})
		end
	end
	for id in Presence.people do
		if not seen[id] then
			Presence.people[id] = nil
			World.Moment:FireAllClients({ type = "gone", id = id })
		end
	end
	workspace:SetAttribute("JudgeHere", judge ~= nil)
	workspace:SetAttribute("JudgeName", if judge then judge.name else "")
	if res.active ~= nil and Presence.onActive then
		Presence.onActive(res.active)
	end
	if type(res.events) == "table" and Presence.onHostEvent then
		for _, ev in res.events do
			local key = ev.id or HttpService:JSONEncode(ev)
			if not appliedEvents[key] then
				appliedEvents[key] = true
				Presence.onHostEvent(ev)
			end
		end
	end
end

function Presence.start()
	task.spawn(function()
		while true do
			local started = os.clock()
			local sceneId = workspace:GetAttribute("SceneId")
			if type(sceneId) ~= "string" or sceneId == "" then
				task.wait(0.5)
				continue
			end
			if postedScene ~= sceneId then
				postedScene = sceneId
				gone = 0
				Presence.clear()
			end
			local ok, res, status = Backend.presence(sceneId, buildPayload())
			if workspace:GetAttribute("SceneId") ~= sceneId then
				continue -- room changed mid-request; drop the stale answer
			end
			if ok and type(res) == "table" then
				failures = 0
				gone = 0
				workspace:SetAttribute("Offline", false)
				if workspace:GetAttribute("Banner") ~= "" then
					workspace:SetAttribute("Banner", "")
				end
				handle(res)
			elseif status == 404 and type(res) == "table" then
				-- our server's JSON 404: the room was closed (archived or deleted), the connection is fine
				failures = 0
				gone += 1
				if workspace:GetAttribute("Banner") == "Reconnecting to Déjà View..." then
					workspace:SetAttribute("Banner", "")
				end
				workspace:SetAttribute("Offline", false)
				-- only once the room is up: a room still loading is the switch's business
				if gone % 20 == 2 and Presence.onRoomGone and workspace:GetAttribute("Phase") == "room" then
					task.spawn(Presence.onRoomGone :: any, sceneId)
				end
			else
				failures += 1
				gone = 0
				if status == 401 then
					workspace:SetAttribute("Banner", "Key rejected")
				elseif failures >= 3 then
					workspace:SetAttribute("Banner", "Reconnecting to Déjà View...")
					workspace:SetAttribute("Offline", true)
				end
			end
			local delay = if failures == 0 then Config.PRESENCE_PERIOD else math.min(0.5 * 2 ^ (failures - 1), 4)
			if gone > 0 then
				delay = 1
			end
			if status == 429 then
				delay = 5
			end
			task.wait(math.max(0, delay - (os.clock() - started)))
		end
	end)
end

return Presence
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Rooms</string>
          <string name="Source"><![CDATA[-- Room list, prefetch + swatches, votes, switching, auto-join, JOIN and Follow (team/shivin.md 7.2).
local AssetService = game:GetService("AssetService")
local HttpService = game:GetService("HttpService")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local MapBuilder = require(script.Parent.MapBuilder)
local World = require(script.Parent.World)
local Fixtures = require(game:GetService("ReplicatedStorage").Shared.Fixtures)

local Rooms = {}

type Entry = { map: any?, swatches: { string }?, measuring: boolean, failed: boolean, tries: number, nextTry: number,
	gone: boolean? }

local list: { any } = {} -- last /api/scenes answer
local cache: { [string]: Entry } = {}
local firstSeen: { [string]: number } = {}
local listLoaded = false
local playableSeen: { [string]: boolean } = {}
local votes: { [Player]: string } = {}
local switching = 0
local judgeScene: string? = nil
local activeSeenAt = 0
local lastFollowed: string? = nil
local lastBoardJson = ""
local closedRooms: { [string]: boolean } = {} -- archived or deleted on the server while we knew them
local closing = false

Rooms.onSwitchStart = nil :: (() -> ())?
Rooms.onRoomReady = nil :: ((joined: boolean) -> ())?

local function now()
	return workspace:GetServerTimeNow()
end

-- Only Photo worlds become Roblox places; a video memory stays in the headset (shivin.md Update 2).
-- The live server still reports its internal mode names: "thirdwheel" is a video memory.
local function isVideo(s: any): boolean
	return s ~= nil and (s.mode == "video" or s.mode == "thirdwheel")
end

local function playable(s: any): boolean
	return s ~= nil and s.status == "ready" and not isVideo(s)
end

local function sceneById(id: string): any?
	for _, s in list do
		if s.id == id then
			return s
		end
	end
	return nil
end

local function swatches(map: any): { string }
	local weight: { [number]: number } = {}
	for _, p in map.parts do
		local key = bit32.bor(bit32.lshift(p[7] // 8, 10), bit32.lshift(p[8] // 8, 5), p[9] // 8)
		weight[key] = (weight[key] or 0) + p[4] * p[5] * p[6]
	end
	local keys = {}
	for k in weight do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		return weight[a] > weight[b]
	end)
	local out = {}
	for i = 1, math.min(4, #keys) do
		local k = keys[i]
		local r, g, b = bit32.rshift(k, 10) * 8 + 4, bit32.band(bit32.rshift(k, 5), 31) * 8 + 4, bit32.band(k, 31) * 8 + 4
		table.insert(out, Color3.fromRGB(r, g, b):ToHex())
	end
	return out
end

local function entry(id: string): Entry
	local e = cache[id]
	if not e then
		e = { map = nil, swatches = nil, measuring = false, failed = false, tries = 0, nextTry = 0 }
		cache[id] = e
	end
	return e
end

-- The textured room imported in Studio ahead of time (demo worlds), if any.
local function storedRoom(sceneId: string): Instance?
	local rooms = ServerStorage:FindFirstChild("Rooms")
	return rooms and rooms:FindFirstChild(sceneId)
end

-- GET /api/roblox/<id>/model (contract 6.2b): assetId, walkBounds, chunks. Cached once it answers 200.
local modelInfos: { [string]: any } = {}
local function modelInfo(sceneId: string): any?
	if modelInfos[sceneId] == nil then
		local ok, info, status = Backend.model(sceneId)
		if ok and type(info) == "table" then
			modelInfos[sceneId] = info
		elseif status == 404 then
			modelInfos[sceneId] = false -- not built for this scene (yet); try again next switch
			task.delay(30, function()
				modelInfos[sceneId] = nil
			end)
		end
	end
	return modelInfos[sceneId] or nil
end

Rooms.modelInfo = function(sceneId: string): any?
	return modelInfo(sceneId)
end

-- The union of {min, max} boxes (studs), or nil when any is missing.
local function unionBox(boxes: { any }): any?
	local mn, mx = nil, nil
	for _, b in boxes do
		local lo, hi = type(b) == "table" and b.min, type(b) == "table" and b.max
		if type(lo) ~= "table" or type(hi) ~= "table" then
			return nil
		end
		local a = Vector3.new(tonumber(lo[1]) or 0, tonumber(lo[2]) or 0, tonumber(lo[3]) or 0)
		local z = Vector3.new(tonumber(hi[1]) or 0, tonumber(hi[2]) or 0, tonumber(hi[3]) or 0)
		mn = if mn then mn:Min(a) else a
		mx = if mx then mx:Max(z) else z
	end
	if not mn or not mx then
		return nil
	end
	return { min = { mn.X, mn.Y, mn.Z }, max = { mx.X, mx.Y, mx.Z } }
end

-- The textured room the server uploaded with Open Cloud (contract 6.2b), loaded by asset id; nil without one. A model
-- in several parts (roblox.glb, roblox-2.glb, ...) loads every part into one Model, each part lined up on its own box
-- when the server sends one. Also returns the box the loaded
-- parts occupy according to the server (studs, map frame), to centre and scale the model on; nil when unknown.
local function uploadedRoom(sceneId: string): (Instance?, any?)
	local info = modelInfo(sceneId)
	local assetId = info and tonumber(info.assetId)
	if not assetId then
		return nil, nil
	end
	local items = {}
	local total = 1
	if type(info.parts) == "table" and #info.parts > 1 then
		total = #info.parts
		for _, p in info.parts do
			local id = type(p) == "table" and tonumber(p.assetId)
			if id then
				table.insert(items, { id = id, bounds = p.bounds })
			end
		end
	end
	if #items == 0 then
		items, total = { { id = assetId, bounds = info.bounds } }, 1
	end
	local room = Instance.new("Model")
	room.Name = "RoomModel"
	local loaded, boxes, allBoxes = 0, {}, true
	for i, it in items do
		local okLoad, container = pcall(AssetService.LoadAssetAsync, AssetService, it.id)
		if okLoad and typeof(container) == "Instance" then
			-- a Model or Folder wrapping the asset hands over its children; a lone MeshPart comes over as it is
			local part = Instance.new("Model")
			part.Name = "Part" .. i
			if container:IsA("Model") or container:IsA("Folder") then
				for _, c in container:GetChildren() do
					c.Parent = part
				end
				container:Destroy()
			else
				container.Parent = part
			end
			if #items > 1 then
				MapBuilder.alignPart(part, it.bounds)
			end
			part.Parent = room
			loaded += 1
			if type(it.bounds) == "table" then
				table.insert(boxes, it.bounds)
			else
				allBoxes = false
			end
		else
			warn("[DejaView] LoadAssetAsync failed for", sceneId, it.id, container)
		end
	end
	if loaded == 0 then
		room:Destroy()
		return nil, nil
	end
	print("[DejaView] loaded uploaded room model", sceneId, assetId, "(" .. loaded .. "/" .. total .. " parts)")
	local box = nil
	if loaded == total and type(info.bounds) == "table" then
		box = info.bounds
	elseif allBoxes then
		box = unionBox(boxes) -- only the parts that loaded: never stretch half a room over the whole one
	end
	return room, box
end

-- One map fetch attempt. Returns "ok" | "wait" | "fail".
local function fetchOnce(id: string): string
	local e = entry(id)
	local ok, data, status = Backend.map(id, Config.maxParts())
	if ok and status == 200 and type(data) == "table" and type(data.parts) == "table" then
		data.sceneId = data.sceneId or id
		e.map, e.swatches, e.measuring, e.failed, e.gone = data, swatches(data), false, false, false
		closedRooms[id] = nil -- back on the server
		return "ok"
	end
	e.tries += 1
	if status == 202 then
		e.measuring = true
		e.nextTry = os.clock() + (tonumber(type(data) == "table" and data.retryAfter) or 2)
		return "wait"
	elseif status == 404 then
		e.failed = true
		e.gone = type(data) == "table" -- our server's JSON 404: no such room (archived, deleted, or a video)
		return "fail"
	elseif status == 409 then
		e.nextTry = os.clock() + 3
		if e.tries >= 20 then
			e.failed = true
			return "fail"
		end
		return "wait"
	elseif status == 401 then
		workspace:SetAttribute("Banner", "Key rejected")
		e.nextTry = os.clock() + 10
		return "fail"
	end
	e.nextTry = os.clock() + math.min(2 ^ e.tries, 10)
	return "wait"
end

-- Blocking: get a map for id, retrying per the contract. Returns map or nil, reason.
local function fetchMap(id: string): (any?, string?)
	local e = entry(id)
	if e.map then
		return e.map
	end
	e.tries, e.failed, e.gone = 0, false, false
	local netFails = 0
	for _ = 1, 40 do
		local r = fetchOnce(id)
		if r == "ok" then
			return e.map
		elseif r == "fail" then
			return nil, if workspace:GetAttribute("Banner") == "Key rejected" then "Key rejected" else "No such room"
		end
		if not e.measuring then
			netFails += 1
			if netFails >= 6 then
				return nil, "Couldn't reach Déjà View"
			end
		else
			workspace:SetAttribute("LoadStage", "Measuring the room...")
		end
		task.wait(math.max(0.25, e.nextTry - os.clock()))
	end
	return nil, "Timed out"
end

local function publishBoard()
	local cards = {}
	for _, s in list do
		if #cards >= Config.PICKER_MAX then
			break
		end
		if s.status == "failed" or isVideo(s) then
			continue
		end
		local e = cache[s.id]
		table.insert(cards, {
			id = s.id,
			name = s.name or s.id,
			mode = if s.mode == "video" then "VIDEO" else "PHOTO",
			status = s.status,
			progress = s.progress or 0,
			createdAt = s.createdAt,
			blocks = e and e.map and #e.map.parts or nil,
			swatches = e and e.swatches or nil,
			measuring = e ~= nil and e.measuring and not e.map,
			loadable = e ~= nil and e.map ~= nil,
			newUntil = firstSeen[s.id],
			judge = judgeScene == s.id,
		})
	end
	local json = HttpService:JSONEncode(cards)
	if json ~= lastBoardJson then
		lastBoardJson = json
		workspace:SetAttribute("RoomsJson", json)
	end
end

local listFailures = 0

local function refreshList()
	local ok, data, status = Backend.scenes()
	if not ok or type(data) ~= "table" then
		-- The presence loop owns the banner once a room is loaded; before that, the room list does.
		listFailures += 1
		if listFailures >= 3 and (workspace:GetAttribute("SceneId") or "") == "" then
			workspace:SetAttribute("Banner", if status == 401 then "Key rejected" else "Reconnecting to Déjà View...")
		end
		return
	end
	if listFailures >= 3 and (workspace:GetAttribute("SceneId") or "") == "" then
		workspace:SetAttribute("Banner", "")
	end
	listFailures = 0
	local fresh = {}
	for _, s in data do
		if type(s) == "table" and type(s.id) == "string" then
			if not firstSeen[s.id] and listLoaded and s.status ~= "failed" then
				firstSeen[s.id] = now() + 60
			elseif not firstSeen[s.id] then
				firstSeen[s.id] = 0
			end
			table.insert(fresh, s)
		end
	end
	local pin: { [string]: number } = {}
	for i, id in Config.PINNED_SCENES do
		pin[id] = i
	end
	table.sort(fresh, function(a, b)
		local pa, pb = pin[a.id] or math.huge, pin[b.id] or math.huge
		if pa ~= pb then
			return pa < pb
		end
		return (a.createdAt or "") > (b.createdAt or "")
	end)
	-- "New room unlocked": a Photo world that turns ready after we started (the finale) gets a JOIN prompt.
	for _, s in fresh do
		if playable(s) and not playableSeen[s.id] then
			playableSeen[s.id] = true
			if listLoaded then
				World.Moment:FireAllClients({ type = "unlocked", id = s.id, name = s.name or s.id })
			end
		end
	end
	list = fresh
	listLoaded = true
end

local function prefetchOne()
	for _, s in list do
		if playable(s) then
			local e = entry(s.id)
			if not e.map and not e.failed and os.clock() >= e.nextTry then
				fetchOnce(s.id)
				return
			end
		end
	end
end

local function newestReadyOther(): string?
	local current = workspace:GetAttribute("SceneId")
	for _, s in list do
		if playable(s) and s.id ~= current then
			return s.id
		end
	end
	return nil
end

-- Builds sceneId. moveRoom: players already in a room come along. joinLobby: lobby players too.
function Rooms.switchTo(sceneId: string, opts: { moveRoom: boolean?, joinLobby: boolean? }?)
	local o = opts or {}
	switching += 1
	local mySwitch = switching
	votes = {}
	local s = sceneById(sceneId)
	local name = (s and s.name) or sceneId
	if Rooms.onSwitchStart then
		Rooms.onSwitchStart()
	end
	local moveRoom = o.moveRoom ~= false
	local previousRoomPlayers = World.inRoom()
	World.holdRoomPlayers(true)
	workspace:SetAttribute("Phase", "loading")
	workspace:SetAttribute("RoomName", name)
	workspace:SetAttribute("LoadProgress", 0)
	workspace:SetAttribute("LoadBuilt", 0)
	workspace:SetAttribute("LoadTotal", 0)
	workspace:SetAttribute("LoadStage", "Moving in...")
	workspace:SetAttribute("SceneId", sceneId)

	-- A room imported in Studio (ServerStorage.Rooms.<sceneId>) needs only one quick try at the block map, which is
	-- just its invisible floor; everything else waits for the map per the contract.
	local stored = storedRoom(sceneId)
	local map, reason
	if stored then
		local e = entry(sceneId)
		if not e.map then
			fetchOnce(sceneId)
		end
		map = e.map
	else
		map, reason = fetchMap(sceneId)
	end
	if mySwitch ~= switching then
		return
	end
	-- An uploaded model comes with the server's box for it (exact alignment); a room imported in Studio uses that box
	-- only when it has the same proportions (it may be another build), else it is aligned loosely on the block map. A
	-- room the server no longer has (404) gets neither.
	local visual, box = nil, nil
	local gone = not map and entry(sceneId).gone == true
	if stored and not gone then
		visual = stored:Clone()
		local smi = modelInfo(sceneId)
		box = smi and smi.bounds
	elseif not gone then
		visual, box = uploadedRoom(sceneId)
	end
	-- Walk limits come with the room model's details (Update 4).
	local mi = modelInfo(sceneId)
	if map and mi and mi.walkBounds and not map.walkBounds then
		map.walkBounds = mi.walkBounds
	end
	if mySwitch ~= switching then
		return
	end
	local info = nil
	if not map and visual then
		info = MapBuilder.buildFromModel(sceneId, name, visual, mi, box, stored ~= nil)
	elseif map then
		info = MapBuilder.build(map, function(built, total)
			if mySwitch == switching then
				workspace:SetAttribute("LoadProgress", built / math.max(total, 1))
				workspace:SetAttribute("LoadBuilt", built)
				workspace:SetAttribute("LoadTotal", total)
				workspace:SetAttribute("LoadStage", "Moving in...")
			end
		end, { collisionOnly = visual ~= nil })
		if not info then
			return -- cancelled by a newer switch
		end
		if visual then
			MapBuilder.attachModel(visual, box, stored ~= nil)
		end
		-- Per-world skybox rendered from the splat viewer (Update 10): six asset ids for the clients to show
		local sky = mi and mi.sky
		local room = workspace:FindFirstChild("Room")
		if room and type(sky) == "table" then
			for key, attr in { front = "SkyFt", back = "SkyBk", left = "SkyLf", right = "SkyRt", up = "SkyUp", down = "SkyDn" } do
				if sky[key] then
					room:SetAttribute(attr, "rbxassetid://" .. tostring(sky[key]))
				end
			end
		end
	elseif not gone and MapBuilder.hasBaked(sceneId) then
		info = MapBuilder.buildBaked(sceneId)
	else
		if gone then
			closedRooms[sceneId] = true
		end
		local here = MapBuilder.current
		if here and closedRooms[here.sceneId] and workspace:FindFirstChild("Room") then
			-- the room we are in is gone too: never keep it; go to the default room or the lobby
			workspace:SetAttribute("SceneId", here.sceneId)
			task.spawn(Rooms.roomClosed, here.sceneId)
			return
		end
		World.toast(if gone then "That room was closed" else "Couldn't load " .. name .. ": " .. tostring(reason))
		if not MapBuilder.current or workspace:FindFirstChild("Room") == nil then
			info = MapBuilder.build(game:GetService("HttpService"):JSONDecode(Fixtures.MAP_SMALL))
			sceneId = "fixture-room"
		else
			-- keep the room we had
			local cur = MapBuilder.current
			sceneId = cur and cur.sceneId or sceneId
			info = cur
		end
	end
	if mySwitch ~= switching or not info then
		return
	end
	workspace:SetAttribute("SceneId", sceneId)
	workspace:SetAttribute("RoomName", info.name)
	workspace:SetAttribute("HasImagined", (workspace:FindFirstChild("Room") :: any):GetAttribute("HasImagined") == true)
	workspace:SetAttribute("Phase", "room")
	if moveRoom then
		World.toRoom(previousRoomPlayers)
	end
	World.holdRoomPlayers(false)
	local joinLobby = o.joinLobby
	if joinLobby == nil then
		joinLobby = workspace:GetAttribute("AutoJoin") == true
	end
	if joinLobby then
		Rooms.joinAll(true)
	end
	if Rooms.onRoomReady then
		Rooms.onRoomReady(joinLobby == true)
	end
	publishBoard()
end

-- Move every lobby player into the built room (with an optional 3-2-1).
function Rooms.joinAll(countdown: boolean?)
	if workspace:GetAttribute("Phase") ~= "room" then
		return
	end
	local lobby = {}
	for _, p in Players:GetPlayers() do
		if World.where(p) ~= "room" then
			table.insert(lobby, p)
		end
	end
	if #lobby == 0 then
		return
	end
	local scene = workspace:GetAttribute("SceneId")
	if countdown then
		World.Moment:FireAllClients({ type = "countdown", seconds = 3, text = "MOVING IN" })
		task.wait(3)
		if workspace:GetAttribute("SceneId") ~= scene or workspace:GetAttribute("Phase") ~= "room" then
			return
		end
	end
	World.toRoom(lobby)
end

function Rooms.joinOne(player: Player)
	if workspace:GetAttribute("Phase") == "room" and World.where(player) ~= "room" then
		World.toRoom({ player })
	end
end

-- Everyone back to the lobby, with no room loaded.
local function closeToLobby()
	if Rooms.onSwitchStart then
		Rooms.onSwitchStart()
	end
	World.holdRoomPlayers(false)
	for _, p in Players:GetPlayers() do
		if World.where(p) == "room" then
			World.toLobby(p)
		end
	end
	MapBuilder.clear()
	workspace:SetAttribute("SceneId", "")
	workspace:SetAttribute("RoomName", "")
	workspace:SetAttribute("HasImagined", false)
	workspace:SetAttribute("Phase", "lobby")
end

-- The server answered 404 for the room we are in (archived or deleted): not a connection problem, so no
-- "Reconnecting" banner. Toast it, move everyone to Config.DEFAULT_SCENE (the lobby if that fails too) and refresh
-- the room list. Only for the room that is built (a room still loading is handled by its switch) and never for the
-- fixture room, which the server does not know by design.
function Rooms.roomClosed(sceneId: string)
	local cur = MapBuilder.current
	if closing or sceneId == "fixture-room" or not (cur and cur.sceneId == sceneId) then
		return
	end
	closing = true
	local ok, err = pcall(function()
		closedRooms[sceneId] = true
		cache[sceneId] = nil
		modelInfos[sceneId] = nil
		if workspace:GetAttribute("Banner") == "Reconnecting to Déjà View..." then
			workspace:SetAttribute("Banner", "")
		end
		workspace:SetAttribute("Offline", false)
		World.toast("That room was closed")
		warn("[DejaView] room " .. sceneId .. " was closed on the server")
		pcall(refreshList)
		local target = Config.DEFAULT_SCENE
		local okTarget = target ~= "" and target ~= sceneId and not closedRooms[target] and playable(sceneById(target))
		local before = switching
		if okTarget then
			local okSwitch, errSwitch = pcall(Rooms.switchTo, target, { moveRoom = true })
			if not okSwitch then
				warn("[DejaView] could not open " .. target .. ":", errSwitch)
			end
		end
		-- a newer switch (a vote, the judge) took over meanwhile: leave it alone
		local superseded = switching > before + (if okTarget then 1 else 0)
		local arrived = okTarget and workspace:GetAttribute("SceneId") == target and workspace:GetAttribute("Phase") == "room"
		if not superseded and not arrived then
			closeToLobby()
		end
		publishBoard()
	end)
	closing = false
	if not ok then
		warn("[DejaView] closing room " .. sceneId .. " failed:", err)
	end
end

function Rooms.vote(player: Player, sceneId: string)
	if type(sceneId) ~= "string" or not sceneById(sceneId) then
		return
	end
	local s = sceneById(sceneId)
	if isVideo(s) then
		World.toast("Video memories live in the headset only", player)
		return
	end
	if s.status ~= "ready" then
		World.toast("That room is still building", player)
		return
	end
	if sceneId == workspace:GetAttribute("SceneId") and workspace:GetAttribute("Phase") ~= "loading" then
		Rooms.joinOne(player)
		return
	end
	if World.isHost(player) then
		task.spawn(Rooms.switchTo, sceneId)
		return
	end
	votes[player] = sceneId
	local count, total = 0, #Players:GetPlayers()
	for p, v in votes do
		if p.Parent and v == sceneId then
			count += 1
		end
	end
	World.toast(player.DisplayName .. " voted for " .. (s.name or sceneId) .. " (" .. count .. "/" .. total .. ")")
	if count > total / 2 then
		task.spawn(Rooms.switchTo, sceneId)
	end
end

-- The judge is in sceneId (from presence.active, or a vr person in that room).
local function judgeIn(sceneId: string?)
	if judgeScene ~= sceneId then
		judgeScene = sceneId
		publishBoard()
	end
	if not sceneId or sceneId == workspace:GetAttribute("SceneId") then
		lastFollowed = sceneId
		return
	end
	if workspace:GetAttribute("Follow") ~= true or lastFollowed == sceneId then
		return
	end
	local s = sceneById(sceneId)
	if not playable(s) then
		return -- not a Roblox room (a video memory, or still building)
	end
	lastFollowed = sceneId
	World.toast("Judge entered " .. (s.name or sceneId))
	task.spawn(function()
		local anyoneInRoom = #World.inRoom() > 0
		if anyoneInRoom then
			World.Moment:FireAllClients({ type = "countdown", seconds = 3, text = "FOLLOWING THE JUDGE" })
			task.wait(3)
		end
		-- lobby players stay in the lobby until JOIN
		Rooms.switchTo(sceneId, { moveRoom = true, joinLobby = false })
	end)
end

function Rooms.onActive(active: any)
	activeSeenAt = os.clock()
	-- Where the judge is, even when it is not a Roblox room (the game-night video): the lobby board shows it.
	local name = if type(active) == "table" then (active.name or (sceneById(active.sceneId or "") or {}).name or "") else ""
	if workspace:GetAttribute("JudgeRoom") ~= name then
		workspace:SetAttribute("JudgeRoom", name)
	end
	if type(active) == "table" and type(active.sceneId) == "string" then
		judgeIn(active.sceneId)
	end
end

function Rooms.onJudgeHere(here: boolean)
	if here and os.clock() - activeSeenAt > 5 then
		judgeIn(workspace:GetAttribute("SceneId"))
	end
end

function Rooms.newestReady(): string?
	if Config.DEFAULT_SCENE ~= "" and sceneById(Config.DEFAULT_SCENE) then
		return Config.DEFAULT_SCENE
	end
	for _, s in list do
		if playable(s) then
			return s.id
		end
	end
	return nil
end

-- Something to stand in when Déjà View cannot be reached: the first baked room, else the fixture room.
function Rooms.loadFallback()
	local baked = game:GetService("ServerStorage"):FindFirstChild("BakedRooms")
	local first = baked and baked:GetChildren()[1]
	local info = if first then MapBuilder.buildBaked(first.Name) else nil
	if not info then
		info = MapBuilder.build(HttpService:JSONDecode(Fixtures.MAP_SMALL))
	end
	if not info then
		return
	end
	workspace:SetAttribute("SceneId", info.sceneId)
	workspace:SetAttribute("RoomName", info.name)
	workspace:SetAttribute("Phase", "room")
	if workspace:GetAttribute("AutoJoin") == true then
		Rooms.joinAll(true)
	end
	publishBoard()
end

function Rooms.isListLoaded(): boolean
	return listLoaded
end

function Rooms.waitForList(timeout: number)
	local t0 = os.clock()
	while not listLoaded and os.clock() - t0 < timeout do
		task.wait(0.25)
	end
	return listLoaded
end

function Rooms.start()
	task.spawn(function()
		while true do
			local started = os.clock()
			local ok, err = pcall(function()
				refreshList()
				-- Follow fallback: no `active` field lately -> check the newest other ready room.
				if os.clock() - activeSeenAt > 5 then
					local other = newestReadyOther()
					if other then
						local okP, res = Backend.people(other)
						if okP and type(res) == "table" and type(res.people) == "table" then
							for _, person in res.people do
								if person.kind == "vr" then
									judgeIn(other)
									break
								end
							end
						end
					end
				end
				prefetchOne()
				publishBoard()
			end)
			if not ok then
				warn("[DejaView] rooms loop:", err)
			end
			task.wait(math.max(0.2, Config.ROOMS_PERIOD - (os.clock() - started)))
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		votes[p] = nil
	end)
end

return Rooms
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Stats</string>
          <string name="Source"><![CDATA[-- Hall of fame and badges (team/shivin.md Update 6, items 2 and 3). Wins per player per game live in DataStores so
-- they last across sessions; the lobby shows the top 5 of each game. Badges are in-game: a card pops up the first time
-- a player earns one, and the set is saved with their stats. Without DataStore access (Studio with API access off)
-- everything still works for the session.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local World = require(script.Parent.World)
local Theme = require(ReplicatedStorage.Shared.Theme)

local Stats = {}

Stats.GAMES = { "tag", "chess", "pingpong", "foosball", "hideseek", "lava", "cooking" }
local GAME_TITLE = { tag = "TAG", chess = "CHESS", pingpong = "PING PONG", foosball = "FOOSBALL", hideseek = "HIDE & SEEK",
	lava = "FLOOR IS LAVA", cooking = "COOKING" }

Stats.BADGES = {
	memory = "Walked into a memory",
	judge = "Tag with the judge",
	checkmate = "Checkmate",
	court = "21 at the Game Lawn",
}

local profileStore: DataStore? = nil
local winStores: { [string]: OrderedDataStore } = {}
local online = true

local profiles: { [number]: any } = {} -- userId -> { name, wins = {}, badges = {} }
local sessionWins: { [string]: { [number]: number } } = {} -- fallback when DataStores are off
local names: { [number]: string } = {}
local board: Frame? = nil

local function init()
	local ok = pcall(function()
		profileStore = DataStoreService:GetDataStore("DejaViewProfiles")
		for _, g in Stats.GAMES do
			winStores[g] = DataStoreService:GetOrderedDataStore("DejaViewWins_" .. g)
		end
	end)
	online = ok
	for _, g in Stats.GAMES do
		sessionWins[g] = {}
	end
end

local function save(userId: number)
	local data = profiles[userId]
	if not data or not online or not profileStore then
		return
	end
	task.spawn(pcall, function()
		(profileStore :: DataStore):SetAsync("u" .. userId, data)
	end)
end

local function load(player: Player)
	-- A profile exists at once, so badges and wins never wait on the DataStore (it can hang, e.g. in Studio).
	local data = { name = player.DisplayName, wins = {}, badges = {} }
	profiles[player.UserId] = data
	names[player.UserId] = player.DisplayName
	local fetched, saved = false, nil
	if online and profileStore then
		task.spawn(function()
			local ok, res = pcall(function()
				return (profileStore :: DataStore):GetAsync("u" .. player.UserId)
			end)
			if ok then
				saved = res
			else
				online = false -- no DataStore access: stay in session mode
			end
			fetched = true
		end)
	else
		fetched = true
	end
	-- wait briefly for saved data, then merge it in (wins and badges are unions)
	local t0 = os.clock()
	while not fetched and os.clock() - t0 < 5 do
		task.wait(0.2)
	end
	if type(saved) == "table" then
		for k, v in saved.wins or {} do
			data.wins[k] = math.max(data.wins[k] or 0, v)
		end
		for k, v in saved.badges or {} do
			data.badges[k] = data.badges[k] or v
		end
		data.seenIntro = saved.seenIntro
	end
	print("[Stats] profile", player.DisplayName, if type(saved) == "table" then "loaded" elseif fetched then "new" else "not loaded (timeout)")
	-- First-join controls card (Update 6 item 5), once per player
	if not data.seenIntro and player.Parent then
		data.seenIntro = os.time()
		save(player.UserId)
		print("[Stats] controls card ->", player.DisplayName, "(saved stats:", online, ")")
		World.Moment:FireClient(player, { type = "intro" })
	end
end

local function nameFor(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, n = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	names[userId] = if ok and n then n else ("Player " .. userId)
	return names[userId]
end

local function topFive(gameKey: string): { { name: string, wins: number } }
	local rows = {}
	if online and winStores[gameKey] then
		local ok, pages = pcall(function()
			return winStores[gameKey]:GetSortedAsync(false, 5)
		end)
		if ok and pages then
			for _, entry in pages:GetCurrentPage() do
				table.insert(rows, { name = nameFor(tonumber(entry.key) or 0), wins = entry.value })
			end
			return rows
		end
	end
	for userId, wins in sessionWins[gameKey] do
		table.insert(rows, { name = nameFor(userId), wins = wins })
	end
	table.sort(rows, function(a, b)
		return a.wins > b.wins
	end)
	while #rows > 5 do
		table.remove(rows)
	end
	return rows
end

function Stats.refreshBoard()
	if not board then
		return
	end
	task.spawn(function()
		for _, g in Stats.GAMES do
			local col = (board :: Frame):FindFirstChild(g)
			if col then
				local rows = topFive(g)
				for i = 1, 5 do
					local label = col:FindFirstChild("Row" .. i) :: TextLabel?
					if label then
						local r = rows[i]
						label.Text = if r then string.format("%d. %s · %d", i, r.name, r.wins) else ""
					end
				end
			end
		end
	end)
end

-- A win for a real player in one of Stats.GAMES.
function Stats.win(player: Player?, gameKey: string)
	if not player or not player.Parent or not sessionWins[gameKey] then
		return
	end
	local id = player.UserId
	sessionWins[gameKey][id] = (sessionWins[gameKey][id] or 0) + 1
	local data = profiles[id]
	if data then
		data.wins[gameKey] = (data.wins[gameKey] or 0) + 1
		save(id)
	end
	if online and winStores[gameKey] then
		task.spawn(pcall, function()
			winStores[gameKey]:IncrementAsync(tostring(id), 1)
		end)
	end
	task.delay(1, Stats.refreshBoard)
end

-- Awards an in-game badge once per player (shows a card on their screen).
function Stats.badge(player: Player?, key: string)
	if not player or not player.Parent or not Stats.BADGES[key] then
		return
	end
	local data = profiles[player.UserId]
	if not data or data.badges[key] then
		return
	end
	data.badges[key] = os.time()
	save(player.UserId)
	print("[Stats] badge", key, "->", player.DisplayName)
	World.Moment:FireClient(player, { type = "badge", title = Stats.BADGES[key] })
end

local function buildBoard()
	local lobby = workspace:WaitForChild("Lobby", 30)
	if not lobby then
		return
	end
	local c = (lobby :: Model):GetPivot().Position
	local part = Instance.new("Part")
	part.Name = "HallOfFame"
	part.Anchored = true
	part.Size = Vector3.new(1, 16, 46)
	part.Color = Theme.Surface
	part.Material = Enum.Material.SmoothPlastic
	-- flat against the lobby's left wall (thin along X), its Right face looking into the room
	part.CFrame = CFrame.new(c.X - 39.4, c.Y + 9, c.Z)
	part.Parent = lobby
	local sg = Theme.make("SurfaceGui", { Face = Enum.NormalId.Right, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 24, LightInfluence = 0, Parent = part })
	local root = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg, Parent = sg },
		{ Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 24), PaddingRight = UDim.new(0, 24), PaddingTop = UDim.new(0, 18) }) })
	Theme.label({ Text = "HALL OF FAME", FontFace = Theme.Heading, TextColor3 = Theme.Accent, Size = UDim2.new(1, 0, 0, 56),
		MaxText = 56, Parent = root })
	local grid = Theme.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 70), Size = UDim2.new(1, 0, 1, -90),
		Parent = root }, { Theme.make("UIGridLayout", { CellSize = UDim2.new(0.135, 0, 1, 0), CellPadding = UDim2.new(0.009, 0, 0, 0),
		SortOrder = Enum.SortOrder.LayoutOrder }) })
	for i, g in Stats.GAMES do
		local col = Theme.make("Frame", { Name = g, BackgroundColor3 = Theme.Surface, LayoutOrder = i, Parent = grid },
			{ Theme.corner(14), Theme.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingTop = UDim.new(0, 10) }),
			  Theme.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
		Theme.label({ Text = GAME_TITLE[g], FontFace = Theme.Heading, Size = UDim2.new(1, -12, 0, 36), MaxText = 30,
			LayoutOrder = 0, Parent = col })
		for r = 1, 5 do
			Theme.label({ Name = "Row" .. r, Text = "", TextColor3 = if r == 1 then Theme.Accent else Theme.Text,
				Size = UDim2.new(1, -12, 0, 30), MaxText = 24, LayoutOrder = r, Parent = col })
		end
	end
	board = root
	Stats.refreshBoard()
end

function Stats.start()
	init()
	Players.PlayerAdded:Connect(load)
	for _, p in Players:GetPlayers() do
		task.spawn(load, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		save(p.UserId)
		profiles[p.UserId] = nil
	end)
	task.spawn(buildBoard)
	task.spawn(function()
		while true do
			task.wait(60)
			Stats.refreshBoard()
		end
	end)
end

return Stats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">TagGame</string>
          <string name="Source"><![CDATA[-- Tag rounds; this server is the referee (team/shivin.md 7.5).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local Backend = require(script.Parent.Backend)
local MapBuilder = require(script.Parent.MapBuilder)
local Presence = require(script.Parent.Presence)
local World = require(script.Parent.World)
local Interp = require(ReplicatedStorage.Shared.Interp)
local Stats = require(script.Parent.Stats)

local TagGame = {}

type Runner = { player: Player, id: string, name: string, lives: number, immuneUntil: number, lastTag: number }

local state = "idle" -- idle | countdown | playing | ended
local runners: { [Player]: Runner } = {}
local vrTags = 0
local vrId = "quest-1"
local vrName = "Judge"
local endsAt = 0
local roundId = 0

local function now()
	return workspace:GetServerTimeNow()
end

local function scores(): { [string]: number }
	local s: { [string]: number } = { [vrId] = vrTags }
	for _, r in runners do
		s[r.id] = r.lives
	end
	return s
end

local function publish()
	local list = {}
	for _, r in runners do
		table.insert(list, { id = r.id, name = r.name, lives = r.lives, out = r.lives <= 0,
			immune = r.immuneUntil > now() })
	end
	table.sort(list, function(a, b)
		return a.name < b.name
	end)
	workspace:SetAttribute("ScoresJson", HttpService:JSONEncode({ vrName = vrName, vrTags = vrTags, runners = list }))
end

local function setState(s: string)
	state = s
	workspace:SetAttribute("RoundState", s)
end

function TagGame.stateOf(player: Player): string?
	local r = runners[player]
	if not r or state ~= "playing" then
		return nil
	end
	if r.lives <= 0 then
		return "out"
	elseif r.immuneUntil > now() then
		return "caught"
	end
	return "playing"
end

function TagGame.isPlaying(): boolean
	return state == "playing" or state == "countdown"
end

local function addRunner(p: Player)
	if runners[p] then
		return
	end
	runners[p] = { player = p, id = "rbx-" .. p.UserId, name = p.DisplayName, lives = Config.LIVES,
		immuneUntil = now() + Config.IMMUNITY, lastTag = now() }
end

local function shield(p: Player, seconds: number)
	local ch = p.Character
	if not ch then
		return
	end
	local ff = Instance.new("ForceField")
	ff.Visible = true
	ff.Parent = ch
	task.delay(seconds, function()
		ff:Destroy()
	end)
end

local function restore(p: Player)
	p:SetAttribute("Out", false)
	if World.where(p) == "room" and p.Character and MapBuilder.current then
		World.setAnchored(p.Character, false)
		MapBuilder.place(p.Character, math.random(1, 9))
	end
end

function TagGame.finish(winner: string?)
	if state ~= "playing" and state ~= "countdown" then
		return
	end
	local wasPlaying = state == "playing"
	roundId += 1
	local list = {}
	for _, r in runners do
		table.insert(list, r)
	end
	local survivors = 0
	for _, r in list do
		if r.lives > 0 then
			survivors += 1
		end
	end
	winner = winner or (if survivors > 0 then "roblox" else "vr")
	table.sort(list, function(a, b)
		if a.lives ~= b.lives then
			return a.lives > b.lives
		end
		return a.lastTag < b.lastTag -- longest since their last tag
	end)
	local mvp = list[1]
	if wasPlaying and winner == "roblox" and mvp then
		Stats.win(mvp.player, "tag") -- the MVP of a surviving team takes the tag win
	end
	local sceneId = workspace:GetAttribute("SceneId")
	if wasPlaying and type(sceneId) == "string" then
		Backend.sendEvent(sceneId, { type = "round", state = "end", scores = scores(), winner = winner,
			mvp = mvp and mvp.id or nil, mvpName = mvp and mvp.name or nil })
	end
	setState("ended")
	workspace:SetAttribute("RoundEndsAt", 0)
	World.Moment:FireAllClients({
		type = "winner",
		title = if winner == "vr" then "THE JUDGE WINS" else "ROBLOX SURVIVES",
		mvp = if winner == "vr" then vrName .. " · " .. vrTags .. " tags" else (mvp and ("MVP " .. mvp.name) or ""),
	})
	publish()
	local myRound = roundId
	task.delay(5, function()
		if roundId ~= myRound then
			return
		end
		setState("idle")
		for p in runners do
			if p.Parent then
				restore(p)
			end
		end
	end)
end

function TagGame.abort()
	if state == "idle" then
		return
	end
	roundId += 1
	setState("idle")
	workspace:SetAttribute("RoundEndsAt", 0)
	for p in runners do
		if p.Parent then
			p:SetAttribute("Out", false)
		end
	end
end

-- Returns false (and toasts) when there is no headset.
function TagGame.start(by: Player?): boolean
	if state == "countdown" or state == "playing" then
		return false
	end
	local vr = Presence.vr()
	if not vr then
		World.toast("Waiting for the headset...", by)
		return false
	end
	if #World.inRoom() == 0 then
		World.toast("Nobody is in the room yet: press JOIN", by)
		return false
	end
	roundId += 1
	local myRound = roundId
	vrId, vrName, vrTags = vr.id, vr.name, 0
	runners = {}
	for _, p in World.inRoom() do
		addRunner(p)
		p:SetAttribute("Out", false)
	end
	setState("countdown")
	workspace:SetAttribute("CountdownEndsAt", now() + Config.COUNTDOWN)
	World.Moment:FireAllClients({ type = "countdown", seconds = Config.COUNTDOWN, text = "TAG: THE JUDGE IS IT" })
	publish()
	task.delay(Config.COUNTDOWN, function()
		if roundId ~= myRound then
			return
		end
		local duration = Config.roundSeconds()
		endsAt = now() + duration
		for _, r in runners do
			r.immuneUntil = now() + Config.IMMUNITY
			r.lastTag = now()
			shield(r.player, Config.IMMUNITY)
		end
		setState("playing")
		for _, r in runners do
			Stats.badge(r.player, "judge")
		end
		workspace:SetAttribute("RoundEndsAt", endsAt)
		workspace:SetAttribute("RoundIt", vrName)
		World.Moment:FireAllClients({ type = "roundStart", it = vrName, duration = duration })
		local sceneId = workspace:GetAttribute("SceneId")
		if type(sceneId) == "string" then
			Backend.sendEvent(sceneId, { type = "round", state = "start", scores = scores(), duration = duration, it = vrId })
		end
		publish()
	end)
	return true
end

local function tag(r: Runner)
	local t = now()
	r.lives -= 1
	r.immuneUntil = t + Config.IMMUNITY
	r.lastTag = t
	vrTags += 1
	local hrp = r.player.Character and r.player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	World.Moment:FireAllClients({ type = "tagged", userId = r.player.UserId, name = r.name,
		pos = hrp and hrp.Position or Vector3.zero, lives = r.lives })
	local sceneId = workspace:GetAttribute("SceneId")
	if type(sceneId) == "string" then
		Backend.sendEvent(sceneId, { type = "tag", by = vrId, target = r.id, targetName = r.name, livesLeft = r.lives })
	end
	if r.lives <= 0 then
		-- Spectator: park out of the room (the judge stops seeing them), camera follows the ghost.
		r.player:SetAttribute("Out", true)
		local ch = r.player.Character
		if ch then
			ch:PivotTo(CFrame.new(Config.LOBBY_CENTER + Vector3.new(0, 4, 20)))
		end
	else
		task.delay(0.4, function()
			local ch = r.player.Character
			if ch and state == "playing" then
				MapBuilder.place(ch, math.random(1, 9))
				shield(r.player, Config.IMMUNITY - 0.4)
			end
		end)
	end
	publish()
end

local function check()
	if state ~= "playing" then
		return
	end
	local t = now()
	if t >= endsAt then
		TagGame.finish()
		return
	end
	local anyAlive = false
	for p, r in runners do
		if not p.Parent then
			runners[p] = nil
		elseif r.lives > 0 then
			anyAlive = true
		end
	end
	if not anyAlive then
		TagGame.finish("vr")
		return
	end
	-- late joiners into the room get 3 lives
	for _, p in World.inRoom() do
		if not runners[p] then
			addRunner(p)
			publish()
		end
	end
	local vr = Presence.people[vrId] or Presence.vr()
	if not vr then
		return
	end
	local s = Interp.sample(vr.buf, t - Interp.DELAY, t)
	if not s or s.age > Interp.STALE then
		return
	end
	local changed = false
	for p, r in runners do
		if r.lives > 0 and r.immuneUntil <= t and World.where(p) == "room" then
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if hrp then
				local pos = hrp.Position
				local hit = false
				if s.hl or s.hr then
					hit = (s.hl ~= nil and (s.hl - pos).Magnitude <= Config.TAG_RADIUS)
						or (s.hr ~= nil and (s.hr - pos).Magnitude <= Config.TAG_RADIUS)
				else
					local d = Vector3.new(pos.X - s.pos.X, 0, pos.Z - s.pos.Z)
					hit = d.Magnitude <= Config.TAG_RADIUS
				end
				if hit then
					tag(r)
					changed = true
				end
			end
		end
	end
	if changed then
		publish()
	end
end

function TagGame.start10Hz()
	setState("idle")
	task.spawn(function()
		while true do
			task.wait(1 / Config.TAG_CHECK_HZ)
			local ok, err = pcall(check)
			if not ok then
				warn("[DejaView] tag check error:", err)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		runners[p] = nil
	end)
end

return TagGame
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">TransportTest</string>
          <string name="Source"><![CDATA[-- One-shot transport test: fetch /api/scenes and /api/big from BASE and print sizes and timings.
-- Run from the server console (F9 -> Server): require(game.ServerScriptService.DejaView.TransportTest)()
local HttpService = game:GetService("HttpService")
local Config = require(script.Parent.Config)

return function(base: string?)
	base = base or Config.base()
	for _, path in { "/api/scenes", "/api/big" } do
		local t0 = os.clock()
		local ok, res = pcall(HttpService.RequestAsync, HttpService, { Url = base .. path, Method = "GET" })
		if not ok then
			warn("[TransportTest]", path, "FAILED:", res)
			continue
		end
		local okJson, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
		local count = if okJson and type(data) == "table" then (if data.parts then #data.parts else #data) else "?"
		print(string.format("[TransportTest] %s -> %d, %d bytes, %s items, %.2fs", path, res.StatusCode, #res.Body,
			tostring(count), os.clock() - t0))
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Lobby, player locations (lobby vs room), host checks and the Moment remote.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(script.Parent.Config)
local MapBuilder = require(script.Parent.MapBuilder)
local Theme = require(ReplicatedStorage.Shared.Theme)

local World = {}

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
World.Moment = Remotes:WaitForChild("Moment") :: RemoteEvent

local firstPlayer: Player? = nil
local lobbySpawn: SpawnLocation? = nil

function World.toast(text: string, target: Player?)
	if target then
		World.Moment:FireClient(target, { type = "toast", text = text })
	else
		World.Moment:FireAllClients({ type = "toast", text = text })
	end
end

function World.isHost(player: Player): boolean
	if table.find(Config.HOST_USER_IDS, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroupAsync, player, game.CreatorId)
		if ok and rank >= 255 then
			return true
		end
	end
	return (RunService:IsStudio() or game.CreatorId == 0) and player == firstPlayer
end

function World.where(player: Player): string
	return (player:GetAttribute("Where") :: string?) or "lobby"
end

function World.inRoom(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		if World.where(p) == "room" then
			table.insert(list, p)
		end
	end
	return list
end

local function setAnchored(character: Model?, anchored: boolean)
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		hrp.Anchored = anchored
	end
end
World.setAnchored = setAnchored

function World.toLobby(player: Player)
	player:SetAttribute("Where", "lobby")
	local character = player.Character
	if character and lobbySpawn then
		setAnchored(character, false)
		character:PivotTo(lobbySpawn.CFrame + Vector3.new(math.random(-6, 6), 4, math.random(-2, 2)))
	end
end

World.onEnterRoom = nil :: ((Player) -> ())?

-- Moves players into the built room around spawn.
function World.toRoom(list: { Player })
	for i, player in list do
		player:SetAttribute("Where", "room")
		if World.onEnterRoom then
			task.spawn(World.onEnterRoom :: any, player)
		end
		local character = player.Character
		if character and MapBuilder.current then
			MapBuilder.place(character, i)
			setAnchored(character, workspace:GetAttribute("Phase") ~= "room")
		end
	end
end

-- Hold everyone in the room in place while a new room builds.
function World.holdRoomPlayers(anchored: boolean)
	for _, p in World.inRoom() do
		setAnchored(p.Character, anchored)
	end
end

local function buildLobby()
	local c = Config.LOBBY_CENTER
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"
	local function part(name, size, pos, color, material, props)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = CFrame.new(c + pos)
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		for k, v in props or {} do
			(p :: any)[k] = v
		end
		p.Parent = lobby
		return p
	end
	part("Floor", Vector3.new(80, 2, 70), Vector3.new(0, -1, 0), Theme.Bg)
	part("Trim", Vector3.new(80, 0.2, 0.6), Vector3.new(0, 0.1, -12), Theme.Accent, Enum.Material.Neon)
	for _, side in { -1, 1 } do
		part("Wall", Vector3.new(2, 30, 70), Vector3.new(side * 41, 15, 0), Theme.Surface)
	end
	part("Back", Vector3.new(80, 30, 2), Vector3.new(0, 15, 36), Theme.Surface)
	part("Front", Vector3.new(80, 30, 2), Vector3.new(0, 15, -36), Theme.Surface)
	part("Roof", Vector3.new(84, 2, 74), Vector3.new(0, 31, 0), Theme.Bg, nil, { Transparency = 0.2 })
	-- The board faces +Z (towards the spawn). The client puts a SurfaceGui on it.
	local board = part("Board", Vector3.new(40, 20, 1), Vector3.new(0, 11, -14), Theme.Surface)
	board.CFrame = CFrame.new(c + Vector3.new(0, 11, -14)) * CFrame.Angles(0, math.pi, 0)
	local light = Instance.new("PointLight")
	light.Color = Theme.Accent
	light.Range = 40
	light.Brightness = 1
	light.Parent = board

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(c + Vector3.new(0, 0.5, 12))
	spawn.Color = Theme.Bg
	spawn.Transparency = 1
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = lobby
	lobbySpawn = spawn

	-- Remove the template Baseplate/SpawnLocation if the place still has them.
	for _, name in { "Baseplate", "SpawnLocation" } do
		local x = workspace:FindFirstChild(name)
		if x and x:IsA("BasePart") then
			x:Destroy()
		end
	end
	lobby.Parent = workspace
end

local function onCharacter(player: Player, character: Model)
	local hum = character:WaitForChild("Humanoid") :: Humanoid
	hum.WalkSpeed = Config.WALK_SPEED
	task.defer(function()
		if World.where(player) == "room" and MapBuilder.current and not player:GetAttribute("Out") then
			MapBuilder.place(character, math.random(1, 9))
			setAnchored(character, workspace:GetAttribute("Phase") ~= "room")
		else
			if World.where(player) ~= "room" then
				player:SetAttribute("Where", "lobby")
			end
			-- Late joiners: with Auto-join on and a room already built, send them straight in.
			if player:GetAttribute("JoinedOnce") ~= true then
				player:SetAttribute("JoinedOnce", true)
				task.wait(1.5)
				if player.Parent and character.Parent and World.where(player) ~= "room"
					and workspace:GetAttribute("AutoJoin") == true and workspace:GetAttribute("Phase") == "room" then
					World.toRoom({ player })
				end
			end
		end
	end)
end

function World.init()
	buildLobby()
	local function added(player: Player)
		firstPlayer = firstPlayer or player
		player:SetAttribute("Where", "lobby")
		player:SetAttribute("IsHost", World.isHost(player))
		player.CharacterAdded:Connect(function(ch)
			onCharacter(player, ch)
		end)
		if player.Character then
			onCharacter(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(added)
	for _, p in Players:GetPlayers() do
		added(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		if player == firstPlayer then
			firstPlayer = Players:GetPlayers()[1]
			if firstPlayer == player then
				firstPlayer = Players:GetPlayers()[2]
			end
			for _, p in Players:GetPlayers() do
				p:SetAttribute("IsHost", World.isHost(p))
			end
		end
	end)

	-- Fall guard: anyone below the room falls back to spawn; lobby fallers back to the lobby.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, p in Players:GetPlayers() do
				local ch = p.Character
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hrp and not hrp.Anchored then
					local y = hrp.Position.Y
					if World.where(p) == "room" and not p:GetAttribute("Out") then
						if y < Config.FALL_Y then
							MapBuilder.place(ch :: Model, 1)
						end
					elseif y < Config.LOBBY_CENTER.Y - 20 then
						World.toLobby(p)
					end
				end
			end
		end
	end)
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">WorldGames</string>
          <string name="Source"><![CDATA[-- A game per world (team/shivin.md Update 9, item 2), each playable in any room:
--   hide and seek (the apartment): the judge seeks (or a random player), the rest hide, then get found.
--   floor is lava (Tilted Towers): when the floor turns to lava, anyone standing on it is out; last ones standing win.
--   cooking rush (the kitchen): ingredients appear on the real counters; carry them to the stove before time runs out.
-- Shared: RoundState = "game", RoundEndsAt for the timer, GameJson for the scoreboard, a winner card at the end and
-- {type:"game", game, winner, score} sent to the server.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Backend = require(script.Parent.Backend)
local MapBuilder = require(script.Parent.MapBuilder)
local Presence = require(script.Parent.Presence)
local Stats = require(script.Parent.Stats)
local World = require(script.Parent.World)
local Interp = require(ReplicatedStorage.Shared.Interp)
local Theme = require(ReplicatedStorage.Shared.Theme)

local WorldGames = {}

local current: string? = nil -- "hideseek" | "lava" | "cooking"
local round = 0
local folder: Folder? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

local function hrpOf(p: Player): BasePart?
	return p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function publish(title: string, rows: { { name: string, right: string, hi: boolean? } })
	workspace:SetAttribute("GameJson", HttpService:JSONEncode({ title = title, rows = rows }))
end

local function gameFolder(): Folder?
	local room = workspace:FindFirstChild("Room")
	if not room then
		return nil
	end
	local f = Instance.new("Folder")
	f.Name = "WorldGame"
	f.Parent = room
	return f
end

function WorldGames.active(): boolean
	return current ~= nil
end

function WorldGames.stop()
	round += 1
	current = nil
	if folder then
		folder:Destroy()
		folder = nil
	end
	for _, p in Players:GetPlayers() do
		local hrp = hrpOf(p)
		if hrp and hrp.Anchored and World.where(p) == "room" then
			hrp.Anchored = false
		end
	end
	World.Moment:FireAllClients({ type = "blind", on = false })
	if workspace:GetAttribute("RoundState") == "game" then
		workspace:SetAttribute("RoundState", "idle")
	end
	workspace:SetAttribute("RoundEndsAt", 0)
end

local function finish(gameKey: string, title: string, sub: string, winners: { Player }, score: string, winnerName: string)
	local myRound = round
	current = nil
	workspace:SetAttribute("RoundState", "ended")
	workspace:SetAttribute("RoundEndsAt", 0)
	World.Moment:FireAllClients({ type = "blind", on = false })
	World.Moment:FireAllClients({ type = "winner", title = title, mvp = sub })
	for _, p in winners do
		Stats.win(p, gameKey)
	end
	local sceneId = workspace:GetAttribute("SceneId")
	if type(sceneId) == "string" then
		Backend.sendEvent(sceneId, { type = "game", game = gameKey, winner = winnerName, score = score })
	end
	task.delay(5, function()
		if round == myRound then
			WorldGames.stop()
		end
	end)
end

local function begin(key: string, seconds: number): number
	WorldGames.stop()
	round += 1
	current = key
	folder = gameFolder()
	workspace:SetAttribute("RoundState", "game")
	workspace:SetAttribute("RoundEndsAt", now() + seconds)
	return round
end

------------------------------------------------------------------ hide and seek

local HIDE_SECONDS, SEEK_SECONDS, CATCH = 20, 90, 5

function WorldGames.hideAndSeek(by: Player?): boolean
	local players = World.inRoom()
	local vr = Presence.vr()
	if #players < (if vr then 1 else 2) then
		World.toast("Hide and seek needs " .. (if vr then "someone in the room" else "two players (or the judge)"), by)
		return false
	end
	local seeker: Player? = nil
	if not vr then
		seeker = players[math.random(1, #players)]
	end
	local hiders = {}
	for _, p in players do
		if p ~= seeker then
			hiders[p] = false -- not found yet
		end
	end
	local my = begin("hideseek", HIDE_SECONDS + SEEK_SECONDS)
	local seekerName = if seeker then seeker.DisplayName else (if vr then vr.name else "Judge")
	World.Moment:FireAllClients({ type = "countdown", seconds = 3, text = "HIDE! " .. string.upper(seekerName) .. " SEEKS" })
	if seeker then
		local hrp = hrpOf(seeker)
		if hrp then
			hrp.Anchored = true
		end
		World.Moment:FireClient(seeker, { type = "blind", on = true, text = "Count to " .. HIDE_SECONDS .. "… they're hiding" })
	end
	local function rows()
		local r = {}
		for p, found in hiders do
			table.insert(r, { name = p.DisplayName, right = if found then "FOUND" else "hiding", hi = not found })
		end
		return r
	end
	publish("HIDE & SEEK · " .. string.upper(seekerName), rows())
	task.spawn(function()
		task.wait(HIDE_SECONDS)
		if round ~= my then
			return
		end
		if seeker then
			local hrp = hrpOf(seeker)
			if hrp then
				hrp.Anchored = false
			end
			World.Moment:FireClient(seeker, { type = "blind", on = false })
		end
		World.Moment:FireAllClients({ type = "toast", text = string.upper(seekerName) .. " IS COMING" })
		local endsAt = now() + SEEK_SECONDS
		while round == my and now() < endsAt do
			task.wait(0.2)
			-- seeker positions: a Roblox seeker's root, or the headset's hands and feet
			local points = {}
			if seeker then
				local hrp = hrpOf(seeker)
				if hrp then
					table.insert(points, hrp.Position)
				end
			elseif vr then
				local t = now()
				local s = Interp.sample(vr.buf, t - Interp.DELAY, t)
				if s then
					table.insert(points, s.pos + Vector3.new(0, 3, 0))
					for _, h in { s.hl, s.hr } do
						if h then
							table.insert(points, h)
						end
					end
				end
			end
			local left = 0
			for p, found in hiders do
				local hrp = hrpOf(p)
				if not found and hrp and p.Parent then
					for _, pt in points do
						if (pt - hrp.Position).Magnitude <= CATCH then
							hiders[p] = true
							found = true
							World.Moment:FireAllClients({ type = "toast", text = string.upper(p.DisplayName) .. " WAS FOUND" })
							publish("HIDE & SEEK · " .. string.upper(seekerName), rows())
							break
						end
					end
				end
				if not found and p.Parent then
					left += 1
				end
			end
			if left == 0 then
				local n = 0
				for _ in hiders do
					n += 1
				end
				finish("hideseek", string.upper(seekerName) .. " FOUND EVERYONE", "in " .. math.floor(SEEK_SECONDS - (endsAt - now())) .. " s",
					if seeker then { seeker } else {}, n .. "/" .. n, seekerName)
				return
			end
		end
		if round ~= my then
			return
		end
		local survivors, total, found = {}, 0, 0
		for p, f in hiders do
			total += 1
			if f then
				found += 1
			elseif p.Parent then
				table.insert(survivors, p)
			end
		end
		local names = {}
		for _, p in survivors do
			table.insert(names, p.DisplayName)
		end
		finish("hideseek", "THE HIDERS WIN", table.concat(names, ", ") .. " stayed hidden", survivors, found .. "/" .. total,
			table.concat(names, ", "))
	end)
	return true
end

------------------------------------------------------------------ floor is lava

local LAVA_CYCLES = { { warn = 6, lava = 8 }, { warn = 5, lava = 10 }, { warn = 4, lava = 12 }, { warn = 3, lava = 14 } }

function WorldGames.lava(by: Player?): boolean
	local info = MapBuilder.current
	local players = World.inRoom()
	if not info or #players == 0 then
		World.toast("Walk into a room first", by)
		return false
	end
	local total = 0
	for _, c in LAVA_CYCLES do
		total += c.warn + c.lava
	end
	local my = begin("lava", total + 3)
	local floorY = info.spawn.Y
	local mn, mx = info.walkMin or info.boundsMin, info.walkMax or info.boundsMax
	local slab = Instance.new("Part")
	slab.Name = "Lava"
	slab.Anchored, slab.CanCollide, slab.CanQuery, slab.CanTouch = true, false, false, false
	slab.Material = Enum.Material.Neon
	slab.Color = Color3.fromRGB(255, 90, 30)
	slab.Size = Vector3.new(mx.X - mn.X, 0.5, mx.Z - mn.Z)
	slab.CFrame = CFrame.new((mn.X + mx.X) / 2, floorY + 0.3, (mn.Z + mx.Z) / 2)
	slab.Transparency = 1
	slab.Parent = folder
	Theme.make("PointLight", { Color = slab.Color, Range = 20, Brightness = 0, Parent = slab })
	local alive: { [Player]: boolean } = {}
	for _, p in players do
		alive[p] = true
	end
	local function rows()
		local r = {}
		for p, a in alive do
			table.insert(r, { name = p.DisplayName, right = if a then "ALIVE" else "OUT", hi = a })
		end
		return r
	end
	publish("FLOOR IS LAVA", rows())
	World.Moment:FireAllClients({ type = "countdown", seconds = 3, text = "FLOOR IS LAVA · GET OFF THE FLOOR" })
	task.spawn(function()
		task.wait(3)
		for i, c in LAVA_CYCLES do
			if round ~= my then
				return
			end
			-- warning: the floor glows
			World.Moment:FireAllClients({ type = "toast", text = "LAVA IN " .. c.warn .. " · CLIMB!" })
			slab.Transparency = 0.75
			task.wait(c.warn)
			if round ~= my then
				return
			end
			slab.Transparency = 0.15
			(slab:FindFirstChildOfClass("PointLight") :: PointLight).Brightness = 3
			local lavaEnds = os.clock() + c.lava
			while os.clock() < lavaEnds and round == my do
				task.wait(0.15)
				for p, a in alive do
					if a and p.Parent then
						local ch = p.Character
						local hrp = hrpOf(p)
						local hum = ch and ch:FindFirstChildOfClass("Humanoid")
						if hrp and hum then
							local feetY = hrp.Position.Y - (hum.HipHeight + hrp.Size.Y / 2)
							local onGround = hum.FloorMaterial ~= Enum.Material.Air
							if onGround and feetY < floorY + 1.0 then
								alive[p] = false
								World.Moment:FireAllClients({ type = "tagged", userId = p.UserId, name = p.DisplayName,
									pos = hrp.Position, lives = 0 })
								publish("FLOOR IS LAVA", rows())
							end
						end
					end
				end
			end
			slab.Transparency = 1
			(slab:FindFirstChildOfClass("PointLight") :: PointLight).Brightness = 0
			local left = 0
			for _, a in alive do
				if a then
					left += 1
				end
			end
			if left <= (if #players > 1 then 1 else 0) or i == #LAVA_CYCLES then
				break
			end
		end
		if round ~= my then
			return
		end
		local winners, names = {}, {}
		for p, a in alive do
			if a and p.Parent then
				table.insert(winners, p)
				table.insert(names, p.DisplayName)
			end
		end
		finish("lava", if #winners > 0 then "STILL STANDING" else "THE LAVA WINS",
			if #winners > 0 then table.concat(names, ", ") else "Nobody made it", winners,
			#winners .. "/" .. #players, if #winners > 0 then table.concat(names, ", ") else "lava")
	end)
	return true
end

------------------------------------------------------------------ cooking rush

local COOK_SECONDS = 90
local INGREDIENTS = {
	{ "TOMATO", Color3.fromRGB(230, 60, 50) },
	{ "EGG", Color3.fromRGB(250, 245, 230) },
	{ "CHEESE", Color3.fromRGB(250, 200, 60) },
	{ "LETTUCE", Color3.fromRGB(110, 200, 90) },
	{ "BREAD", Color3.fromRGB(210, 160, 100) },
}

-- Counter tops: points 2.2 to 4.8 studs above the floor where a ray from above lands on an upward-facing surface.
local function counterSpots(info: any): { Vector3 }
	local room = workspace:FindFirstChild("Room")
	local spots, floorSpots = {}, {}
	if not room then
		return spots
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { room }
	local mn, mx = info.walkMin or info.boundsMin, info.walkMax or info.boundsMax
	local floorY = info.spawn.Y
	local top = math.min(info.ceilingY, floorY + 14)
	for x = mn.X + 2, mx.X - 2, 3 do
		for z = mn.Z + 2, mx.Z - 2, 3 do
			local hit = workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -(top - floorY + 2), 0), params)
			if hit and hit.Normal.Y > 0.8 then
				local h = hit.Position.Y - floorY
				if h >= 2.2 and h <= 4.8 then
					table.insert(spots, hit.Position)
				elseif h < 0.6 then
					table.insert(floorSpots, hit.Position)
				end
			end
		end
	end
	if #spots < 6 then
		-- no real counters found: fall back to the floor
		for _, p in floorSpots do
			table.insert(spots, p)
		end
	end
	return spots
end

function WorldGames.cooking(by: Player?): boolean
	local info = MapBuilder.current
	local players = World.inRoom()
	if not info or #players == 0 then
		World.toast("Walk into a room first", by)
		return false
	end
	local spots = counterSpots(info)
	if #spots < 4 then
		World.toast("No room to cook here", by)
		return false
	end
	local my = begin("cooking", COOK_SECONDS + 3)
	local f = folder :: Folder
	-- the stove: the spot nearest the room's middle
	local centre = (info.spawn + Vector3.new(0, 0, 0))
	table.sort(spots, function(a, b)
		return (a - centre).Magnitude < (b - centre).Magnitude
	end)
	local stovePos = spots[1]
	local stove = Instance.new("Part")
	stove.Name = "Stove"
	stove.Anchored, stove.CanCollide, stove.CanQuery, stove.CanTouch = true, false, false, false
	stove.Shape = Enum.PartType.Cylinder
	stove.Size = Vector3.new(0.3, 5, 5)
	stove.CFrame = CFrame.new(stovePos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	stove.Material = Enum.Material.Neon
	stove.Color = Color3.fromRGB(255, 120, 40)
	stove.Transparency = 0.3
	stove.Parent = f
	local sgui = Theme.make("BillboardGui", { Size = UDim2.fromOffset(160, 44), StudsOffset = Vector3.new(0, 3, 0),
		AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 160, Parent = stove })
	Theme.label({ Text = "STOVE", FontFace = Theme.Heading, TextColor3 = Color3.fromRGB(255, 140, 60),
		TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Size = UDim2.fromScale(1, 1),
		MaxText = 34, Parent = sgui })
	local scores: { [Player]: number } = {}
	for _, p in players do
		scores[p] = 0
	end
	local carrying: { [Player]: BasePart } = {}
	local function rows()
		local r = {}
		for p, n in scores do
			table.insert(r, { name = p.DisplayName, right = tostring(n) .. " cooked", hi = n > 0 })
		end
		table.sort(r, function(a, b)
			return a.right > b.right
		end)
		return r
	end
	publish("COOKING RUSH", rows())
	local function spawnIngredient()
		if round ~= my then
			return
		end
		local spot = spots[math.random(2, #spots)]
		local kind = INGREDIENTS[math.random(1, #INGREDIENTS)]
		local item = Instance.new("Part")
		item.Name = kind[1]
		item.Shape = Enum.PartType.Ball
		item.Size = Vector3.new(1.4, 1.4, 1.4)
		item.Color = kind[2]
		item.Material = Enum.Material.SmoothPlastic
		item.Anchored, item.CanCollide, item.CanTouch = true, false, false
		item.CFrame = CFrame.new(spot + Vector3.new(0, 0.9, 0))
		item.Parent = f
		local bb = Theme.make("BillboardGui", { Size = UDim2.fromOffset(110, 30), StudsOffset = Vector3.new(0, 1.4, 0),
			LightInfluence = 0, MaxDistance = 90, Parent = item })
		Theme.label({ Text = kind[1], FontFace = Theme.Heading, TextXAlignment = Enum.TextXAlignment.Center,
			TextStrokeTransparency = 0.3, Size = UDim2.fromScale(1, 1), MaxText = 20, Parent = bb })
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Pick up"
		prompt.ObjectText = kind[1]
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 9
		prompt.RequiresLineOfSight = false
		prompt.Parent = item
		prompt.Triggered:Connect(function(p)
			if round ~= my or carrying[p] or not scores[p] then
				return
			end
			prompt:Destroy()
			carrying[p] = item
		end)
	end
	for _ = 1, math.min(4, #spots - 1) do
		spawnIngredient()
	end
	World.Moment:FireAllClients({ type = "countdown", seconds = 3, text = "COOKING RUSH · CARRY FOOD TO THE STOVE" })
	task.spawn(function()
		task.wait(3)
		local endsAt = os.clock() + COOK_SECONDS
		while round == my and os.clock() < endsAt do
			task.wait(0.1)
			for p, item in carrying do
				local hrp = hrpOf(p)
				if not hrp or not p.Parent or not item.Parent then
					carrying[p] = nil
					continue
				end
				item.CFrame = hrp.CFrame * CFrame.new(0, 3.2, 0) -- held overhead
				local d = Vector3.new(hrp.Position.X - stovePos.X, 0, hrp.Position.Z - stovePos.Z).Magnitude
				if d <= 4.5 then
					carrying[p] = nil
					item:Destroy()
					scores[p] = (scores[p] or 0) + 1
					World.Moment:FireAllClients({ type = "toast", text = string.upper(p.DisplayName) .. " COOKED " .. item.Name })
					publish("COOKING RUSH", rows())
					spawnIngredient()
				end
			end
		end
		if round ~= my then
			return
		end
		local best, bestN, total = {}, 0, 0
		for p, n in scores do
			total += n
			if n > bestN then
				best, bestN = { p }, n
			elseif n == bestN and n > 0 then
				table.insert(best, p)
			end
		end
		local names = {}
		for _, p in best do
			table.insert(names, p.DisplayName)
		end
		finish("cooking", if bestN > 0 then string.upper(table.concat(names, " & ")) .. " RUNS THE KITCHEN" else "NOTHING GOT COOKED",
			bestN .. " dishes · " .. total .. " total", best, tostring(bestN), table.concat(names, ", "))
	end)
	return true
end

function WorldGames.start()
	workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
		if current then
			WorldGames.stop()
		end
	end)
end

return WorldGames
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="37">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Boots Déjà View: lobby -> loading -> room. Owns remotes and host actions.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DV = script.Parent:WaitForChild("DejaView")
local Config = require(DV.Config)
local World = require(DV.World)
local Rooms = require(DV.Rooms)
local Presence = require(DV.Presence)
local TagGame = require(DV.TagGame)
local Extras = require(DV.Extras)
local Chess = require(DV.Chess)
local Pong = require(DV.Pong)
local Foosball = require(DV.Foosball)
local PingPong = require(DV.PingPong)
local Stats = require(DV.Stats)
local WorldGames = require(DV.WorldGames)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Vote = Remotes:WaitForChild("Vote") :: RemoteEvent
local HostAction = Remotes:WaitForChild("HostAction") :: RemoteEvent

for name, value in {
	Phase = "lobby", SceneId = "", RoomName = "", LoadProgress = 0, LoadStage = "", Banner = "",
	Offline = false, JudgeHere = false, JudgeName = "", JudgeRoom = "", LabelCount = 0, HuntJson = "", GameJson = "", RoundState = "idle", RoundEndsAt = 0,
	CountdownEndsAt = 0, RoundIt = "", ScoresJson = "", RoomsJson = "[]", AutoJoin = Config.AUTO_JOIN_DEFAULT,
	Follow = true, MockJudge = false, HasImagined = false, UsingMock = Config.useMock(),
} do
	workspace:SetAttribute(name, value)
end

-- GetConfigAsync can block for ~30 s when the place is unpublished; never hold up the boot for it.
task.spawn(function()
	Config.init()
	workspace:SetAttribute("UsingMock", Config.useMock())
end)
World.init()

Presence.stateOf = TagGame.stateOf
Presence.onActive = Rooms.onActive
Presence.onRoomGone = Rooms.roomClosed
Presence.onHostEvent = function(ev)
	if ev.type == "start_round" then
		TagGame.start(nil)
	elseif ev.type == "end_round" then
		TagGame.finish()
	elseif ev.type == "join" then
		Rooms.joinAll(false)
	end
end
workspace:GetAttributeChangedSignal("JudgeHere"):Connect(function()
	Rooms.onJudgeHere(workspace:GetAttribute("JudgeHere") == true)
end)

Rooms.onSwitchStart = function()
	TagGame.abort()
end

Vote.OnServerEvent:Connect(function(player, sceneId)
	Rooms.vote(player, sceneId)
end)

local actions: { [string]: (Player, any) -> () } = {
	join = function()
		task.spawn(function()
			Rooms.joinAll(false)
			if workspace:GetAttribute("JudgeHere") then
				TagGame.start(nil)
			end
		end)
	end,
	start_round = function(p)
		if WorldGames.active() then
			World.toast("Finish the current game first", p)
			return
		end
		if Extras.huntActive() then
			World.toast("Finish the hunt first", p)
			return
		end
		TagGame.start(p)
	end,
	end_round = function()
		TagGame.finish()
		Extras.endHunt(nil)
		WorldGames.stop()
	end,
	hideseek = function(p)
		if TagGame.isPlaying() or Extras.huntActive() then
			World.toast("Finish the current round first", p)
			return
		end
		WorldGames.hideAndSeek(p)
	end,
	lava = function(p)
		if TagGame.isPlaying() or Extras.huntActive() then
			World.toast("Finish the current round first", p)
			return
		end
		WorldGames.lava(p)
	end,
	cooking = function(p)
		if TagGame.isPlaying() or Extras.huntActive() then
			World.toast("Finish the current round first", p)
			return
		end
		WorldGames.cooking(p)
	end,
	start_hunt = function(p)
		if WorldGames.active() then
			World.toast("Finish the current game first", p)
			return
		end
		if TagGame.isPlaying() then
			World.toast("Finish the tag round first", p)
			return
		end
		Extras.startHunt(p)
	end,
	end_hunt = function()
		Extras.endHunt(nil)
	end,
	pingpong = function(p, cameraLook)
		if Pong.isActive() then
			Pong.rematch() -- pressed again while it's up: a rematch in the same spot
			return
		end
		local sceneId = workspace:GetAttribute("SceneId")
		local info = type(sceneId) == "string" and Rooms.modelInfo(sceneId) or nil
		Pong.placeForRoom(p, info and info.features or nil, if typeof(cameraLook) == "Vector3" then cameraLook else nil)
	end,
	foosball = function(p, cameraLook)
		if Foosball.isActive() then
			Foosball.rematch() -- pressed again while it's up: a rematch in the same spot
			return
		end
		local sceneId = workspace:GetAttribute("SceneId")
		local info = type(sceneId) == "string" and Rooms.modelInfo(sceneId) or nil
		Foosball.placeForRoom(p, info and info.features or nil, if typeof(cameraLook) == "Vector3" then cameraLook else nil)
	end,
	chess = function(p, cameraLook)
		if Chess.isActive() then
			Chess.rematch() -- pressed again while it's up: a rematch in the same spot
			return
		end
		local sceneId = workspace:GetAttribute("SceneId")
		local info = type(sceneId) == "string" and Rooms.modelInfo(sceneId) or nil
		Chess.placeForRoom(p, info and info.features or nil, if typeof(cameraLook) == "Vector3" then cameraLook else nil)
	end,
	auto_join = function(_, v)
		workspace:SetAttribute("AutoJoin", v == true)
	end,
	follow = function(_, v)
		workspace:SetAttribute("Follow", v == true)
	end,
	mock_judge = function(_, v)
		workspace:SetAttribute("MockJudge", v == true)
	end,
	lobby_all = function()
		TagGame.abort()
		for _, p in Players:GetPlayers() do
			World.toLobby(p)
		end
	end,
}

-- Anyone may hop in (or back to the lobby) themselves; everything else is host-only.
HostAction.OnServerEvent:Connect(function(player, action, value)
	if action == "hop_in" then
		Rooms.joinOne(player)
		return
	elseif action == "to_lobby" then
		if not TagGame.isPlaying() then
			World.toLobby(player)
		end
		return
	end
	if not World.isHost(player) then
		return
	end
	local fn = actions[action]
	if fn then
		fn(player, value)
	end
end)

Stats.start()
World.onEnterRoom = function(p)
	Stats.badge(p, "memory")
end
TagGame.start10Hz()
Extras.start()
Chess.start()
WorldGames.start()
Pong.start()
Foosball.start()
PingPong.start()

-- The judge's avatar (Update 4 item 4): one plain R15 rig for every client to clone and drive locally.
task.spawn(function()
	local ok, rig = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		local dark = Color3.fromRGB(44, 44, 52)
		desc.HeadColor, desc.TorsoColor = dark, dark
		desc.LeftArmColor, desc.RightArmColor, desc.LeftLegColor, desc.RightLegColor = dark, dark, dark, dark
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not rig then
		warn("[DejaView] judge rig unavailable, using the floating ghost:", rig)
		return
	end
	rig.Name = "JudgeRig"
	local assets = ReplicatedStorage:FindFirstChild("Assets") or Instance.new("Folder")
	assets.Name = "Assets"
	assets.Parent = ReplicatedStorage
	rig.Parent = assets
end)
-- First requests wait for the live config so they go to dejaview_base, not the built-in fallback.
-- (Unpublished places take ~30 s to fail; 10 s is the cap.)
Config.waitLoaded(10)
Presence.start()
Rooms.start()

-- Boot room: a deep link's launch data wins, otherwise the default / newest ready room.
task.spawn(function()
	local launchScene: string? = nil
	local t0 = os.clock()
	while os.clock() - t0 < 4 and not launchScene do
		for _, p in Players:GetPlayers() do
			local ok, data = pcall(p.GetJoinData, p)
			if ok and type(data) == "table" and type(data.LaunchData) == "string" and data.LaunchData ~= "" then
				launchScene = data.LaunchData
			end
		end
		if #Players:GetPlayers() > 0 then
			break
		end
		task.wait(0.25)
	end
	local reached = Rooms.waitForList(15)
	local target = launchScene or Rooms.newestReady()
	if target then
		Rooms.switchTo(target)
		return
	end
	if not reached then
		-- Déjà View unreachable: put up a baked or fixture room now, then switch to a real one once it answers.
		warn("[DejaView] Déjà View unreachable at boot; loading a fallback room")
		Rooms.loadFallback()
		local fallbackScene = workspace:GetAttribute("SceneId")
		while not Rooms.isListLoaded() do
			task.wait(3)
		end
		local real = Rooms.newestReady()
		if real and workspace:GetAttribute("SceneId") == fallbackScene then
			Rooms.switchTo(real)
		end
		return
	end
	warn("[DejaView] no ready rooms yet; waiting in the lobby")
end)

-- Later deep-link joiners: if we are still in the lobby phase, load their room.
Players.PlayerAdded:Connect(function(p)
	local ok, data = pcall(p.GetJoinData, p)
	if ok and type(data) == "table" and type(data.LaunchData) == "string" and data.LaunchData ~= ""
		and workspace:GetAttribute("Phase") == "lobby" then
		Rooms.waitForList(10)
		Rooms.switchTo(data.LaunchData, { joinLobby = false })
	end
end)

-- Script audit: list every script in the place that isn't ours, so a backdoor from a free model (Toolbox) shows up
-- in the Output. Read-only; it changes nothing.
task.spawn(function()
	local ours = {
		game:GetService("ServerScriptService"):FindFirstChild("Main"),
		game:GetService("ServerScriptService"):FindFirstChild("DejaView"),
		game:GetService("ReplicatedStorage"):FindFirstChild("Shared"),
		game:GetService("StarterPlayer"):FindFirstChild("StarterPlayerScripts"),
	}
	local function isOurs(inst: Instance): boolean
		-- Roblox's own player scripts and the Animate script inside our judge rig are expected
		local path = inst:GetFullName()
		if string.find(path, "^StarterPlayer%.PlayerModule") or string.find(path, "^StarterPlayer%.StarterCharacterScripts")
			or string.find(path, "JudgeRig") then
			return true
		end
		for _, root in ours do
			if root and (inst == root or inst:IsDescendantOf(root)) then
				return true
			end
		end
		return false
	end
	local found = 0
	for _, svc in { workspace, game:GetService("ServerStorage"), game:GetService("ServerScriptService"),
		game:GetService("ReplicatedStorage"), game:GetService("ReplicatedFirst"), game:GetService("StarterGui"),
		game:GetService("StarterPack"), game:GetService("StarterPlayer"), game:GetService("Lighting") } do
		for _, d in svc:GetDescendants() do
			if d:IsA("LuaSourceContainer") and not isOurs(d) then
				found += 1
				warn("[DejaView][audit] script not from our code:", d.ClassName, d:GetFullName())
			end
		end
	end
	print("[DejaView][audit] done,", found, "foreign scripts")
end)

print("[DejaView] server up; mock =", Config.useMock(), "base =", Config.base())

      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Client: UI controller + ghost renderer. Reads workspace/player attributes, listens to Moment and GhostState.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Modules = script.Parent:WaitForChild("Modules")
local Ui = require(Modules.Ui)
local Board = require(Modules.Board)
local Ghosts = require(Modules.Ghosts)
local Effects = require(Modules.Effects)
local PongBall = require(Modules.PongBall)
local RoomLook = require(Modules.RoomLook)
local Arrival = require(Modules.Arrival)
local Theme = require(ReplicatedStorage:WaitForChild("Shared").Theme)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GhostState = Remotes:WaitForChild("GhostState") :: UnreliableRemoteEvent
local Moment = Remotes:WaitForChild("Moment") :: RemoteEvent
local Vote = Remotes:WaitForChild("Vote") :: RemoteEvent
local HostAction = Remotes:WaitForChild("HostAction") :: RemoteEvent
local LeaveNote = Remotes:WaitForChild("LeaveNote") :: RemoteEvent
local PongHit = Remotes:WaitForChild("PongHit") :: RemoteEvent
local FoosInput = Remotes:WaitForChild("FoosInput") :: RemoteEvent

local player = Players.LocalPlayer
local ui = Ui.build()
local make, label = Theme.make, Theme.label

task.spawn(function()
	for _ = 1, 10 do
		if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, false) then
			break
		end
		task.wait(1)
	end
end)

local function W(name: string): any
	return workspace:GetAttribute(name)
end

local function where(): string
	return player:GetAttribute("Where") or "lobby"
end

local function isHost(): boolean
	return player:GetAttribute("IsHost") == true
end

-- Lobby board (SurfaceGui in PlayerGui so the cards are clickable)
local boardList: Instance? = nil
local boardStatus: TextLabel? = nil
task.spawn(function()
	local lobby = workspace:WaitForChild("Lobby", 30)
	local part = lobby and lobby:WaitForChild("Board", 30)
	if not part then
		return
	end
	local sg = make("SurfaceGui", { Name = "LobbyBoard", Adornee = part, Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 22, LightInfluence = 0,
		ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") })
	local root = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg, Parent = sg },
		{ make("UIPadding", { PaddingLeft = UDim.new(0, 40), PaddingRight = UDim.new(0, 40), PaddingTop = UDim.new(0, 30),
			PaddingBottom = UDim.new(0, 30) }) })
	label({ Text = "DÉJÀ VIEW", TextColor3 = Theme.Accent, FontFace = Theme.Heading, Size = UDim2.new(0.5, 0, 0, 60),
		MaxText = 60, Parent = root })
	boardStatus = label({ Text = "", FontFace = Theme.Heading, Size = UDim2.new(1, 0, 0, 70), Position = UDim2.new(0, 0, 0, 64),
		MaxText = 64, Parent = root })
	local list = make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 160), Size = UDim2.new(1, 0, 1, -160),
		Parent = root }, { make("UIGridLayout", { CellSize = UDim2.new(0.235, 0, 0.45, 0), CellPadding = UDim2.new(0.02, 0, 0.05, 0),
		SortOrder = Enum.SortOrder.LayoutOrder }) })
	boardList = list
end)

local cards: { any } = {}
local function renderCards()
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, W("RoomsJson") or "[]")
	cards = if ok and type(decoded) == "table" then decoded else {}
	local current = W("SceneId")
	local function pick(id: string)
		Vote:FireServer(id)
		ui.panel.Visible = false
	end
	if boardList then
		Board.render(boardList, cards, current, pick)
	end
	if ui.panel.Visible then
		Board.render(ui.panelList, cards, current, pick)
	end
end

local function anyoneInLobby(): boolean
	for _, p in Players:GetPlayers() do
		if (p:GetAttribute("Where") or "lobby") ~= "room" then
			return true
		end
	end
	return false
end

-- Big-screen camera (table laptop / projector): follows the judge smoothly. Local to this client.
local bigScreen = false

-- Phones start with the host panel folded away so it doesn't cover the joystick.
local hostOpen = not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled
local bootDone = false
local function refresh()
	local phase = W("Phase") or "lobby"
	local roomName = W("RoomName") or ""
	local inRoom = where() == "room"
	local judge = W("JudgeHere") == true
	local round = W("RoundState") or "idle"

	RoomLook.update(inRoom and phase == "room")

	-- loading screen
	local showLoading = (not bootDone) or (phase == "loading" and inRoom)
	if showLoading then
		ui.loading.Visible = true
		ui.loadRoom.Text = string.upper(roomName)
		ui.loadTitle.Text = if (W("LoadStage") or "") == "Measuring the room..." then "Measuring the room..." else "Moving in..."
		local p = W("LoadProgress") or 0
		ui.loadFill.Size = UDim2.fromScale(math.clamp(p, 0, 1), 1)
		local built, total = W("LoadBuilt") or 0, W("LoadTotal") or 0
		ui.loadCount.Text = if total > 0 then string.format("%s / %s blocks", tostring(built), tostring(total)) else ""
	elseif ui.loading.Visible and not ui.loadingFading then
		ui.loadingFading = true
		Ui.fadeOut(ui.loading, 0.6)
		task.delay(0.65, function()
			ui.loadingFading = false
		end)
	end

	-- status lines
	local status
	if inRoom then
		ui.roomName.Text = string.upper(roomName)
		status = if round == "playing" then "TAG: THE JUDGE IS IT"
			elseif judge then (W("JudgeName") or "Judge") .. " is here"
			else ""
	else
		ui.roomName.Text = "LOBBY"
		if phase == "loading" then
			status = "Building " .. roomName .. "..."
		elseif (W("JudgeRoom") or "") ~= "" then
			status = "JUDGE IS IN " .. string.upper(W("JudgeRoom"))
		elseif judge and roomName ~= "" then
			status = "JUDGE IS IN " .. string.upper(roomName)
		elseif phase == "room" then
			status = "Room ready · JOIN"
		else
			status = "Waiting for a room..."
		end
	end
	ui.status.Text = status
	if boardStatus then
		boardStatus.Text = if inRoom then "" else status
		boardStatus.TextColor3 = if judge or (W("JudgeRoom") or "") ~= "" then Theme.Accent else Theme.Text
	end

	-- buttons
	local host = isHost()
	ui.host.Visible = host and hostOpen
	ui.hostToggle.Visible = host
	ui.hostToggle.BackgroundColor3 = if hostOpen then Theme.Accent else Theme.Surface
	ui.hostToggle.TextColor3 = if hostOpen then Theme.Bg else Theme.Text
	ui.joinBtn.Visible = host and phase == "room" and anyoneInLobby()
	ui.hopBtn.Visible = (phase == "room" and not inRoom and not host) or inRoom
	ui.hopBtn.Text = if inRoom then "LOBBY" else "HOP IN"
	ui.autoBtn.Text = "AUTO-JOIN: " .. (if W("AutoJoin") then "ON" else "OFF")
	ui.followBtn.Text = "FOLLOW: " .. (if W("Follow") then "ON" else "OFF")
	ui.mockBtn.Text = "MOCK JUDGE: " .. (if W("MockJudge") then "ON" else "OFF")
	ui.realityBtn.Visible = W("HasImagined") == true and inRoom
	ui.noteBtn.Visible = inRoom and phase == "room"
	ui.hitBtn.Visible = inRoom and W("PongActive") == true
	ui.foos.Visible = inRoom and W("FoosActive") == true
	ui.huntBtn.Text = if round == "hunt" then "END HUNT" else "START HUNT"
	ui.bigBtn.Text = "BIG SCREEN: " .. (if bigScreen then "ON" else "OFF")

	-- banner
	local banner = W("Banner") or ""
	ui.banner.Visible = banner ~= ""
	ui.banner.Text = banner

	ui.score.Visible = round == "playing" or round == "countdown" or round == "ended" or round == "hunt" or round == "game"
end

local function renderScores()
	for _, c in ui.scoreRows:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	if W("RoundState") == "game" or (W("RoundState") == "ended" and (W("GameJson") or "") ~= "") then
		local okG, gdata = pcall(HttpService.JSONDecode, HttpService, W("GameJson") or "")
		if okG and type(gdata) == "table" and W("RoundState") == "game" then
			Ui.scoreRow(ui.scoreRows, tostring(gdata.title), "", Theme.Accent, 0)
			for i, r in gdata.rows or {} do
				Ui.scoreRow(ui.scoreRows, r.name, r.right, if r.hi then Theme.Text else Theme.Muted, i)
			end
			return
		end
	end
	if W("RoundState") == "hunt" then
		local okH, h = pcall(HttpService.JSONDecode, HttpService, W("HuntJson") or "")
		if okH and type(h) == "table" then
			Ui.scoreRow(ui.scoreRows, "HUNT", tostring(h.total or 0) .. " LABELS", Theme.Accent, 0)
			for i, r in h.rows or {} do
				local done = r.found >= (h.total or 0)
				Ui.scoreRow(ui.scoreRows, r.name, r.found .. " / " .. tostring(h.total or 0), if done then Theme.Accent else Theme.Text, i)
			end
		end
		return
	end
	local ok, s = pcall(HttpService.JSONDecode, HttpService, W("ScoresJson") or "")
	if not ok or type(s) ~= "table" then
		return
	end
	Ui.scoreRow(ui.scoreRows, string.upper(s.vrName or "JUDGE") .. " · IT", tostring(s.vrTags or 0) .. " TAGS", Theme.Accent, 0)
	for i, r in s.runners or {} do
		local dots = string.rep("●", math.max(r.lives, 0)) .. string.rep("○", math.max(3 - r.lives, 0))
		Ui.scoreRow(ui.scoreRows, r.name, if r.out then "OUT" else dots, if r.out then Theme.Muted else Theme.Text, i)
	end
end

local chessMarks: { BasePart } = {}

-- Remote moments
Moment.OnClientEvent:Connect(function(m)
	if type(m) ~= "table" then
		return
	end
	if string.sub(tostring(m.type), 1, 4) == "pong" then
		PongBall.onMoment(m)
		if m.type == "pongServe" then
			Ui.toast(ui, string.upper(tostring(m.name)) .. " TO SERVE")
		end
		return
	end
	if m.type == "toast" then
		Ui.toast(ui, m.text)
	elseif m.type == "gone" then
		Ghosts.remove(m.id)
	elseif m.type == "tagged" then
		Effects.burst(m.pos)
		Effects.sound("tag")
		if m.userId == player.UserId then
			Effects.shake(0.5, 6)
			Ui.big(ui, "TAGGED", if m.lives > 0 then m.lives .. " lives left" else "You're out", Theme.Danger, 1.4)
		else
			Ui.toast(ui, string.upper(m.name) .. " GOT TAGGED")
		end
	elseif m.type == "countdown" then
		task.spawn(function()
			for i = m.seconds or 3, 1, -1 do
				Ui.big(ui, tostring(i), m.text, Theme.Accent, 0.95)
				Effects.sound("tick")
				task.wait(1)
			end
		end)
	elseif m.type == "roundStart" then
		Ui.big(ui, "GO!", "The judge is it · " .. tostring(m.duration) .. " s", Theme.Accent, 1.2)
	elseif m.type == "found" then
		if m.userId == player.UserId then
			Ui.big(ui, "FOUND " .. string.upper(m.label), m.found .. " / " .. m.total, Theme.Accent, 1.2)
			Effects.sound("tick")
			-- tick the label off, just for this player
			local labels = workspace:FindFirstChild("Room") and workspace.Room:FindFirstChild("Labels")
			local part = labels and labels:FindFirstChild("Label" .. tostring(m.index))
			local title = part and part:FindFirstChild("Title", true)
			if title and title:IsA("TextLabel") then
				title.Text = "✓ " .. string.upper(m.label)
				title.TextColor3 = Theme.Muted
			end
		else
			Ui.toast(ui, string.upper(m.name) .. " FOUND " .. string.upper(m.label) .. " · " .. m.found .. "/" .. m.total)
		end
	elseif m.type == "chessTargets" then
		-- light up the squares the held piece can move to (only on this player's screen)
		for _, h in chessMarks do
			h:Destroy()
		end
		table.clear(chessMarks)
		local board = workspace:FindFirstChild("Room") and workspace.Room:FindFirstChild("Chess")
		for _, sq in m.squares or {} do
			local part = board and board:FindFirstChild("Sq" .. tostring(sq))
			if part and part:IsA("BasePart") then
				local mark = Instance.new("Part")
				mark.Anchored, mark.CanCollide, mark.CanQuery, mark.CanTouch = true, false, false, false
				mark.Material = Enum.Material.Neon
				mark.Color = Theme.Accent
				mark.Transparency = 0.45
				mark.Size = Vector3.new(part.Size.X * 0.8, 0.12, part.Size.Z * 0.8)
				mark.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + 0.06, 0)
				mark.Parent = workspace
				table.insert(chessMarks, mark)
			end
		end
		if #(m.squares or {}) > 0 then
			Effects.sound("tick")
		end
	elseif m.type == "blind" then
		ui.blind.Visible = m.on == true
		ui.blindText.Text = tostring(m.text or "")
	elseif m.type == "intro" then
		ui.intro.Visible = true
		task.delay(10, function()
			ui.intro.Visible = false
		end)
	elseif m.type == "badge" then
		Ui.big(ui, "BADGE", tostring(m.title), Theme.Accent, 2.5)
		Effects.sound("win")
	elseif m.type == "unlocked" then
		ui.unlockedName.Text = string.upper(m.name or "")
		ui.unlockedId = m.id
		ui.unlocked.Visible = true
		Effects.sound("win")
		local stamp = os.clock()
		ui.unlockedStamp = stamp
		task.delay(12, function()
			if ui.unlockedStamp == stamp then
				ui.unlocked.Visible = false
			end
		end)
	elseif m.type == "winner" then
		ui.winTitle.Text = m.title
		ui.winSub.Text = m.mvp or ""
		ui.winner.Visible = true
		Effects.sound("win")
		task.delay(5, function()
			ui.winner.Visible = false
		end)
	end
end)

GhostState.OnClientEvent:Connect(Ghosts.push)

-- Buttons
local function host(action: string, value: any?)
	HostAction:FireServer(action, value)
end
ui.hostToggle.Activated:Connect(function()
	hostOpen = not hostOpen
	refresh()
end)
ui.roomsBtn.Activated:Connect(function()
	ui.panel.Visible = not ui.panel.Visible
	renderCards()
end)
ui.closeBtn.Activated:Connect(function()
	ui.panel.Visible = false
end)
ui.hopBtn.Activated:Connect(function()
	host(if where() == "room" then "to_lobby" else "hop_in")
end)
ui.joinBtn.Activated:Connect(function()
	host("join")
end)
ui.autoBtn.Activated:Connect(function()
	host("auto_join", not W("AutoJoin"))
end)
ui.followBtn.Activated:Connect(function()
	host("follow", not W("Follow"))
end)
ui.mockBtn.Activated:Connect(function()
	host("mock_judge", not W("MockJudge"))
end)
ui.startBtn.Activated:Connect(function()
	host("start_round")
end)
ui.endBtn.Activated:Connect(function()
	host("end_round")
end)
-- Foosball: hold ◀ / ▶ (or Z / X) to slide your rods, KICK (or C) to shoot.
local foosHeld = { left = false, right = false }
local function sendSlide()
	local v = (if foosHeld.right then 1 else 0) - (if foosHeld.left then 1 else 0)
	FoosInput:FireServer("slide", v)
end
for key, btn in { left = ui.foosLeft, right = ui.foosRight } do
	btn.MouseButton1Down:Connect(function()
		foosHeld[key] = true
		sendSlide()
	end)
	btn.MouseButton1Up:Connect(function()
		foosHeld[key] = false
		sendSlide()
	end)
	btn.MouseLeave:Connect(function()
		if foosHeld[key] then
			foosHeld[key] = false
			sendSlide()
		end
	end)
end
ui.foosKick.Activated:Connect(function()
	FoosInput:FireServer("kick")
end)
ui.foosBtn.Activated:Connect(function()
	host("foosball", workspace.CurrentCamera.CFrame.LookVector)
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not W("FoosActive") then
		return
	end
	if input.KeyCode == Enum.KeyCode.Z or input.KeyCode == Enum.KeyCode.DPadLeft then
		foosHeld.left = true
		sendSlide()
	elseif input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.DPadRight then
		foosHeld.right = true
		sendSlide()
	elseif input.KeyCode == Enum.KeyCode.C or input.KeyCode == Enum.KeyCode.ButtonR1 then
		FoosInput:FireServer("kick")
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Z or input.KeyCode == Enum.KeyCode.DPadLeft then
		foosHeld.left = false
		sendSlide()
	elseif input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.DPadRight then
		foosHeld.right = false
		sendSlide()
	end
end)
ui.pongBtn.Activated:Connect(function()
	host("pingpong", workspace.CurrentCamera.CFrame.LookVector)
end)
ui.hitBtn.Activated:Connect(function()
	PongHit:FireServer()
end)
ui.hideBtn.Activated:Connect(function()
	host("hideseek")
end)
ui.lavaBtn.Activated:Connect(function()
	host("lava")
end)
ui.cookBtn.Activated:Connect(function()
	host("cooking")
end)
ui.chessBtn.Activated:Connect(function()
	host("chess", workspace.CurrentCamera.CFrame.LookVector)
end)
ui.introOk.Activated:Connect(function()
	ui.intro.Visible = false
end)
ui.huntBtn.Activated:Connect(function()
	host(if W("RoundState") == "hunt" then "end_hunt" else "start_hunt")
end)
ui.bigBtn.Activated:Connect(function()
	bigScreen = not bigScreen
	if not bigScreen then
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end
	refresh()
end)
ui.noteBtn.Activated:Connect(function()
	ui.composer.Visible = not ui.composer.Visible
	if ui.composer.Visible then
		ui.noteBox:CaptureFocus()
	end
end)
local function sendNote()
	local text = ui.noteBox.Text
	if text:match("%S") then
		LeaveNote:FireServer(text)
	end
	ui.noteBox.Text = ""
	ui.composer.Visible = false
end
ui.noteSend.Activated:Connect(sendNote)
ui.noteBox.FocusLost:Connect(function(enter)
	if enter then
		sendNote()
	end
end)
ui.noteCancel.Activated:Connect(function()
	ui.noteBox.Text = ""
	ui.composer.Visible = false
end)
ui.unlockedJoin.Activated:Connect(function()
	if ui.unlockedId then
		Vote:FireServer(ui.unlockedId)
	end
	ui.unlocked.Visible = false
end)
ui.lobbyAllBtn.Activated:Connect(function()
	host("lobby_all")
end)
local reality = false
ui.realityBtn.Activated:Connect(function()
	reality = not reality
	Effects.setReality(reality)
	ui.realityBtn.BackgroundColor3 = if reality then Theme.Imagined else Theme.Surface
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if (input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonR2) and W("PongActive") then
		PongHit:FireServer()
	end
	if input.KeyCode == Enum.KeyCode.ButtonX and isHost() then
		hostOpen = not hostOpen
		refresh()
	end
	if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonY then
		ui.panel.Visible = not ui.panel.Visible
		renderCards()
	end
end)

-- Attribute wiring
for _, name in { "Phase", "RoomName", "LoadProgress", "LoadStage", "Banner", "JudgeHere", "JudgeName", "RoundState",
	"AutoJoin", "Follow", "MockJudge", "HasImagined", "JudgeRoom", "LabelCount", "PongActive", "FoosActive" } do
	workspace:GetAttributeChangedSignal(name):Connect(refresh)
end
workspace:GetAttributeChangedSignal("RoomsJson"):Connect(renderCards)
workspace:GetAttributeChangedSignal("ScoresJson"):Connect(renderScores)
workspace:GetAttributeChangedSignal("HuntJson"):Connect(renderScores)
workspace:GetAttributeChangedSignal("GameJson"):Connect(renderScores)
workspace:GetAttributeChangedSignal("RoundState"):Connect(renderScores)
-- the room's model (and its sky) can arrive a moment after the room itself
workspace.ChildAdded:Connect(function(c)
	if c.Name == "Room" then
		c:GetAttributeChangedSignal("HasModel"):Connect(refresh)
		c:GetAttributeChangedSignal("SkyFt"):Connect(refresh)
		task.defer(refresh)
	end
end)
workspace:GetAttributeChangedSignal("SceneId"):Connect(function()
	Ghosts.clear()
	reality = false
	Effects.setReality(false)
	ui.realityBtn.BackgroundColor3 = Theme.Surface
	renderCards()
end)
player:GetAttributeChangedSignal("Where"):Connect(refresh)
player:GetAttributeChangedSignal("IsHost"):Connect(refresh)
local function watchPlayer(p: Player)
	p:GetAttributeChangedSignal("Where"):Connect(refresh)
end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function()
	task.defer(refresh)
end)
for _, p in Players:GetPlayers() do
	watchPlayer(p)
end

-- Per frame: ghosts, timer, spectator camera
local lastSubjectCheck = 0
RunService.RenderStepped:Connect(function(dt)
	Ghosts.update(dt)
	PongBall.update()
	local round = W("RoundState")
	if round == "playing" then
		local left = math.max(0, (W("RoundEndsAt") or 0) - workspace:GetServerTimeNow())
		ui.timer.Text = string.format("%d:%02d", left // 60, math.floor(left % 60))
		ui.timer.TextColor3 = if left < 10 then Theme.Danger else Theme.Text
	elseif round == "hunt" or round == "game" then
		local left = math.max(0, (W("RoundEndsAt") or 0) - workspace:GetServerTimeNow())
		ui.timer.Text = string.format("%d:%02d", left // 60, math.floor(left % 60))
		ui.timer.TextColor3 = Theme.Accent
	elseif round == "countdown" then
		ui.timer.Text = "READY"
	elseif round == "ended" then
		ui.timer.Text = "DONE"
	end
	if bigScreen then
		-- Smooth follow: behind and above the judge (or orbit the room when nobody is in the headset).
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		local head = Ghosts.judgeHead()
		local target, want
		if head then
			local look = head.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
			target = head.Position
			want = target - flat * 16 + Vector3.new(0, 9, 0)
		else
			local room = workspace:FindFirstChild("Room")
			local mn, mx = room and room:GetAttribute("BoundsMin"), room and room:GetAttribute("BoundsMax")
			local centre = if typeof(mn) == "Vector3" and typeof(mx) == "Vector3" then (mn + mx) / 2 else Vector3.zero
			local a = os.clock() * 0.1
			target = centre
			want = centre + Vector3.new(math.cos(a) * 30, 22, math.sin(a) * 30)
		end
		local k = math.min(1, dt * 2.5)
		local pos = cam.CFrame.Position:Lerp(want, k)
		cam.CFrame = CFrame.lookAt(pos, target)
	end
	if os.clock() - lastSubjectCheck > 0.5 then
		lastSubjectCheck = os.clock()
		local cam = workspace.CurrentCamera
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local head = Ghosts.judgeHead()
		if player:GetAttribute("Out") and head then
			cam.CameraSubject = head
		elseif hum and cam.CameraSubject ~= hum then
			cam.CameraSubject = hum
		end
	end
end)

-- Small screens: compact scoreboard
local function layoutForScreen()
	local size = workspace.CurrentCamera.ViewportSize
	-- 1 on a laptop, down to 0.6 on a phone in landscape.
	-- Laptops 1, tablets ~0.9, phones 0.75 (keeps tap targets around 33 pt or more).
	local scale = math.clamp(math.min(size.X / 1100, size.Y / 620), 0.75, 1)
	Ui.setCompact(ui, size.Y < 900) -- 15 host buttons: two columns unless the screen is tall
	Ui.setScale(ui, scale)
	ui.host.Position = UDim2.new(0, 16, 0, 64 + 120 * scale) -- right under the (scaled) HUD row
	local small = size.X < 900
	ui.scoreRows.Visible = size.X >= 700
	ui.roomsBtn.Text = if UserInputService.KeyboardEnabled then "ROOMS (R)" else "ROOMS"
	ui.panelList:FindFirstChildOfClass("UIGridLayout").CellSize = if small then UDim2.new(0.48, 0, 0, 140) else UDim2.new(0.31, 0, 0, 150)
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutForScreen)
layoutForScreen()

-- Ages and NEW chips expire: re-render now and then
task.spawn(function()
	while true do
		task.wait(10)
		renderCards()
	end
end)

Arrival.start()

-- Boot: the dark loading screen fades into the lobby
task.delay(1.2, function()
	bootDone = true
	refresh()
end)
refresh()
renderCards()
renderScores()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="45">
        <Properties>
          <string name="Name">Games</string>
          <string name="Source"><![CDATA[-- Real ping pong input (team/seb.md Update 5): hold to charge, aim with the camera or the hand, release to hit.
-- Its own LocalScript, so Client.client.luau stays Shivin's.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PingPongView = require(script.Parent.Modules.PingPongView)

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local PPPaddle = Remotes:WaitForChild("PPPaddle") :: UnreliableRemoteEvent
local PPHit = Remotes:WaitForChild("PPHit") :: RemoteEvent
local PPState = Remotes:WaitForChild("PPState") :: RemoteEvent
local PPSide = Remotes:WaitForChild("PPSide") :: RemoteEvent

local GRIP = CFrame.new(0, 0, -0.35) * CFrame.Angles(math.rad(-20), 0, 0)
local PADDLE_SEND = 1 / 30
local ASSIST_SEND = 1 / 5
local CHARGE_MAX = 1.6 -- seconds to full power
local CHARGE_MIN = 0.06

local lastSend = 0
local lastAssist = 0
local hand = Enum.UserCFrame.RightHand
local active = false
local mySide: string? = nil
local canHit = false
local bounce: string? = nil
local serving = false
local serveSide: string? = nil
local lastBlade: CFrame? = nil
local paddleVel = Vector3.zero

print("[PingPong] client charge v3")
local tableC: Vector3? = nil
local tableYaw = 0
local tableLen = 9.78
local tableWid = 5.44

local charging = false
local chargeStart = 0
local charge = 0
local prevCameraMode: Enum.CameraMode? = nil

-- HUD
local gui = Instance.new("ScreenGui")
gui.Name = "PPHud"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local hitButton = Instance.new("TextButton")
hitButton.Name = "PPHit"
hitButton.Size = UDim2.fromOffset(132, 132)
hitButton.AnchorPoint = Vector2.new(1, 1)
hitButton.Position = UDim2.new(1, -28, 1, -28)
hitButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
hitButton.BackgroundTransparency = 0.1
hitButton.Text = "HIT"
hitButton.TextScaled = false
hitButton.TextSize = 24
hitButton.Font = Enum.Font.GothamBold
hitButton.TextColor3 = Color3.fromRGB(0, 122, 255)
hitButton.Visible = false
hitButton.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = hitButton

local barBack = Instance.new("Frame")
barBack.Name = "PPPower"
barBack.Size = UDim2.fromOffset(260, 16)
barBack.AnchorPoint = Vector2.new(0.5, 1)
barBack.Position = UDim2.new(0.5, 0, 1, -34)
barBack.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
barBack.BackgroundTransparency = 0.35
barBack.Visible = false
barBack.Parent = gui
local barBackCorner = Instance.new("UICorner")
barBackCorner.CornerRadius = UDim.new(1, 0)
barBackCorner.Parent = barBack
local barFill = Instance.new("Frame")
barFill.Name = "Fill"
barFill.Size = UDim2.fromScale(0, 1)
barFill.BackgroundColor3 = Color3.fromRGB(0, 122, 255)
barFill.BorderSizePixel = 0
barFill.Parent = barBack
local barFillCorner = Instance.new("UICorner")
barFillCorner.CornerRadius = UDim.new(1, 0)
barFillCorner.Parent = barFill

local version = Instance.new("TextLabel")
version.Name = "PPVersion"
version.Size = UDim2.fromOffset(240, 22)
version.AnchorPoint = Vector2.new(0, 1)
version.Position = UDim2.new(0, 24, 1, -24)
version.BackgroundTransparency = 1
version.Font = Enum.Font.GothamBold
version.TextSize = 14
version.TextColor3 = Color3.fromRGB(255, 255, 255)
version.TextStrokeTransparency = 0.5
version.TextXAlignment = Enum.TextXAlignment.Left
version.Text = "PING PONG v3  ·  hold to charge"
version.Visible = false
version.Parent = gui

local reticle = Instance.new("Frame")
reticle.Name = "PPAim"
reticle.Size = UDim2.fromOffset(10, 10)
reticle.AnchorPoint = Vector2.new(0.5, 0.5)
reticle.Position = UDim2.fromScale(0.5, 0.5)
reticle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
reticle.BackgroundTransparency = 0.15
reticle.BorderSizePixel = 0
reticle.Visible = false
reticle.Parent = gui
local reticleCorner = Instance.new("UICorner")
reticleCorner.CornerRadius = UDim.new(1, 0)
reticleCorner.Parent = reticle

local function refreshHitButton()
	local mine = mySide
	if not active or not mine then
		hitButton.Visible = false
		canHit = false
		return
	end
	hitButton.Visible = true
	local serveNow = serving and serveSide == mine
	canHit = serveNow or bounce == mine
	if charging then
		hitButton.Text = "POWER"
	elseif canHit then
		hitButton.Text = if serveNow then "SERVE" else "HIT"
	else
		hitButton.Text = "WAIT"
	end
	hitButton.BackgroundTransparency = if canHit then 0.1 else 0.6
	hitButton.TextColor3 = if canHit then Color3.fromRGB(0, 122, 255) else Color3.fromRGB(150, 150, 155)
end

local function bladeCframe(): CFrame?
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local h = UserInputService:GetUserCFrame(hand)
	return cam.CFrame * CFrame.new(h.Position * cam.HeadScale) * h.Rotation
end

local function aimDir(): Vector3?
	if UserInputService.VREnabled and lastBlade then
		return lastBlade.LookVector
	end
	local cam = workspace.CurrentCamera
	return if cam then cam.CFrame.LookVector else nil
end

local function beginCharge()
	if not active or not mySide or charging then
		return
	end
	charging = true
	chargeStart = os.clock()
	charge = 0
	barBack.Visible = true
	reticle.Visible = not UserInputService.VREnabled
	if not UserInputService.VREnabled then
		prevCameraMode = player.CameraMode
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end
	refreshHitButton()
end

local function endCharge()
	if not charging then
		return
	end
	charging = false
	local held = math.clamp((os.clock() - chargeStart) / CHARGE_MAX, CHARGE_MIN, 1)
	charge = 0
	barBack.Visible = false
	reticle.Visible = false
	if prevCameraMode then
		player.CameraMode = prevCameraMode
		prevCameraMode = nil
	end
	if not UserInputService.VREnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
	local dir = aimDir()
	if not dir then
		refreshHitButton()
		return
	end
	if UserInputService.VREnabled then
		local b = workspace:FindFirstChild("PPBall", true)
		local cf = lastBlade
		if b and b:IsA("BasePart") and cf then
			PPHit:FireServer({
				vr = true,
				cf = cf,
				vel = paddleVel,
				p = b.Position,
				t = workspace:GetServerTimeNow(),
				charge = held,
				dir = dir,
			})
		end
	else
		PPHit:FireServer({ charge = held, dir = dir, flight = 0.7 })
	end
	refreshHitButton()
end

hitButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		beginCharge()
	end
end)
hitButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		endCharge()
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not active then
		return
	end
	local k = input.KeyCode
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not charging then
		beginCharge()
	elseif input.UserInputType == Enum.UserInputType.Touch and not charging then
		beginCharge()
	elseif k == Enum.KeyCode.E or k == Enum.KeyCode.ButtonR2 or k == Enum.KeyCode.ButtonL2 then
		beginCharge()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	local k = input.KeyCode
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		endCharge()
	elseif k == Enum.KeyCode.E or k == Enum.KeyCode.ButtonR2 or k == Enum.KeyCode.ButtonL2 then
		endCharge()
	end
end)

local function clampToScope()
	if not charging or UserInputService.VREnabled or not tableC or not mySide then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end
	local tf = CFrame.new(tableC) * CFrame.Angles(0, tableYaw, 0)
	local lp = tf:PointToObjectSpace(hrp.Position)
	local x = math.clamp(lp.X, -(tableWid / 2 + 3), tableWid / 2 + 3)
	local zMin, zMax
	if mySide == "A" then
		zMin, zMax = -tableLen / 2 - 12, -tableLen / 2 + 1
	else
		zMin, zMax = tableLen / 2 - 1, tableLen / 2 + 12
	end
	local z = math.clamp(lp.Z, zMin, zMax)
	if (Vector3.new(x, lp.Y, z) - lp).Magnitude > 0.05 then
		local world = tf:PointToWorldSpace(Vector3.new(x, lp.Y, z))
		hrp.CFrame = CFrame.new(world) * (hrp.CFrame - hrp.CFrame.Position)
	end
end

RunService.RenderStepped:Connect(function(dt)
	PingPongView.update(dt)
	if not active then
		return
	end
	local t = os.clock()
	if UserInputService.VREnabled then
		local cf = bladeCframe()
		if cf then
			local bladeCf = cf * GRIP
			if lastBlade then
				paddleVel = (bladeCf.Position - lastBlade.Position) / math.max(0.008, dt)
			end
			lastBlade = bladeCf
			if t - lastSend >= PADDLE_SEND then
				lastSend = t
				PPPaddle:FireServer(bladeCf)
			end
		end
	elseif t - lastAssist >= ASSIST_SEND then
		lastAssist = t
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			PPPaddle:FireServer(hrp.CFrame * CFrame.new(1.4, -0.2, -1.1) * GRIP)
		end
	end
	if charging then
		charge = math.clamp((t - chargeStart) / CHARGE_MAX, 0, 1)
		barFill.Size = UDim2.fromScale(charge, 1)
		barFill.BackgroundColor3 = Color3.fromRGB(0, 122, 255):Lerp(Color3.fromRGB(255, 90, 60), charge)
		clampToScope()
	end
end)

PPPaddle.OnClientEvent:Connect(function(userId, cf)
	if type(userId) == "number" and typeof(cf) == "CFrame" then
		PingPongView.paddle(userId, cf)
	end
end)

PPSide.OnClientEvent:Connect(function(side)
	if side == "A" or side == "B" then
		mySide = side
		refreshHitButton()
	end
end)

PPState.OnClientEvent:Connect(function(msg)
	if type(msg) ~= "table" then
		return
	end
	if msg.active ~= nil then
		active = msg.active == true
		version.Visible = active
		if not active then
			mySide = nil
			charging = false
			barBack.Visible = false
			reticle.Visible = false
			PingPongView.clear()
		end
	end
	if msg.serve ~= nil then
		serveSide = msg.serve
	end
	if msg.serving ~= nil then
		serving = msg.serving == true
	end
	if msg.bounce ~= nil then
		bounce = msg.bounce
	end
	if typeof(msg.c) == "Vector3" then
		tableC = msg.c
	end
	if type(msg.yaw) == "number" then
		tableYaw = msg.yaw
	end
	if type(msg.len) == "number" then
		tableLen = msg.len
	end
	if type(msg.wid) == "number" then
		tableWid = msg.wid
	end
	refreshHitButton()
end)

workspace:GetAttributeChangedSignal("PPActive"):Connect(function()
	local on = workspace:GetAttribute("PPActive") == true
	if on ~= active then
		active = on
		if not on then
			mySide = nil
			charging = false
			barBack.Visible = false
			reticle.Visible = false
			PingPongView.clear()
		end
		refreshHitButton()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="46">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Arrival</string>
            <string name="Source"><![CDATA[-- The room assembles around you (team/shivin.md Update 9, item 3): when a textured room model arrives, its chunks rise
-- from below and slot into place over about 2 s, nearest first, with a soft sound. Purely local; the server's parts
-- are only moved on this client, and end exactly where the server put them.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Effects = require(script.Parent.Effects)

local Arrival = {}

local DURATION = 0.9 -- each chunk's rise
local SPREAD = 1.3 -- the last chunk starts this long after the first
local DROP = 18 -- studs below its place a chunk starts

local function ease(a: number): number
	-- ease out back: a small overshoot as each piece slots in
	local c1, c3 = 1.4, 2.4
	return 1 + c3 * (a - 1) ^ 3 + c1 * (a - 1) ^ 2
end

function Arrival.play(model: Instance)
	local parts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	if #parts == 0 or #parts > 400 then
		return -- a model this big would cost more than it shows
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local origin = if root then root.Position else Vector3.zero
	table.sort(parts, function(a, b)
		return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
	end)
	local jobs = {}
	for i, p in parts do
		local target = p.CFrame
		local delay = if #parts > 1 then (i - 1) / (#parts - 1) * SPREAD else 0
		table.insert(jobs, { part = p, target = target, start = os.clock() + delay })
		p.CFrame = target - Vector3.new(0, DROP, 0)
		p.LocalTransparencyModifier = 1
	end
	Effects.sound("tick")
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local done = true
		local now = os.clock()
		for _, j in jobs do
			if not j.part.Parent then
				continue
			end
			local a = math.clamp((now - j.start) / DURATION, 0, 1)
			if a < 1 then
				done = false
			end
			local e = if a <= 0 then 0 else ease(a)
			j.part.CFrame = j.target - Vector3.new(0, DROP * (1 - e), 0)
			j.part.LocalTransparencyModifier = 1 - math.clamp(a * 2.5, 0, 1)
		end
		if done then
			conn:Disconnect()
			for _, j in jobs do
				if j.part.Parent then
					j.part.CFrame = j.target
					j.part.LocalTransparencyModifier = 0
				end
			end
			Effects.sound("win")
		end
	end)
end

-- Watches for each new room's model.
function Arrival.start()
	local function watchRoom(room: Instance)
		room.ChildAdded:Connect(function(c)
			if c.Name == "RoomModel" then
				task.defer(Arrival.play, c)
			end
		end)
		local existing = room:FindFirstChild("RoomModel")
		if existing then
			task.defer(Arrival.play, existing)
		end
	end
	workspace.ChildAdded:Connect(function(c)
		if c.Name == "Room" then
			watchRoom(c)
		end
	end)
	local room = workspace:FindFirstChild("Room")
	if room then
		watchRoom(room)
	end
end

return Arrival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Avatar</string>
            <string name="Source"><![CDATA[-- The judge as a person (team/shivin.md Update 4, item 4): an R15 rig that stands at the judge's feet, turns with the
-- headset's yaw, looks where the head looks and reaches for the controller positions with IKControl. The rig itself
-- is made once by the server (ReplicatedStorage.Assets.JudgeRig); each client clones it locally and drives it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Avatar = {}

-- Roblox's own R15 animations (the default Animate set).
local WALK_ANIM = "rbxassetid://507777826"
local IDLE_ANIM = "rbxassetid://507766388"

export type Rig = {
	model: Model,
	root: BasePart,
	humanoid: Humanoid,
	hip: number, -- root centre above the feet
	lTarget: Attachment,
	rTarget: Attachment,
	lookTarget: Attachment,
	targets: BasePart,
	walk: AnimationTrack?,
	idle: AnimationTrack?,
	lastPos: Vector3?,
	speed: number,
	scaled: boolean,
	ikL: IKControl,
	ikR: IKControl,
}

local function template(): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local rig = assets and assets:FindFirstChild("JudgeRig")
	return if rig and rig:IsA("Model") then rig else nil
end

function Avatar.available(): boolean
	return template() ~= nil
end

local function ik(humanoid: Humanoid, kind: Enum.IKControlType, root: Instance?, effector: Instance?, target: Instance)
	local c = Instance.new("IKControl")
	c.Type = kind
	c.ChainRoot = root
	c.EndEffector = effector
	c.Target = target
	c.SmoothTime = 0.06
	c.Weight = 1
	c.Parent = humanoid
	return c
end

-- Builds a rig under `parent` (the ghost's model, so its Highlight outlines the person). nil if no template.
function Avatar.create(parent: Instance): Rig?
	local t = template()
	if not t then
		return nil
	end
	local model = t:Clone()
	model.Name = "JudgeAvatar"
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
			d.Massless = true
			d.CastShadow = false
			d.Anchored = false
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root then
		model:Destroy()
		return nil
	end
	root.Anchored = true
	root.Transparency = 1
	humanoid.EvaluateStateMachine = false -- we place it; no physics fighting us
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid

	-- Invisible anchored carrier for the IK targets.
	local targets = Instance.new("Part")
	targets.Name = "IKTargets"
	targets.Anchored, targets.CanCollide, targets.CanQuery, targets.CanTouch = true, false, false, false
	targets.Transparency = 1
	targets.Size = Vector3.one
	targets.CFrame = CFrame.new()
	targets.Parent = model
	local function att(name: string): Attachment
		local a = Instance.new("Attachment")
		a.Name = name
		a.Parent = targets
		return a
	end
	local lTarget, rTarget, lookTarget = att("LeftHand"), att("RightHand"), att("Look")

	local ikL = ik(humanoid, Enum.IKControlType.Position, model:FindFirstChild("LeftUpperArm"), model:FindFirstChild("LeftHand"), lTarget)
	local ikR = ik(humanoid, Enum.IKControlType.Position, model:FindFirstChild("RightUpperArm"), model:FindFirstChild("RightHand"), rTarget)
	ik(humanoid, Enum.IKControlType.LookAt, model:FindFirstChild("UpperTorso"), model:FindFirstChild("Head"), lookTarget)

	model.Parent = parent
	local hip = humanoid.HipHeight + root.Size.Y / 2

	local rig: Rig = {
		model = model, root = root, humanoid = humanoid, hip = hip,
		lTarget = lTarget, rTarget = rTarget, lookTarget = lookTarget, targets = targets,
		walk = nil, idle = nil, lastPos = nil, speed = 0, scaled = false, ikL = ikL, ikR = ikR,
	}
	pcall(function()
		local walkAnim = Instance.new("Animation")
		walkAnim.AnimationId = WALK_ANIM
		local idleAnim = Instance.new("Animation")
		idleAnim.AnimationId = IDLE_ANIM
		local idle = animator:LoadAnimation(idleAnim)
		rig.walk = animator:LoadAnimation(walkAnim)
		rig.idle = idle
		idle:Play(0.2)
	end)
	return rig
end

-- Scales the rig once so its eyes sit at the judge's real head height.
local function scaleTo(rig: Rig, eyeHeight: number)
	rig.scaled = true
	local head = rig.model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local feetY = rig.root.Position.Y - rig.hip
	local current = head.Position.Y - feetY
	if current <= 0.5 then
		return
	end
	local factor = math.clamp(eyeHeight / current, 0.75, 1.5)
	pcall(function()
		rig.model:ScaleTo(rig.model:GetScale() * factor)
	end)
	rig.hip = rig.humanoid.HipHeight + rig.root.Size.Y / 2
end

-- s: an Interp sample (feet pos, yaw, head, hl, hr). dt: frame time.
function Avatar.update(rig: Rig, s: any, dt: number)
	local yawCf = CFrame.Angles(0, s.yaw, 0)
	local rootPos = s.pos + Vector3.new(0, rig.hip, 0)
	rig.root.CFrame = CFrame.new(rootPos) * yawCf
	local head = s.head or (s.pos + Vector3.new(0, 5.7, 0))
	if not rig.scaled then
		scaleTo(rig, head.Y - s.pos.Y)
		rootPos = s.pos + Vector3.new(0, rig.hip, 0)
		rig.root.CFrame = CFrame.new(rootPos) * yawCf
	end

	-- Hands reach for the controllers; with no controllers, let the arms hang (IK off).
	rig.ikL.Enabled = s.hl ~= nil
	rig.ikR.Enabled = s.hr ~= nil
	if s.hl then
		rig.lTarget.WorldPosition = s.hl
	end
	if s.hr then
		rig.rTarget.WorldPosition = s.hr
	end
	rig.lookTarget.WorldPosition = head + yawCf.LookVector * 10

	-- Walk while the feet move, idle otherwise.
	if rig.lastPos and dt > 0 then
		local v = Vector3.new(s.pos.X - rig.lastPos.X, 0, s.pos.Z - rig.lastPos.Z).Magnitude / dt
		rig.speed += (v - rig.speed) * math.min(1, dt * 6)
	end
	rig.lastPos = s.pos
	if rig.walk and rig.idle then
		local moving = rig.speed > 1.2
		if moving and not rig.walk.IsPlaying then
			rig.walk:Play(0.2)
			rig.idle:Stop(0.2)
		elseif not moving and rig.walk.IsPlaying then
			rig.walk:Stop(0.25)
			rig.idle:Play(0.25)
		end
		if moving then
			rig.walk:AdjustSpeed(math.clamp(rig.speed / 12, 0.4, 1.6))
		end
	end
end

function Avatar.setTransparency(rig: Rig, t: number)
	for _, d in rig.model:GetDescendants() do
		if d:IsA("BasePart") and d ~= rig.root and d ~= rig.targets then
			d.LocalTransparencyModifier = t
		end
	end
end

return Avatar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Board</string>
            <string name="Source"><![CDATA[-- Room cards, used by the lobby SurfaceGui board and the in-game Rooms panel.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)

local Board = {}

local make, label = Theme.make, Theme.label

local function chip(parent: Instance, text: string, filled: boolean, order: number)
	local c = label({
		Text = text, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), MaxText = 16,
		TextScaled = false, TextSize = 13, FontFace = Theme.Heading,
		BackgroundTransparency = 0, BackgroundColor3 = if filled then Theme.Accent else Theme.Bg,
		TextColor3 = if filled then Theme.Bg else Theme.Text, LayoutOrder = order,
		TextXAlignment = Enum.TextXAlignment.Center, Parent = parent,
	})
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = c })
	Theme.corner(6).Parent = c
	if not filled then
		Theme.stroke().Parent = c
	end
	return c
end

local function card(parent: Instance, c: any, current: string?, onClick: (string) -> (), order: number)
	local clickable = c.status == "ready" and not c.measuring
	local btn = make("TextButton", {
		Name = c.id, Text = "", AutoButtonColor = clickable, LayoutOrder = order,
		BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.05, Parent = parent,
	}, { Theme.corner(14) })
	local stroke = Theme.stroke(if c.id == current then Theme.Accent else Theme.Stroke, if c.id == current then 2 else 1)
	stroke.Parent = btn
	make("UIPadding", { PaddingLeft = UDim.new(0.05, 0), PaddingRight = UDim.new(0.05, 0),
		PaddingTop = UDim.new(0.07, 0), PaddingBottom = UDim.new(0.07, 0), Parent = btn })
	label({ Text = string.upper(c.name or c.id), Size = UDim2.fromScale(1, 0.3), FontFace = Theme.Heading,
		MaxText = 26, Parent = btn })
	local chips = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.18),
		Position = UDim2.fromScale(0, 0.34), Parent = btn }, {
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	chip(chips, c.mode or "PHOTO", false, 1)
	if (c.newUntil or 0) > workspace:GetServerTimeNow() then
		chip(chips, "NEW", true, 2)
	end
	if c.judge then
		chip(chips, "JUDGE IS HERE", true, 3)
	end
	local meta = Util.ageText(c.createdAt)
	if c.blocks then
		meta ..= "  ·  " .. Util.commas(c.blocks) .. " blocks"
	end
	label({ Text = meta, TextColor3 = Theme.Muted, Size = UDim2.fromScale(1, 0.16), Position = UDim2.fromScale(0, 0.56),
		MaxText = 16, Parent = btn })
	local sw = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.18), Position = UDim2.fromScale(0, 0.8),
		Parent = btn }, {
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
	})
	for _, hex in c.swatches or {} do
		local sq = make("Frame", { Size = UDim2.fromScale(0.15, 1), BackgroundColor3 = Color3.fromHex(hex), Parent = sw },
			{ Theme.corner(4), make("UIAspectRatioConstraint", { AspectRatio = 1 }) })
		Theme.stroke().Parent = sq
	end
	if not clickable then
		local text = if c.measuring then "MEASURING THE ROOM..."
			else "BUILDING · " .. math.floor((c.progress or 0) * 100) .. "%"
		local overlay = make("Frame", { BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.35,
			Size = UDim2.new(1.12, 0, 1.16, 0), Position = UDim2.new(-0.06, 0, -0.08, 0), ZIndex = 5, Parent = btn },
			{ Theme.corner(14) })
		local l = label({ Text = text, TextColor3 = Theme.Accent, FontFace = Theme.Heading, ZIndex = 6,
			TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.35),
			Parent = overlay })
		local bar = make("Frame", { BackgroundColor3 = Theme.Stroke, Size = UDim2.new(0.8, 0, 0, 6), ZIndex = 6,
			Position = UDim2.new(0.1, 0, 0.72, 0), Parent = overlay }, { Theme.corner(3) })
		make("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.fromScale(math.clamp(c.progress or 0, 0.03, 1), 1),
			ZIndex = 7, Parent = bar }, { Theme.corner(3) })
		TweenService:Create(l, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ TextTransparency = 0.6 }):Play()
	else
		btn.Activated:Connect(function()
			onClick(c.id)
		end)
	end
end

-- cards: decoded RoomsJson. Rebuilds the container's children.
function Board.render(container: Instance, cards: { any }, current: string?, onClick: (string) -> ())
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if #cards == 0 then
		label({ Text = "No rooms yet. Add a memory in Déjà View.", TextColor3 = Theme.Muted,
			Size = UDim2.fromScale(1, 0.2), Parent = container })
		return
	end
	for i, c in cards do
		card(container, c, current, onClick, i)
	end
end

return Board
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Tag burst, camera shake, sounds and the reality-check tint (all local to this client).
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Theme = require(ReplicatedStorage:WaitForChild("Shared").Theme)

local Effects = {}

function Effects.sound(key: string)
	local id = Theme.Sounds[key]
	if not id or id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = 0.7
	s.Parent = SoundService
	SoundService:PlayLocalSound(s)
	task.delay(4, function()
		s:Destroy()
	end)
end

function Effects.burst(pos: Vector3)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(pos)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Theme.Accent)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(12, 24)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Lifetime = NumberRange.new(0.4, 0.9)
	e.Drag = 4
	e.Enabled = false
	e.Parent = p
	p.Parent = workspace
	e:Emit(40)
	task.delay(1.5, function()
		p:Destroy()
	end)
end

function Effects.shake(seconds: number, strength: number)
	local cam = workspace.CurrentCamera
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		if t > seconds then
			conn:Disconnect()
			return
		end
		local k = strength * (1 - t / seconds)
		cam.CFrame *= CFrame.Angles(math.rad((math.random() - 0.5) * k), math.rad((math.random() - 0.5) * k), 0)
	end)
end

local originals: { [BasePart]: Color3 } = {}
local realityOn = false

local function tint(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	if realityOn then
		if not originals[part] then
			originals[part] = part.Color
		end
		part.Color = originals[part]:Lerp(Theme.Imagined, 0.55):Lerp(Color3.new(0, 0, 0), 0.15)
	elseif originals[part] then
		part.Color = originals[part]
		originals[part] = nil
	end
end

function Effects.setReality(on: boolean)
	realityOn = on
	for _, part in CollectionService:GetTagged("DVImagined") do
		tint(part)
	end
	if not on then
		originals = {}
	end
end

CollectionService:GetInstanceAddedSignal("DVImagined"):Connect(function(part)
	if realityOn then
		tint(part)
	end
end)

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Ghosts</string>
            <string name="Source"><![CDATA[-- Draws the judge (head, hands, faint body), web viewers (orbs) and other-server Roblox players,
-- each DELAY seconds in the past, sliding between server snapshots.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local Interp = require(Shared.Interp)
local Avatar = require(script.Parent.Avatar)

local Ghosts = {}

type Ghost = {
	id: string,
	kind: string,
	buf: Interp.Buffer,
	model: Model,
	head: BasePart,
	hl: BasePart?,
	hr: BasePart?,
	body: BasePart?,
	label: TextLabel,
	sub: TextLabel,
	itChip: TextLabel?,
	fade: number, -- 1 visible -> 0 gone
	gone: boolean,
	base: { [BasePart]: number },
	rig: Avatar.Rig?,
}

local ghosts: { [string]: Ghost } = {}
local folder = Instance.new("Folder")
folder.Name = "Ghosts"
folder.Parent = workspace

local function ball(model: Model, name: string, size: number, transparency: number): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(size, size, size)
	p.Material = Enum.Material.Neon
	p.Color = Theme.Accent
	p.Transparency = transparency
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Parent = model
	return p
end

local function billboard(adornee: BasePart, text: string, offset: number)
	local gui = Theme.make("BillboardGui", {
		Size = UDim2.fromOffset(180, 54),
		StudsOffset = Vector3.new(0, offset, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 200,
		Adornee = adornee,
		Parent = adornee,
	})
	local label = Theme.label({ Text = text, Size = UDim2.new(1, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Heading, TextStrokeTransparency = 0.4, MaxText = 20, Parent = gui })
	local sub = Theme.label({ Text = "", Size = UDim2.new(1, 0, 0.35, 0), Position = UDim2.fromScale(0, 0.55),
		TextColor3 = Theme.Muted, TextXAlignment = Enum.TextXAlignment.Center, MaxText = 14, Parent = gui })
	return gui, label, sub
end

local function create(id: string, kind: string, name: string): Ghost
	local model = Instance.new("Model")
	model.Name = id
	local g: any = { id = id, kind = kind, buf = Interp.new(), model = model, fade = 0, gone = false, base = {} }
	if kind == "vr" then
		g.head = ball(model, "Head", 1.6, 0.15)
		local visor = Instance.new("Part")
		visor.Name = "Visor"
		visor.Size = Vector3.new(1.3, 0.45, 0.3)
		visor.Color = Theme.Bg
		visor.Material = Enum.Material.SmoothPlastic
		visor.Anchored, visor.CanCollide, visor.CanQuery, visor.CanTouch = true, false, false, false
		visor.Parent = model
		g.visor = visor
		g.hl = ball(model, "HandL", 0.8, 0.1)
		g.hr = ball(model, "HandR", 0.8, 0.1)
		for _, hand in { g.hl, g.hr } do
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, 0.3, 0)
			a0.Parent = hand
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -0.3, 0)
			a1.Parent = hand
			Theme.make("Trail", { Attachment0 = a0, Attachment1 = a1, Color = ColorSequence.new(Theme.Accent),
				Lifetime = 0.25, LightEmission = 1,
				Transparency = NumberSequence.new(0.3, 1), Parent = hand })
		end
		local body = Instance.new("Part")
		body.Name = "Body"
		body.Shape = Enum.PartType.Cylinder
		body.Material = Enum.Material.Neon
		body.Color = Theme.Accent
		body.Transparency = 0.75
		body.Anchored, body.CanCollide, body.CanQuery, body.CanTouch, body.CastShadow = true, false, false, false, false
		body.Parent = model
		g.body = body
		Theme.make("PointLight", { Color = Theme.Accent, Range = 14, Brightness = 1.5, Parent = g.head })
		Theme.make("Highlight", { FillTransparency = 1, OutlineColor = Theme.Accent,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = model })
		local _, label, sub = billboard(g.head, string.upper(name) .. " · VR", 2.2)
		g.label, g.sub = label, sub
		g.itChip = Theme.label({ Text = "IT", Size = UDim2.fromOffset(40, 22), Position = UDim2.new(0.5, -20, 0, -24),
			BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Bg,
			TextXAlignment = Enum.TextXAlignment.Center, FontFace = Theme.Heading, Visible = false,
			Parent = label.Parent })
		Theme.corner(8).Parent = g.itChip
	elseif kind == "web" then
		g.head = ball(model, "Orb", 1, 0.2)
		local _, label, sub = billboard(g.head, name, 1.4)
		g.label, g.sub = label, sub
	else
		local capsule = Instance.new("Part")
		capsule.Name = "Capsule"
		capsule.Shape = Enum.PartType.Cylinder
		capsule.Size = Vector3.new(5, 2, 2)
		capsule.Material = Enum.Material.SmoothPlastic
		capsule.Color = Theme.Text
		capsule.Transparency = 0.55
		capsule.Anchored, capsule.CanCollide, capsule.CanQuery, capsule.CanTouch = true, false, false, false
		capsule.Parent = model
		g.head = capsule
		local _, label, sub = billboard(capsule, name, 3.3)
		g.label, g.sub = label, sub
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			g.base[d] = d.Transparency
		end
	end
	if kind == "vr" then
		-- A real person when the rig is available: hide the floating head and body, keep the lime hands and outline.
		local rig = Avatar.create(model)
		if rig then
			g.rig = rig
			g.base[g.head] = 1
			g.base[g.visor] = 1
			if g.body then
				g.base[g.body] = 1
			end
			for _, hand in { g.hl, g.hr } do
				if hand then
					hand.Size = Vector3.new(0.5, 0.5, 0.5)
				end
			end
		end
	end
	model.Parent = folder
	ghosts[id] = g
	return g
end

function Ghosts.push(msg: any)
	if type(msg) ~= "table" or type(msg.id) ~= "string" then
		return
	end
	local g = ghosts[msg.id]
	if g and g.gone then
		g.model:Destroy()
		ghosts[msg.id] = nil
		g = nil
	end
	if not g then
		g = create(msg.id, msg.kind or "web", msg.name or msg.id)
	end
	Interp.push(g.buf, { stamp = msg.stamp, pos = msg.pos, yaw = msg.yaw or 0, head = msg.head, hl = msg.hl, hr = msg.hr })
end

function Ghosts.remove(id: string)
	local g = ghosts[id]
	if g then
		g.gone = true
	end
end

function Ghosts.clear()
	for id, g in ghosts do
		g.model:Destroy()
		ghosts[id] = nil
	end
end

-- The judge's head part (for the spectator camera), if drawn.
function Ghosts.judgeHead(): BasePart?
	for _, g in ghosts do
		if g.kind == "vr" and not g.gone then
			return g.head
		end
	end
	return nil
end

function Ghosts.update(dt: number)
	local now = workspace:GetServerTimeNow()
	local renderT = now - Interp.DELAY
	local offline = workspace:GetAttribute("Offline") == true
	local playing = workspace:GetAttribute("RoundState") == "playing"
	for id, g in ghosts do
		local s = Interp.sample(g.buf, renderT, now)
		local stale = (s == nil) or s.age > Interp.STALE
		local target = if g.gone then 0 elseif stale or offline then 0.3 else 1
		g.fade += (target - g.fade) * math.min(1, dt / 0.15)
		if g.gone and g.fade < 0.02 then
			g.model:Destroy()
			ghosts[id] = nil
			continue
		end
		if s and s.age > 8 and not g.gone then
			g.gone = true
		end
		if not s then
			continue
		end
		local yawCf = CFrame.Angles(0, s.yaw, 0)
		if g.kind == "vr" then
			local head = s.head or (s.pos + Vector3.new(0, 5.7, 0))
			g.head.CFrame = CFrame.new(head) * yawCf
			local visor = (g :: any).visor :: BasePart
			visor.CFrame = CFrame.new(head) * yawCf * CFrame.new(0, 0.1, -0.7)
			if g.hl and g.hr then
				g.hl.CFrame = CFrame.new(s.hl or (head + yawCf:VectorToWorldSpace(Vector3.new(-1.2, -1.6, -0.8))))
				g.hr.CFrame = CFrame.new(s.hr or (head + yawCf:VectorToWorldSpace(Vector3.new(1.2, -1.6, -0.8))))
			end
			if g.body then
				local h = math.max(head.Y - s.pos.Y - 0.6, 1)
				g.body.Size = Vector3.new(h, 1.4, 1.4)
				g.body.CFrame = CFrame.new(s.pos.X, s.pos.Y + h / 2, s.pos.Z) * CFrame.Angles(0, 0, math.pi / 2)
			end
			if g.itChip then
				g.itChip.Visible = playing
			end
			if g.rig then
				Avatar.update(g.rig, s, dt)
				Avatar.setTransparency(g.rig, 1 - g.fade)
			end
		elseif g.kind == "web" then
			g.head.CFrame = CFrame.new((s.head or s.pos) + Vector3.new(0, 0, 0))
		else
			g.head.CFrame = CFrame.new(s.pos + Vector3.new(0, 2.5, 0)) * yawCf * CFrame.Angles(0, 0, math.pi / 2)
		end
		g.sub.Text = if stale or offline then "signal lost" else ""
		for part, base in g.base do
			part.LocalTransparencyModifier = 0
			part.Transparency = 1 - (1 - base) * g.fade
		end
	end
end

return Ghosts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">PingPongView</string>
            <string name="Source"><![CDATA[-- Local visuals for the real ping pong: the other paddles and a trail on the server ball (team/seb.md Update 5, B).
local Players = game:GetService("Players")
local PingPongView = {}

local paddles: { [number]: { part: Part, target: CFrame } } = {}
local trail: Trail? = nil
local trailBall: BasePart? = nil

local function blade(userId: number): Part
	local p = Instance.new("Part")
	p.Name = "PPPaddle"
	p.Size = Vector3.new(0.55, 0.08, 0.57)
	p.Color = if userId % 2 == 0 then Color3.fromRGB(90, 170, 255) else Color3.fromRGB(255, 120, 90)
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Parent = workspace
	return p
end

function PingPongView.paddle(userId: number, cf: CFrame)
	local entry = paddles[userId]
	if not entry then
		entry = { part = blade(userId), target = cf }
		paddles[userId] = entry
		entry.part.CFrame = cf
		return
	end
	entry.target = cf
end

function PingPongView.update(dt: number)
	for _, entry in paddles do
		if entry.part.Parent then
			entry.part.CFrame = entry.part.CFrame:Lerp(entry.target, math.clamp(dt * 12, 0, 1))
		end
	end
	local ball = workspace:FindFirstChild("PPBall", true)
	if ball and ball:IsA("BasePart") then
		if trailBall ~= ball then
			if trail then
				trail:Destroy()
			end
			local t = Instance.new("Trail")
			t.Name = "PPTrail"
			t.Attachment0 = Instance.new("Attachment", ball)
			t.Attachment1 = Instance.new("Attachment", ball)
			t.Lifetime = 0.18
			t.MinLength = 0
			t.Color = ColorSequence.new(Color3.fromRGB(255, 200, 120))
			t.Transparency = NumberSequence.new(0.2, 1)
			t.Parent = ball
			trail, trailBall = t, ball
		end
	elseif trail then
		trail:Destroy()
		trail, trailBall = nil, nil
	end
end

function PingPongView.clear()
	for id, entry in paddles do
		entry.part:Destroy()
		paddles[id] = nil
	end
	if trail then
		trail:Destroy()
		trail, trailBall = nil, nil
	end
end

return PingPongView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">PongBall</string>
            <string name="Source"><![CDATA[-- Draws the ping pong ball locally from the server's shot description (same arcs the server uses), so it is smooth.
local PongBall = {}

local ball: Part? = nil
local shot: any = nil
local resting: Vector3? = nil

local function ensureBall(): Part
	if ball and ball.Parent then
		return ball
	end
	local p = Instance.new("Part")
	p.Name = "PongBall"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.7, 0.7, 0.7)
	p.Color = Color3.fromRGB(255, 160, 40)
	p.Material = Enum.Material.Neon
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.Parent = workspace
	ball = p
	return p
end

function PongBall.onMoment(m: any)
	if m.type == "pongShot" then
		shot, resting = m, nil
	elseif m.type == "pongWait" then
		shot, resting = nil, m.pos
	elseif m.type == "pongEnd" then
		shot, resting = nil, nil
		if ball then
			ball:Destroy()
			ball = nil
		end
	end
end

function PongBall.update()
	if resting then
		ensureBall().CFrame = CFrame.new(resting + Vector3.new(0, 0.3 * math.sin(os.clock() * 4), 0))
		return
	end
	if not shot then
		return
	end
	local dt = workspace:GetServerTimeNow() - shot.t0
	local pos
	if dt < 0 then
		pos = shot.p0
	elseif dt <= shot.t1 then
		local a = dt / shot.t1
		pos = shot.p0:Lerp(shot.b, a) + Vector3.new(0, 4 * shot.h1 * a * (1 - a), 0)
	else
		local a = math.min((dt - shot.t1) / shot.t2, 1.6)
		pos = shot.b:Lerp(shot.p2, a) + Vector3.new(0, 4 * shot.h2 * a * (1 - a), 0)
	end
	ensureBall().CFrame = CFrame.new(pos)
end

return PongBall
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">RoomLook</string>
            <string name="Source"><![CDATA[-- How the world is lit on this client (Update 10). Inside a room with a textured model, show the baked texture colours
-- as they are (no extra lighting, shadows or effects) and the world's own skybox; in the lobby or a block room, the
-- normal look. Lighting changes made by a client stay on that client, so lobby players keep the lobby look.
local Lighting = game:GetService("Lighting")

local RoomLook = {}

local saved: { [string]: any } = {}
local effectsSaved: { [Instance]: boolean } = {}
local sky: Sky? = nil
local active = false

local UNLIT = {
	GlobalShadows = false,
	Ambient = Color3.new(1, 1, 1),
	OutdoorAmbient = Color3.new(1, 1, 1),
	Brightness = 0,
	EnvironmentDiffuseScale = 0,
	EnvironmentSpecularScale = 0,
	ExposureCompensation = 0,
}

local function setSky(room: Instance?)
	if sky then
		sky:Destroy()
		sky = nil
	end
	if not room or not room:GetAttribute("SkyFt") then
		return
	end
	local s = Instance.new("Sky")
	s.Name = "DejaViewSky"
	s.SkyboxFt = room:GetAttribute("SkyFt") or ""
	s.SkyboxBk = room:GetAttribute("SkyBk") or ""
	s.SkyboxLf = room:GetAttribute("SkyLf") or ""
	s.SkyboxRt = room:GetAttribute("SkyRt") or ""
	s.SkyboxUp = room:GetAttribute("SkyUp") or ""
	s.SkyboxDn = room:GetAttribute("SkyDn") or ""
	s.CelestialBodiesShown = false
	s.StarCount = 0
	s.Parent = Lighting
	sky = s
end

local function enter(room: Instance)
	if not active then
		active = true
		for k in UNLIT do
			saved[k] = (Lighting :: any)[k]
		end
		for _, e in Lighting:GetChildren() do
			if e:IsA("PostEffect") or e:IsA("Atmosphere") then
				local wasOn = if e:IsA("PostEffect") then e.Enabled else true
				effectsSaved[e] = wasOn
				if e:IsA("PostEffect") then
					e.Enabled = false
				else
					e.Parent = nil
				end
			end
		end
		for k, v in UNLIT do
			(Lighting :: any)[k] = v
		end
	end
	setSky(room)
end

local function leave()
	setSky(nil)
	if not active then
		return
	end
	active = false
	for k, v in saved do
		(Lighting :: any)[k] = v
	end
	for e, wasOn in effectsSaved do
		if e:IsA("PostEffect") then
			e.Enabled = wasOn
		else
			e.Parent = Lighting
		end
	end
	effectsSaved = {}
end

-- inRoom: this player is in the room (not the lobby).
function RoomLook.update(inRoom: boolean)
	local room = workspace:FindFirstChild("Room")
	if inRoom and room and room:GetAttribute("HasModel") then
		enter(room)
	else
		leave()
	end
end

return RoomLook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Builds the ScreenGui: loading screen, HUD, host bar, JOIN, banner, toasts, scoreboard,
-- countdown, TAGGED, winner card and the Rooms panel. Client.client.luau drives it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)

local make, label, button = Theme.make, Theme.label, Theme.button

local Ui = {}

local TIPS = {
	"Every block is a piece of a real place.",
	"The lime ghost is the judge in the headset.",
	"Stay away from the judge's hands during tag.",
	"Press R to switch rooms.",
}

function Ui.build()
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", {
		Name = "DejaViewUI", ResetOnSpawn = false, IgnoreGuiInset = true,
		-- Above Roblox's TouchGui, whose invisible thumbstick area would otherwise swallow taps on phones.
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui"),
	})
	-- HUD stays clear of notches, rounded corners and Android camera cutouts.
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	-- Full-screen cards (loading, winner) cover the whole display, notch included.
	local full = make("ScreenGui", {
		Name = "DejaViewFull", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 11,
		ScreenInsets = Enum.ScreenInsets.None, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local ui: { [string]: any } = { gui = gui, full = full }
	-- UIScales on the pixel-sized pieces only (full-screen cards stay full-screen); Ui.setScale drives them.
	ui.scales = {}

	-- Loading screen
	local loading = make("Frame", { Name = "Loading", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Bg,
		ZIndex = 50, Parent = full })
	ui.loading = loading
	local col = make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.8, 0.6), ZIndex = 51, Parent = loading },
		{ make("UISizeConstraint", { MaxSize = Vector2.new(900, 500) }) })
	label({ Text = "DÉJÀ VIEW", TextColor3 = Theme.Accent, FontFace = Theme.Heading, Size = UDim2.fromScale(1, 0.1),
		ZIndex = 52, MaxText = 24, Parent = col })
	ui.loadTitle = label({ Text = "Moving in...", FontFace = Theme.Heading, Size = UDim2.fromScale(1, 0.3),
		Position = UDim2.fromScale(0, 0.14), ZIndex = 52, MaxText = 96, Parent = col })
	ui.loadRoom = label({ Text = "", TextColor3 = Theme.Muted, Size = UDim2.fromScale(1, 0.1),
		Position = UDim2.fromScale(0, 0.46), ZIndex = 52, MaxText = 28, Parent = col })
	local bar = make("Frame", { BackgroundColor3 = Theme.Stroke, Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.fromScale(0, 0.62), ZIndex = 52, Parent = col }, { Theme.corner(3) })
	ui.loadFill = make("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.fromScale(0, 1), ZIndex = 53,
		Parent = bar }, { Theme.corner(3) })
	ui.loadCount = label({ Text = "", TextColor3 = Theme.Muted, Size = UDim2.fromScale(1, 0.08),
		Position = UDim2.fromScale(0, 0.67), ZIndex = 52, MaxText = 18, Parent = col })
	ui.loadTip = label({ Text = TIPS[1], TextColor3 = Theme.Muted, Size = UDim2.fromScale(1, 0.07),
		Position = UDim2.fromScale(0, 0.88), ZIndex = 52, MaxText = 16, Parent = col })
	task.spawn(function()
		local i = 1
		while gui.Parent do
			task.wait(4)
			i = i % #TIPS + 1
			ui.loadTip.Text = TIPS[i]
		end
	end)

	-- HUD (top-left, below the Roblox top bar)
	local hud = make("Frame", { Name = "Hud", BackgroundTransparency = 1, Position = UDim2.new(0, 16, 0, 64),
		Size = UDim2.new(0.42, 0, 0, 110), Parent = gui }, { make("UISizeConstraint", { MaxSize = Vector2.new(520, 110) }) })
	ui.roomName = label({ Text = "LOBBY", FontFace = Theme.Heading, Size = UDim2.new(1, 0, 0, 30), MaxText = 30,
		TextStrokeTransparency = 0.6, Parent = hud })
	ui.status = label({ Text = "", TextColor3 = Theme.Accent, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 32),
		MaxText = 18, TextStrokeTransparency = 0.6, Parent = hud })
	local row = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.new(0, 0, 0, 58),
		Parent = hud }, { make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder }) })
	ui.roomsBtn = button({ Text = "ROOMS (R)", Size = UDim2.new(0, 120, 1, 0), LayoutOrder = 1, Parent = row })
	ui.hopBtn = button({ Text = "LOBBY", Size = UDim2.new(0, 100, 1, 0), LayoutOrder = 2, Parent = row })
	ui.hostToggle = button({ Text = "HOST", Size = UDim2.new(0, 80, 1, 0), LayoutOrder = 4, Visible = false, Parent = row })
	ui.noteBtn = button({ Text = "NOTE", Size = UDim2.new(0, 80, 1, 0), LayoutOrder = 5, Visible = false, Parent = row })
	ui.realityBtn = button({ Text = "REALITY CHECK", Size = UDim2.new(0, 150, 1, 0), LayoutOrder = 3, Visible = false,
		Parent = row })

	-- Host bar (left middle)
	local host = make("Frame", { Name = "HostBar", BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0.05,
		Position = UDim2.new(0, 16, 0, 184), Size = UDim2.new(0, 170, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false, Parent = gui },
		{ Theme.corner(14), Theme.stroke(), make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
			PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }),
		  make("UIListLayout", { Name = "List", Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	ui.hostGrid = make("UIGridLayout", { Name = "Grid", CellSize = UDim2.new(0.485, 0, 0, 34),
		CellPadding = UDim2.new(0.03, 0, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	ui.host = host
	label({ Text = "HOST", TextColor3 = Theme.Muted, FontFace = Theme.Heading, Size = UDim2.new(1, 0, 0, 16), MaxText = 14,
		LayoutOrder = 0, Parent = host })
	local function hostBtn(key, text, order)
		ui[key] = button({ Text = text, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order, MaxText = 14, Parent = host })
	end
	hostBtn("autoBtn", "AUTO-JOIN: ON", 1)
	hostBtn("followBtn", "FOLLOW: ON", 2)
	hostBtn("startBtn", "START ROUND", 3)
	hostBtn("endBtn", "END ROUND", 4)
	hostBtn("mockBtn", "MOCK JUDGE: OFF", 6)
	hostBtn("huntBtn", "START HUNT", 5)
	hostBtn("chessBtn", "CHESS BOARD", 7)
	hostBtn("pongBtn", "PING PONG", 7)
	hostBtn("foosBtn", "FOOSBALL", 7)
	hostBtn("hideBtn", "HIDE & SEEK", 7)
	hostBtn("lavaBtn", "FLOOR IS LAVA", 7)
	hostBtn("cookBtn", "COOKING RUSH", 7)
	hostBtn("bigBtn", "BIG SCREEN: OFF", 7)
	hostBtn("lobbyAllBtn", "ALL TO LOBBY", 8)

	-- Big JOIN (bottom centre, clear of the thumbstick and jump corners)
	ui.joinBtn = button({ Text = "JOIN", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -28),
		Size = UDim2.new(0.3, 0, 0, 64), BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Bg, MaxText = 34,
		Visible = false, Parent = gui })
	make("UISizeConstraint", { MinSize = Vector2.new(160, 56), MaxSize = Vector2.new(360, 72), Parent = ui.joinBtn })

	-- Banner
	ui.banner = label({ Text = "", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.new(0.4, 0, 0, 40), BackgroundTransparency = 0, BackgroundColor3 = Theme.Danger,
		TextXAlignment = Enum.TextXAlignment.Center, FontFace = Theme.Heading, Visible = false, ZIndex = 40, Parent = gui })
	Theme.corner(12).Parent = ui.banner

	-- Toasts (top centre, under the banner; the lower corners belong to the thumbstick and jump button)
	ui.toasts = make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 112), Size = UDim2.new(0.5, 0, 0, 140), Parent = gui },
		{ make("UIListLayout", { Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Top,
			HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })

	-- Scoreboard (top-right)
